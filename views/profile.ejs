<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thông tin cá nhân - Hệ thống Giáo án</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <style>
        .profile-container {
            display: grid;
            grid-template-columns: 250px 1fr;
            gap: 24px;
        }
        .avatar-section {
            text-align: center;
        }
        .avatar-preview {
            width: 150px;
            height: 150px;
            border-radius: 50%;
            object-fit: cover;
            background-color: var(--border);
            margin: 0 auto 16px;
            display: block;
            border: 3px solid var(--white);
            box-shadow: 0 4px 6px rgba(0,0,0,0.1);
        }
        .file-upload {
            display: none;
        }
    
        @media (max-width: 768px) {
            .profile-container {
                grid-template-columns: 1fr;
            }
            .grid.grid-cols-2 {
                grid-template-columns: 1fr;
            }
            .avatar-preview {
                width: 120px;
                height: 120px;
            }
        }
    </style>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>.swal2-popup { font-family: 'Be Vietnam Pro', sans-serif !important; }</style>
<script>
window._originalAlert = window.alert;
window.alert = function(msg) {
    if(typeof Swal !== 'undefined') {
        Swal.fire({ text: msg, icon: 'info', confirmButtonColor: '#16469d' });
    } else {
        window._originalAlert(msg);
    }
};
window.customConfirm = async function(msg) {
    if(typeof Swal === 'undefined') return window.confirm(msg);
    const result = await Swal.fire({
        text: msg,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#16469d',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
    });
    return result.isConfirmed;
};
</script>

</head>
<body>
    <div id="alert-box"></div>

    <div class="card">
        <div class="card-header"><h3 class="card-title">Cập nhật Hồ sơ Cá nhân</h3></div>
        <div class="profile-container">
            <div class="avatar-section">
                <img id="avatar-preview" class="avatar-preview" src="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 24 24' fill='%23cbd5e1'%3E%3Cpath d='M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm0 3c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm0 14.2c-2.5 0-4.71-1.28-6-3.22.03-1.99 4-3.08 6-3.08 1.99 0 5.97 1.09 6 3.08-1.29 1.94-3.5 3.22-6 3.22z'/%3E%3C/svg%3E" alt="Avatar">
                <label for="avatar-upload" class="btn btn-secondary" style="width:100%; justify-content:center">
                    <i class="fas fa-camera"></i> Đổi ảnh đại diện
                </label>
                <input type="file" id="avatar-upload" class="file-upload" accept="image/*" onchange="handleAvatarUpload(event)">
            </div>
            <div>
                <div class="grid grid-cols-2">
                    <div class="form-group">
                        <label>Tên đăng nhập</label>
                        <input type="text" id="profile-username" class="form-control" disabled>
                    </div>
                    <div class="form-group">
                        <label>Quyền hạn</label>
                        <input type="text" id="profile-role" class="form-control" disabled>
                    </div>
                    <div class="form-group">
                        <label>Họ và tên</label>
                        <input type="text" id="profile-fullname" class="form-control" placeholder="Nhập họ và tên...">
                    </div>
                    <div class="form-group">
                        <label>Khoa / Đơn vị công tác</label>
                        <select id="profile-department" class="form-control">
                            <option value="">-- Trống --</option>
                        </select>
                    </div>
                    <div class="form-group">
                        <label>Số điện thoại</label>
                        <input type="text" id="profile-phone" class="form-control" placeholder="VD: 0912345678">
                    </div>
                    <div class="form-group">
                        <label>Địa chỉ Email</label>
                        <input type="email" id="profile-email" class="form-control" placeholder="VD: user@nsgpc.edu.vn">
                    </div>
                </div>
                <div style="margin-top: 16px">
                    <button class="btn btn-primary" onclick="saveProfile()"><i class="fas fa-save"></i> Lưu thông tin</button>
                </div>
            </div>
        </div>
    </div>
    <!-- Account Expiry & Renewal Card -->
    <div class="card" style="margin-top:24px; border-left:4px solid var(--primary);">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px;">
            <h3 class="card-title" style="margin:0; font-size:1.05rem;"><i class="fas fa-id-badge" style="color:var(--primary); margin-right:6px;"></i> Gói tài khoản & Hạn sử dụng</h3>
            <button type="button" class="btn btn-primary btn-sm" onclick="openRenewalModal()" style="font-size:0.85rem; padding:6px 14px;">
                <i class="fas fa-history"></i> Gửi yêu cầu gia hạn
            </button>
        </div>
        <div style="padding:16px 20px;">
            <div id="profile-expiry-content" style="font-size:0.92rem; color:#334155; line-height:1.8;">
                Đang tải thông tin gói tài khoản...
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        let currentAvatarBase64 = null;

        injectLayout('profile', 'Thông tin cá nhân');
        async function loadDeptsForProfile() {
            try {
                const res = await fetch(API_URL + '/departments', { headers: getHeaders() });
                if(res.ok) {
                    const depts = await res.json();
                    const sel = document.getElementById('profile-department');
                    const currentValue = sel.value;
                    sel.innerHTML = '<option value="">-- Trống --</option>' + 
                        depts.map(d => `<option value="${d.id}">${escapeHtml(d.name)}</option>`).join('');
                    if (currentValue) sel.value = currentValue;
                }
            } catch(e){}
        }
        function escapeHtml(s) { return (s || '').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }

        loadDeptsForProfile();

        checkAuth().then(user => {
            if(user) {
                document.getElementById('profile-username').value = user.username;
                document.getElementById('profile-role').value = user.role;
                document.getElementById('profile-fullname').value = user.full_name || '';
                document.getElementById('profile-department').value = user.department_id || '';
                document.getElementById('profile-phone').value = user.phone || '';
                document.getElementById('profile-email').value = user.email || '';
                
                if (user.avatar) {
                    currentAvatarBase64 = user.avatar;
                    document.getElementById('avatar-preview').src = user.avatar;
                }

                const expContent = document.getElementById('profile-expiry-content');
                if (expContent) {
                    if (user.role === 'Admin') {
                        expContent.innerHTML = '<div style="display:flex; align-items:center; gap:8px;"><span style="background:#eff6ff; color:#1d4ed8; font-weight:700; padding:4px 10px; border-radius:6px;"><i class="fas fa-shield-alt"></i> Tài khoản Quản trị viên</span> <span>Thời hạn: <b>Vô thời hạn</b></span></div>';
                    } else if (user.expires_at) {
                        const expDate = new Date(user.expires_at);
                        const now = new Date();
                        const diffTime = expDate.getTime() - now.getTime();
                        const diffDays = Math.ceil(diffTime / (1000 * 60 * 60 * 24));
                        const expFormatted = String(expDate.getDate()).padStart(2, '0') + '/' + String(expDate.getMonth() + 1).padStart(2, '0') + '/' + expDate.getFullYear();
                        
                        let statusHtml = '';
                        if (diffDays <= 0) {
                            statusHtml = '<b style="color:#b91c1c;"><i class="fas fa-times-circle"></i> Đã hết hạn</b>';
                        } else if (diffDays <= 7) {
                            statusHtml = '<b style="color:#b45309;"><i class="fas fa-hourglass-half"></i> Sắp hết hạn (Còn ' + diffDays + ' ngày)</b>';
                        } else {
                            statusHtml = '<b style="color:#15803d;"><i class="fas fa-check-circle"></i> Đang hoạt động (Còn ' + diffDays + ' ngày)</b>';
                        }

                        expContent.innerHTML = '<div>Trạng thái: ' + statusHtml + '</div>' +
                                              '<div>Ngày hết hạn sử dụng: <b style="color:var(--primary); font-size:1.02rem;">' + expFormatted + '</b></div>' +
                                              '<div style="margin-top:6px; font-size:0.85rem; color:#64748b;">Khi gần hết hạn hoặc đã hết hạn, Thầy/Cô hãy bấm nút <b>[Gửi yêu cầu gia hạn]</b> để thông báo cho Quản trị viên kích hoạt thêm thời gian sử dụng nhé!</div>';
                    } else {
                        expContent.innerHTML = '<div>Thời hạn sử dụng: <b>1 tháng kể từ ngày kích hoạt</b></div>';
                    }
                }

            }
        });

        function handleAvatarUpload(event) {
            const file = event.target.files[0];
            if (file) {
                const reader = new FileReader();
                reader.onload = function(e) {
                    const img = new Image();
                    img.onload = function() {
                        const canvas = document.createElement('canvas');
                        const MAX_WIDTH = 256;
                        const MAX_HEIGHT = 256;
                        let width = img.width;
                        let height = img.height;

                        if (width > height) {
                            if (width > MAX_WIDTH) {
                                height *= MAX_WIDTH / width;
                                width = MAX_WIDTH;
                            }
                        } else {
                            if (height > MAX_HEIGHT) {
                                width *= MAX_HEIGHT / height;
                                height = MAX_HEIGHT;
                            }
                        }
                        canvas.width = width;
                        canvas.height = height;
                        const ctx = canvas.getContext('2d');
                        ctx.drawImage(img, 0, 0, width, height);
                        
                        currentAvatarBase64 = canvas.toDataURL('image/jpeg', 0.8);
                        document.getElementById('avatar-preview').src = currentAvatarBase64;
                    }
                    img.src = e.target.result;
                };
                reader.readAsDataURL(file);
            }
        }

        async function saveProfile() {
            const payload = {
                full_name: document.getElementById('profile-fullname').value.trim(),
                department_id: document.getElementById('profile-department').value.trim(),
                phone: document.getElementById('profile-phone').value.trim(),
                email: document.getElementById('profile-email').value.trim(),
                avatar: currentAvatarBase64
            };

            try {
                const res = await fetch(API_URL + '/auth/profile', {
                    method: 'PUT',
                    headers: getHeaders(),
                    body: JSON.stringify(payload)
                });
                let data;
                const text = await res.text();
                try { 
                    data = JSON.parse(text); 
                } catch(e) { 
                    throw new Error(text.length < 100 ? text : 'Dung lượng ảnh quá lớn hoặc lỗi máy chủ.'); 
                }
                if(!res.ok) throw new Error(data.error || data.message || 'Không thể lưu thông tin');
                
                // Cập nhật giao diện sidebar và topbar tức thì
                const newName = payload.full_name || '';
                const nameEl = document.getElementById('topbar-username');
                if (nameEl && newName) nameEl.textContent = newName;
                const sidebarNameEl = document.getElementById('sidebar-user-fullname');
                if (sidebarNameEl && newName) sidebarNameEl.textContent = newName;
                if (payload.avatar) {
                    const sidebarAvatar = document.getElementById('sidebar-user-avatar');
                    if (sidebarAvatar) sidebarAvatar.src = payload.avatar;
                }

                showAlert('Đã cập nhật hồ sơ cá nhân', 'success');
            } catch(err) {
                showAlert(err.message);
            }
        }
    </script>
</body>
</html>
