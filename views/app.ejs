    &lt;div class=&quot;toolbar&quot; style=&quot;margin-top:12px&quot;&gt;&lt;button class=&quot;btn primary&quot; id=&quot;confirmParsed&quot;&gt;Xác nhận nhập&lt;/button&gt;&lt;/div&gt;`);
