}

function isExcludedDate(d){
 const key=dateKey(d);
 return getActiveExclusions().some(x=&gt;key&gt;=x.start &amp;&amp; key&lt;=x.end);
}

function nextScheduledDates(start, slots, needed){
  const slotsByDay = new Map();
  slots.forEach(s =&gt; {
    const wd = Number(s.day);
    if (!slotsByDay.has(wd)) slotsByDay.set(wd, []);
    slotsByDay.get(wd).push(Number(s.periods));
  });

  let dates=[];
  let d=new Date(start);
  let guard=0;

  while(dates.length&lt;needed &amp;&amp; guard&lt;3000){
    const wd=d.getDay();
    const currentKey = dateKey(d);
    if(slotsByDay.has(wd) &amp;&amp; !isExcludedDate(d) &amp;&amp; !window.deletedDates.includes(currentKey)){
      const daySlots = slotsByDay.get(wd);
      for(const periods of daySlots) {
        dates.push({ date:new Date(d), weekday:wd, periods:periods });
      }
    }
    
    // Inject extra sessions for this date
    const key = dateKey(d);
    const extrasToday = (window.extraSessions || []).filter(x =&gt; x.date === key);
    for(const ext of extrasToday) {
      dates.push({ date:new Date(d), weekday:wd, periods: ext.periods, isExtra: true, extId: ext.id });
    }

    d.setDate(d.getDate()+1);
    guard++;
  }
  return dates;
}


function rawSessionItems(session){
  if(session?.manualText) {
    return session.manualText.split('\n').map(x=&gt;x.trim()).filter(Boolean);
  }
  const out=[];
  (session?.units||[]).forEach(u=&gt;{
    (u.items||[]).forEach(it=&gt;{
      const txt=Array.isArray(it)?String(it[1]||&quot;&quot;).trim():String(it||&quot;&quot;).trim();
      if(txt &amp;&amp; !out.includes(txt)) out.push(txt);
    });
  });
  return out;
}

function displaySessionItems(sessionIndex){
  const session=currentSessions[sessionIndex];
  const current=rawSessionItems(session);
  const previous=sessionIndex&gt;0 ? rawSessionItems(currentSessions[sessionIndex-1]) : [];

  return current.map(txt=&gt;({
    raw:txt,
    display:previous.includes(txt) ? `${txt} (tiếp theo)` : txt
  }));
}


function onContentChange(si, el) {
  if(!currentSessions[si]) return;
  const newHtml = el.innerHTML;
  const newText = el.innerText.trim();
  
  // If user clears it completely, revert to auto
  if(!newText) {
    currentSessions[si].manualContent = null;
    currentSessions[si].manualText = null;
  } else {
    currentSessions[si].manualContent = newHtml;
    currentSessions[si].manualText = newText;
    currentSessions[si].isManual = true;
    if (currentSessions[si].isStandalone === undefined) {
        currentSessions[si].isStandalone = true;
    }
  }
  if(typeof saveStateToBackend === 'function') saveStateToBackend();
}

function onStandaloneChange(si, checked) {
    if(!currentSessions[si]) return;
    currentSessions[si].isStandalone = checked;
    if(typeof saveStateToBackend === 'function') saveStateToBackend();
    updateScheduleProgression();
}


function onPeriodChange(si, type, value) {
  const val = Math.max(0, parseInt(value, 10) || 0);
  if (!currentSessions[si]) return;
  if (!currentSessions[si].overrideCounts) {
    const c = {LT:0, TH:0, KT:0};
    (currentSessions[si].units || []).forEach(x =&gt; { if(c[x.type] !== undefined) c[x.type]++; });
    currentSessions[si].overrideCounts = c;
  }
  currentSessions[si].overrideCounts[type] = val;
  currentSessions[si].isManual = true;
  if(typeof saveStateToBackend === 'function') saveStateToBackend();
}

function updateScheduleProgression() {
  if(!programSequence.length){
    alert(&quot;Chưa có dữ liệu Chương trình môn học.&quot;);
    return;
  }
  recalcAssessments();
  const units = buildProgramUnits();
  if(!units.length){
    alert(&quot;Chưa có số tiết hợp lệ từ chương trình môn học.&quot;);
    return;
  }

  const slots = [...document.querySelectorAll(&quot;.slot&quot;)].map(s=&gt;({
    day:Number(s.querySelector(&quot;.weekday&quot;).value),
    periods:Number(s.querySelector(&quot;.periods&quot;).value)||0
  })).filter(x=&gt;x.periods&gt;0);

  if(!slots.length){
    alert(&quot;Vui lòng khai báo ít nhất 1 buổi học trong tuần.&quot;);
    return;
  }

  const startValue = document.getElementById(&quot;startDate&quot;).value;
  if(!startValue){
    alert(&quot;Vui lòng chọn ngày bắt đầu.&quot;);
    return;
  }

  // Preserve explicitly modified period counts from table inputs
  const sessionOverrides = [];
  currentSessions.forEach((s, idx) =&gt; {
    const isSaved = (window.savedLessons||[]).find(l=&gt;l.schedule_tt == (idx+1));
    if (isSaved) {
      s.isManual = true;
      if (!s.overrideCounts) {
        const c = {LT:0, TH:0, KT:0};
        (s.units || []).forEach(x =&gt; { if(c[x.type] !== undefined) c[x.type]++; });
        s.overrideCounts = c;
      }
    }
    const ltInput = document.getElementById('p_lt_' + idx);
    const thInput = document.getElementById('p_th_' + idx);
    const ktInput = document.getElementById('p_kt_' + idx);
    if (s.isManual && ltInput && thInput && ktInput) {
      sessionOverrides[idx] = {
        LT: Math.max(0, parseInt(ltInput.value, 10) || 0),
        TH: Math.max(0, parseInt(thInput.value, 10) || 0),
        KT: Math.max(0, parseInt(ktInput.value, 10) || 0)
      };
    } else if (s.isManual && s.overrideCounts) {
      sessionOverrides[idx] = { ...s.overrideCounts };
    }
  });

  const estimatedWeeks = Math.ceil(units.length / Math.max(1, slots.reduce((s,x)=&gt;s+x.periods,0)));
  const needed = Math.max(estimatedWeeks * slots.length + slots.length + 50, 200);
  const start = new Date(startValue + &quot;T00:00:00&quot;);
  const dates = nextScheduledDates(start, slots, needed);

  const newSessions = [];
  let cursor = 0, di = 0;

  const lastExtraDateKey = (window.extraSessions &amp;&amp; window.extraSessions.length &gt; 0) 
      ? window.extraSessions.map(e =&gt; e.date).sort().pop() 
      : null;

  while ((cursor &lt; units.length || (lastExtraDateKey &amp;&amp; dates[di] &amp;&amp; dateKey(dates[di].date) &lt;= lastExtraDateKey)) &amp;&amp; di &lt; dates.length) {
    let cap;
    let overridesForThis = null;

    const s_old = currentSessions[di];
    if (sessionOverrides[di] !== undefined) {
      const totalOverridden = (sessionOverrides[di].LT || 0) + (sessionOverrides[di].TH || 0) + (sessionOverrides[di].KT || 0);
      if (s_old &amp;&amp; s_old.isStandalone) {
          cap = 0; // KHÔNG tiêu thụ tiết của chương trình, để đẩy lùi bài giảng
      } else {
          cap = totalOverridden &gt; 0 ? totalOverridden : dates[di].periods;
      }
      overridesForThis = { ...sessionOverrides[di] };
    } else {
      if (s_old &amp;&amp; s_old.isStandalone) {
          cap = 0;
      } else {
          cap = dates[di].periods;
      }
    }

    const sessionUnits = units.slice(cursor, Math.min(cursor + cap, units.length));
    newSessions.push({
      date: dates[di].date,
      units: sessionUnits,
      overrideCounts: overridesForThis,
      isManual: !!overridesForThis || !!(s_old &amp;&amp; s_old.manualContent),
      manualContent: s_old ? s_old.manualContent : null,
      manualText: s_old ? s_old.manualText : null,
      isExtra: dates[di].isExtra,
      extId: dates[di].extId,
      isStandalone: s_old ? !!s_old.isStandalone : false
    });
    cursor += cap;
    di++;
  }

  currentSessions = newSessions;
  renderScheduleTable();
  if(typeof saveStateToBackend === 'function') saveStateToBackend();
  
  // VALIDATION LOGIC
  let requiredLT = 0, requiredTH = 0, requiredKT = 0;
  units.forEach(u =&gt; {
      if(u.type === 'LT') requiredLT++;
      else if(u.type === 'TH') requiredTH++;
      else if(u.type === 'KT') requiredKT++;
  });
  
  let allocatedLT = 0, allocatedTH = 0, allocatedKT = 0;
  currentSessions.forEach(s =&gt; {
      if (s.overrideCounts) {
          allocatedLT += (s.overrideCounts.LT || 0);
          allocatedTH += (s.overrideCounts.TH || 0);
          allocatedKT += (s.overrideCounts.KT || 0);
      } else if (s.units) {
          s.units.forEach(u =&gt; {
              if(u.type === 'LT') allocatedLT++;
              else if(u.type === 'TH') allocatedTH++;
              else if(u.type === 'KT') allocatedKT++;
          });
      }
  });

  const isMatched = (requiredLT === allocatedLT) &amp;&amp; (requiredTH === allocatedTH) &amp;&amp; (requiredKT === allocatedKT);
  
  if (!isMatched) {
      const warningHtml = `
          &lt;div style=&quot;text-align:left; font-size:14.5px;&quot;&gt;
              &lt;div style=&quot;background:#fef2f2; border-left:4px solid #ef4444; padding:10px; margin-bottom:15px; color:#991b1b; font-weight:500;&quot;&gt;
                  &lt;i class=&quot;fas fa-exclamation-circle&quot;&gt;&lt;/i&gt; Phát hiện chênh lệch số tiết phân bổ trên lịch so với Chương trình quy đổi (Bước 3)!
              &lt;/div&gt;
              &lt;table style=&quot;width:100%; border-collapse:collapse; margin-bottom:15px;&quot;&gt;
                  &lt;tr style=&quot;background:#f8fafc;&quot;&gt;
                      &lt;th style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:left;&quot;&gt;Loại tiết&lt;/th&gt;
                      &lt;th style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center;&quot;&gt;Yêu cầu&lt;/th&gt;
                      &lt;th style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center;&quot;&gt;Đã phân bổ&lt;/th&gt;
                  &lt;/tr&gt;
                  &lt;tr&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0;&quot;&gt;Lý thuyết (LT)&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold;&quot;&gt;${requiredLT}&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold; color:${requiredLT===allocatedLT?'#16a34a':'#ef4444'};&quot;&gt;${allocatedLT}&lt;/td&gt;
                  &lt;/tr&gt;
                  &lt;tr&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0;&quot;&gt;Thực hành (TH)&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold;&quot;&gt;${requiredTH}&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold; color:${requiredTH===allocatedTH?'#16a34a':'#ef4444'};&quot;&gt;${allocatedTH}&lt;/td&gt;
                  &lt;/tr&gt;
                  &lt;tr&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0;&quot;&gt;Kiểm tra (KT)&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold;&quot;&gt;${requiredKT}&lt;/td&gt;
                      &lt;td style=&quot;padding:8px; border:1px solid #e2e8f0; text-align:center; font-weight:bold; color:${requiredKT===allocatedKT?'#16a34a':'#ef4444'};&quot;&gt;${allocatedKT}&lt;/td&gt;
                  &lt;/tr&gt;
              &lt;/table&gt;
              &lt;p style=&quot;font-size:13.5px; color:#475569; margin:0;&quot;&gt;
                  👉 &lt;b&gt;Gợi ý xử lý:&lt;/b&gt; Bạn hãy thêm lịch đột xuất, xóa bớt dòng lịch thừa, hoặc chỉnh sửa số tiết trong từng buổi học cho đến khi tổng số tiết bằng đúng yêu cầu.
              &lt;/p&gt;
          &lt;/div&gt;
      `;
      if(typeof Swal !== 'undefined') {
        Swal.fire({
          title: &quot;Cảnh báo Lịch giảng dạy&quot;,
          html: warningHtml,
          width: 550,
          showCloseButton: true,
          confirmButtonText: &quot;Đã hiểu, tôi sẽ điều chỉnh&quot;,
          confirmButtonColor: &quot;#f59e0b&quot;
        });
      } else {
        alert(`Cảnh báo chênh lệch số tiết!\nYêu cầu: LT ${requiredLT}, TH ${requiredTH}, KT ${requiredKT}\nĐã phân bổ: LT ${allocatedLT}, TH ${allocatedTH}, KT ${allocatedKT}`);
      }
  } else {
      if(typeof Swal !== 'undefined') {
        Swal.fire({
          title: &quot;Phân bổ thành công!&quot;,
          text: &quot;Đã cập nhật lại nội dung và tiến độ toàn bộ Sổ đầu bài. Tổng số tiết trên lịch khớp hoàn toàn với quy đổi.&quot;,
          icon: &quot;success&quot;,
          confirmButtonText: &quot;Tuyệt vời&quot;,
          confirmButtonColor: &quot;#16469d&quot;
        });
      } else {
        alert(&quot;Đã cập nhật lại nội dung và tiến độ toàn bộ Sổ đầu bài thành công!&quot;);
      }
  }
}

function renderScheduleTable() {
 const tb=document.getElementById(&quot;tbody&quot;);
 tb.innerHTML=&quot;&quot;;

 currentSessions.forEach((s,si)=&gt;{
   let c = {LT:0, TH:0, KT:0};
   if (s.overrideCounts) {
     c = { ...s.overrideCounts };
   } else if (s.units) {
     s.units.forEach(x =&gt; { if(c[x.type] !== undefined) c[x.type]++; });
   }

   let content = s.manualContent || &quot;&quot;;
   const previousSession = si&gt;0 ? currentSessions[si-1] : null;

   const prevItemsByLesson = new Map();
   if(previousSession){
     (previousSession.units||[]).forEach(u=&gt;{
       if(!prevItemsByLesson.has(u.lesson)) prevItemsByLesson.set(u.lesson,new Set());
       (u.items||[]).forEach(it=&gt;{
         const txt=Array.isArray(it)?String(it[1]||&quot;&quot;).trim():String(it||&quot;&quot;).trim();
         if(txt) prevItemsByLesson.get(u.lesson).add(txt);
       });
     });
   }

   const orderedLessons=[];
   (s.units||[]).forEach(u=&gt;{
     if(u.lesson && !orderedLessons.includes(u.lesson)) orderedLessons.push(u.lesson);
   });

   if(!s.manualContent) {
     orderedLessons.forEach(lessonName=&gt;{
       content+=`&lt;div class=&quot;lesson-title&quot;&gt;${esc(lessonName)}&lt;/div&gt;`;

     const shownThisLesson=new Set();

     (s.units||[]).filter(u=&gt;u.lesson===lessonName).forEach(u=&gt;{
       (u.items||[]).forEach(it=&gt;{
         const txt=Array.isArray(it)?String(it[1]||&quot;&quot;).trim():String(it||&quot;&quot;).trim();
         const cls=Array.isArray(it)?(it[0]||&quot;major&quot;):&quot;major&quot;;
         if(!txt) return;

         if(shownThisLesson.has(txt)) return;
         shownThisLesson.add(txt);

         const continued = prevItemsByLesson.get(lessonName)?.has(txt) || false;
         const displayTxt = continued ? `${txt} (tiếp theo)` : txt;

         content+=`&lt;div class=&quot;${cls}&quot;&gt;${esc(displayTxt)}&lt;/div&gt;`;
       });
     });
     });
   }

   const dt = new Date(s.date);
   const tr=document.createElement(&quot;tr&quot;);
   
   // Check saved status to color the row
   const saved = (window.savedLessons||[]).find(l=&gt;l.schedule_tt == (si+1));
   if (saved) {
       let rowColor = 'rgba(16, 185, 129, 0.1)'; // Default: Đã soạn (Xanh ngọc nhạt)
       if (saved.status === 'APPROVED') rowColor = 'rgba(16, 185, 129, 0.2)'; // Đã duyệt (Xanh lá đậm hơn xíu)
       else if (saved.status === 'PENDING') rowColor = 'rgba(245, 158, 11, 0.15)'; // Chờ duyệt (Cam nhạt)
       else if (saved.status === 'REJECTED') rowColor = 'rgba(239, 68, 68, 0.1)'; // Từ chối (Đỏ nhạt)
       tr.style.backgroundColor = rowColor;
   }
   
   tr.innerHTML=`&lt;td class=&quot;stt&quot;&gt;${si+1}&lt;/td&gt;
   &lt;td class=&quot;date&quot;&gt;${fmt(dt)}&lt;br&gt;&lt;span style=&quot;font-size:11px;color:#64748b&quot;&gt;${weekdayName(dt)}&lt;/span&gt;
      &lt;br&gt;&lt;button type=&quot;button&quot; onclick=&quot;removeSessionByDate('${dateKey(dt)}', ${s.isExtra ? s.extId : 'null'})&quot; style=&quot;margin-top:4px; font-size:10px; padding:4px 6px; background:#fee2e2; color:#ef4444; border:1px solid #fca5a5; border-radius:4px; cursor:pointer;&quot; title=&quot;Xoá ngày này khỏi lịch trình&quot;&gt;&lt;i class=&quot;fas fa-trash-alt&quot;&gt;&lt;/i&gt; Xóa bớt&lt;/button&gt;
   &lt;/td&gt;
   &lt;td class=&quot;small&quot;&gt;&lt;input id=&quot;p_lt_${si}&quot; type=&quot;number&quot; min=&quot;0&quot; max=&quot;15&quot; class=&quot;period-input&quot; value=&quot;${c.LT||0}&quot; onchange=&quot;onPeriodChange(${si}, 'LT', this.value)&quot;&gt;&lt;/td&gt;
   &lt;td class=&quot;small&quot;&gt;&lt;input id=&quot;p_th_${si}&quot; type=&quot;number&quot; min=&quot;0&quot; max=&quot;15&quot; class=&quot;period-input&quot; value=&quot;${c.TH||0}&quot; onchange=&quot;onPeriodChange(${si}, 'TH', this.value)&quot;&gt;&lt;/td&gt;
   &lt;td class=&quot;small&quot;&gt;&lt;input id=&quot;p_kt_${si}&quot; type=&quot;number&quot; min=&quot;0&quot; max=&quot;15&quot; class=&quot;period-input&quot; value=&quot;${c.KT||0}&quot; onchange=&quot;onPeriodChange(${si}, 'KT', this.value)&quot;&gt;&lt;/td&gt;
   &lt;td class=&quot;content&quot;&gt;
   &lt;div class=&quot;manual-content-box&quot; contenteditable=&quot;true&quot; onblur=&quot;onContentChange(${si}, this)&quot; style=&quot;min-height:40px; padding:4px; border:1px dashed transparent; transition:border 0.2s;&quot; onfocus=&quot;this.style.border='1px dashed #cbd5e1'&quot;&gt;${content}&lt;/div&gt;
   ${s.isManual ? `&lt;div style=&quot;margin-top: 6px; font-size: 11.5px; color: #475569; display: flex; align-items: center; gap: 5px;&quot; contenteditable=&quot;false&quot;&gt;&lt;input type=&quot;checkbox&quot; id=&quot;standalone_${si}&quot; ${s.isStandalone ? 'checked' : ''} onchange=&quot;onStandaloneChange(${si}, this.checked)&quot;&gt;&lt;label for=&quot;standalone_${si}&quot; style=&quot;cursor:pointer; margin:0;&quot; title=&quot;Đánh dấu buổi học này là hoạt động chèn thêm (Ngoại khóa, Kiểm tra đột xuất, v.v.), không tiêu thụ tiết của Chương trình môn học, qua đó tự động đẩy lùi các bài giảng tiếp theo.&quot;&gt;Đẩy lùi nội dung bài sau&lt;/label&gt;&lt;/div&gt;` : ''}
   &lt;div contenteditable=&quot;false&quot; style=&quot;margin-top:8px&quot;&gt;
     &lt;button type=&quot;button&quot; onclick=&quot;sendSessionToPlanner(${si})&quot; style=&quot;padding:6px 9px;font-size:12px;background:#16469d; color:#fff; border-radius:4px; border:none; cursor:pointer;&quot;&gt;SOẠN GIÁO ÁN BUỔI NÀY&lt;/button&gt;
     ${saved ? `&lt;span style=&quot;font-size:11px; margin-left:8px; font-weight:600; color:${saved.status === 'APPROVED' ? '#059669' : (saved.status === 'PENDING' ? '#d97706' : (saved.status === 'REJECTED' ? '#dc2626' : '#16a34a'))};&quot;&gt;&lt;i class=&quot;fas fa-check-circle&quot; style=&quot;margin-right:3px;&quot;&gt;&lt;/i&gt;${saved.status === 'APPROVED' ? 'Đã duyệt' : (saved.status === 'PENDING' ? 'Chờ duyệt' : (saved.status === 'REJECTED' ? 'Bị từ chối' : 'Đã soạn'))}&lt;/span&gt;` : ''}
   &lt;/div&gt;
   &lt;/td&gt;
   &lt;td class=&quot;absent&quot;&gt;&lt;/td&gt;
   &lt;td class=&quot;sign&quot;&gt;&lt;/td&gt;`;
   tb.appendChild(tr);
 });
}


window.extraSessions = [];
window.deletedDates = []; // Track deleted dates

function removeSessionByDate(dateKeyStr, extId) {
    if(confirm('Bạn có chắc chắn muốn xoá lịch ngày này khỏi tiến độ không?')) {
        if (extId) {
            window.extraSessions = window.extraSessions.filter(x => x.id !== extId);
        } else {
            window.deletedDates.push(dateKeyStr);
        }
        updateScheduleProgression();
    }
}

