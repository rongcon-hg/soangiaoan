<script>
    injectLayout('projects', 'Soạn Giáo án');

function switchTab(step) {
  const step1 = document.getElementById("step1");
  const step2 = document.getElementById("step2");
  if(step1) step1.style.display = step === 1 ? "block" : "none";
  if(step2) step2.style.display = step === 2 ? "block" : "none";
  
  const pills = document.querySelectorAll(".step-pill");
  if(pills.length >= 2) {
    if(step === 1) {
      pills[0].style.background = "#fff";
      pills[0].style.color = "#16469d";
      pills[0].style.borderColor = "#fff";
      
      pills[1].style.background = "rgba(255,255,255,.14)";
      pills[1].style.color = "#fff";
      pills[1].style.borderColor = "rgba(255,255,255,.32)";
    } else {
      pills[1].style.background = "#fff";
      pills[1].style.color = "#16469d";
      pills[1].style.borderColor = "#fff";
      
      pills[0].style.background = "rgba(255,255,255,.14)";
      pills[0].style.color = "#fff";
      pills[0].style.borderColor = "rgba(255,255,255,.32)";
      if(window._lastSchedulePayload) {
        const pf = document.getElementById("plannerFrame");
        if(pf && pf.contentWindow) {
          if(typeof pf.contentWindow.receiveScheduleSession === "function") {
            pf.contentWindow.receiveScheduleSession(window._lastSchedulePayload);
          }
          pf.contentWindow.postMessage({type:"LOAD_SCHEDULE_SESSION",payload:window._lastSchedulePayload},"*");
        }
      }
    }
  }
}

// Make pills clickable
document.addEventListener("DOMContentLoaded", () => {
    const pills = document.querySelectorAll(".step-pill");
    if(pills.length >= 2) {
        pills[0].style.cursor = "pointer";
        pills[1].style.cursor = "pointer";
        pills[0].onclick = () => switchTab(1);
        pills[1].onclick = () => switchTab(2);
    }
    switchTab(1);
});

// Update the event listener to switch tab instead of scrolling

    
    let currentProject = null;
    let currentTT = null;
    const urlParams = new URLSearchParams(window.location.search);
    const projectId = urlParams.get('project');

    checkAuth().then(async u => { 
        if(!u) return;
        window.GEMINI_KEY = u.gemini_api_key || u.admin_gemini_api_key; 
        window.GEMINI_MODEL = u.gemini_model || "gemini-3.7-flash";
        window.CURRENT_USER = u;
        window.USER_SIGNATURE = u.signature || "";
        window.USER_NAME = u.full_name || u.username || "";
        if (u.is_expired) {
            setTimeout(() => {
                if (typeof openRenewalModal === 'function') openRenewalModal();
                if (typeof showAlert === 'function') showAlert('Tài khoản đã hết hạn sử dụng. Vui lòng gia hạn để tiếp tục sử dụng hệ thống.', 'warning');
            }, 500);
        }
        try {
          localStorage.setItem("giaoan_user_signature", window.USER_SIGNATURE);
          localStorage.setItem("giaoan_user_name", window.USER_NAME);
        } catch(e) {} 

        // Update plannerFrame AI settings
        const pf = document.getElementById("plannerFrame");
        if(pf && pf.contentWindow && pf.contentWindow.loadAISettings) {
            pf.contentWindow.loadAISettings();
        }

        if(projectId) {
            try {
                const res = await fetch(API_URL + '/projects/' + projectId, { headers: getHeaders() });
                if(res.ok) {
                    currentProject = await res.json();
                    
                    const iframe = document.getElementById("scheduleFrame");
                    // Fetch saved lessons to highlight in Schedule UI
                    let savedLessons = [];
                    try {
                        const savedRes = await fetch(API_URL + '/lessons/' + projectId + '/lessons', { headers: getHeaders() });
                        if(savedRes.ok) savedLessons = await savedRes.json();
                    } catch(e) { console.error("Lỗi tải DS giáo án đã lưu", e); }
                    
                    const sendData = () => {
                        if(currentProject.program_data) {
                            const pdata = Object.assign({}, currentProject.program_data, {
                                system_type: currentProject.system_type,
                                class_name: currentProject.class_name
                            });
                            
                            pdata.savedLessons = savedLessons;
                            
                            // Fallback courseInfo if missing or empty
                            if (!pdata.courseInfo) {
                                pdata.courseInfo = {
                                    name: currentProject.name,
                                    code: currentProject.course_code,
                                    total: currentProject.total_hours
                                };
                            } else {
                                if (!pdata.courseInfo.name) pdata.courseInfo.name = currentProject.name;
                                if (!pdata.courseInfo.code) pdata.courseInfo.code = currentProject.course_code;
                                if (!pdata.courseInfo.total) pdata.courseInfo.total = currentProject.total_hours;
                            }
                            iframe.contentWindow.postMessage({
                                type: "LOAD_PROJECT_STATE",
                                payload: pdata
                            }, "*");
                        } else {
                            iframe.contentWindow.postMessage({
                                type: "LOAD_PROJECT_STATE",
                                payload: {
                                    savedLessons: savedLessons,
                                    courseInfo: {
                                        name: currentProject.name,
                                        code: currentProject.course_code,
                                        total: currentProject.total_hours,
                                        systemType: currentProject.system_type,
                                        className: currentProject.class_name
                                    },
                                    system_type: currentProject.system_type,
                                    class_name: currentProject.class_name
                                }
                            }, "*");
                        }
                    };
                    
                    iframe.addEventListener('load', sendData);
                    sendData();
                }
            } catch(e) {
                console.error("Failed to load project", e);
            }
        }
    });

window.addEventListener("message", async e => {
  if(e.data?.type === "SAVE_PROJECT_STATE" && projectId && currentProject) {
      try {
          await fetch(API_URL + '/projects/' + projectId, {
              method: 'PUT',
              headers: getHeaders(),
              body: JSON.stringify({
                  name: e.data.payload?.courseInfo?.name || currentProject.name,
                  course_code: e.data.payload?.courseInfo?.code || currentProject.course_code,
                  total_hours: e.data.payload?.courseInfo?.total || currentProject.total_hours,
                  system_type: currentProject.system_type,
                  class_name: currentProject.class_name,
                  program_data: e.data.payload
              })
          });

          // Đồng thời lưu vào bảng schedules để thống kê và dữ liệu luôn đồng bộ
          if (e.data.payload?.generatedSchedule && e.data.payload.generatedSchedule.length > 0) {
              await fetch(API_URL + '/lessons/' + projectId + '/schedule', {
                  method: 'POST',
                  headers: getHeaders(),
                  body: JSON.stringify({ schedule_data: e.data.payload.generatedSchedule })
              }).catch(() => {});
          }

          if (e.data.showToast) {
              alert("✅ Đã chia lịch và tự động lưu Sổ đầu bài thành công vào CSDL!");
          }
          console.log("Đã lưu trạng thái vào CSDL");
      } catch(err) {
          console.error("Lỗi lưu trạng thái", err);
          if (e.data.showToast) alert("Lỗi khi lưu Sổ đầu bài vào CSDL.");
      }
  }

  if(e.data?.type==="OPEN_LESSON_PLAN_FROM_SCHEDULE"){
    if(typeof switchTab === "function") switchTab(2);

    const p=e.data.payload||{};
    currentTT = p.scheduleTT;
    const st=document.getElementById("transferStatus");
    st.style.display="block";
    const sysClassBadge = (p.systemType || p.className) ? ` [<b>${p.systemType || "Trung cấp"}${p.className ? " • Lớp: " + p.className : ""}</b>] · ` : "";
    st.innerHTML=`Đã chọn <b>${p.courseName||""} – ${p.courseCode||""}</b> · ${sysClassBadge}${p.weekday||""} ${p.date||""} · ${p.periods||0} tiết.`;
    
    // Check if lesson exists in DB
    try {
        if(projectId) {
            const res = await fetch(API_URL + '/lessons/' + projectId + '/lessons/' + p.scheduleTT, { headers: getHeaders() });
            if(res.ok) {
                const saved = await res.json();
                if(saved && saved.lesson_data) {
                    p.savedLesson = saved.lesson_data;
                    p.status = saved.status;
                    p.is_public = saved.is_public;
                    st.innerHTML += " <b>(Đã tải giáo án cũ từ CSDL)</b>";
                    let statusHtml = '';
                    if (saved.status === 'APPROVED') statusHtml = '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#dcfce7; color:#15803d; border-radius:4px; font-weight:bold; font-size:12px;">ĐÃ DUYỆT</span>';
                    else if (saved.status === 'PENDING') statusHtml = '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#fef3c7; color:#b45309; border-radius:4px; font-weight:bold; font-size:12px;">CHỜ DUYỆT</span>';
                    else if (saved.status === 'REJECTED') statusHtml = '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#fee2e2; color:#b91c1c; border-radius:4px; font-weight:bold; font-size:12px;">BỊ TỪ CHỐI</span>';
                    else statusHtml = '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#f1f5f9; color:#64748b; border-radius:4px; font-weight:bold; font-size:12px;">BẢN NHÁP</span>';
                    st.innerHTML += statusHtml;
                }
            }
        }
    } catch(err) { console.error("Lỗi khi tải giáo án cũ:", err); }

    p.userSignature = window.USER_SIGNATURE || "";
    p.userName = window.USER_NAME || "";
    window._lastSchedulePayload = p;

    const pf = document.getElementById("plannerFrame");
    const sendToPlanner = () => {
      if(pf && pf.contentWindow) {
        if(typeof pf.contentWindow.receiveScheduleSession === "function") {
          pf.contentWindow.receiveScheduleSession(p);
        }
        pf.contentWindow.postMessage({type:"LOAD_SCHEDULE_SESSION",payload:p},"*");
      }
    };

    sendToPlanner();
    setTimeout(sendToPlanner, 150);
    setTimeout(sendToPlanner, 400);
  }

  if(e.data?.type === "PLANNER_FRAME_READY") {
    if(window._lastSchedulePayload) {
      const pf = document.getElementById("plannerFrame");
      if(pf && pf.contentWindow) {
        if(typeof pf.contentWindow.receiveScheduleSession === "function") {
          pf.contentWindow.receiveScheduleSession(window._lastSchedulePayload);
        }
        pf.contentWindow.postMessage({type:"LOAD_SCHEDULE_SESSION",payload:window._lastSchedulePayload},"*");
      }
    }
  }

  if(e.data?.type === "SAVE_LESSON_PLAN" && projectId) {
      try {
          const res = await fetch(API_URL + '/lessons/' + projectId + '/lessons/' + e.data.payload.tt, {
              method: 'POST',
              headers: getHeaders(),
              body: JSON.stringify({ lesson_data: e.data.payload.data })
          });
          if(res.ok) {
              if(typeof Swal !== 'undefined') {
                  Swal.fire({
                      title: 'Đã lưu thành công!',
                      text: 'Giáo án đã được lưu thành công vào cơ sở dữ liệu!',
                      icon: 'success',
                      confirmButtonColor: '#16469d',
                      confirmButtonText: 'Đã hiểu'
                  });
              } else {
                  alert("Đã lưu giáo án thành công vào CSDL!");
              }
          } else {
              if(typeof Swal !== 'undefined') {
                  Swal.fire({
                      title: 'Lỗi lưu giáo án',
                      text: 'Không thể lưu giáo án vào hệ thống.',
                      icon: 'error',
                      confirmButtonColor: '#16469d'
                  });
              } else {
                  alert("Lỗi khi lưu giáo án.");
              }
          }
      } catch(err) {
          console.error(err);
          if(typeof Swal !== 'undefined') {
              Swal.fire({
                  title: 'Lỗi kết nối',
                  text: 'Lỗi mạng khi lưu giáo án: ' + err.message,
                  icon: 'error',
                  confirmButtonColor: '#16469d'
              });
          } else {
              alert("Lỗi mạng khi lưu giáo án.");
          }
      }
  }
});
  window.submitApproval = async function() {
    if (!(await customConfirm('Bạn có chắc chắn muốn gửi giáo án này cho Quản lý duyệt không?'))) return;
    
    try {
        Swal.fire({
            title: 'Đang tạo PDF & Gửi duyệt...',
            html: 'Quá trình xuất PDF và tải lên Google Drive có thể mất vài chục giây. Vui lòng không đóng trang...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        // 1. Get PDF Blob from iframe
        const frame = document.getElementById('plannerFrame');
        if(!frame || !frame.contentWindow || typeof frame.contentWindow.exportPdfAsBlob !== 'function') {
            throw new Error('Chưa thể xuất PDF. Vui lòng thử lại!');
        }
        
        const pdfBlob = await frame.contentWindow.exportPdfAsBlob();
        const file = new File([pdfBlob], `GiaoAn_${projectId}_${currentTT}.pdf`, { type: 'application/pdf' });
        
        // 2. Upload to Drive chunked
        const token = localStorage.getItem('token');
        const chunkSize = 3 * 1024 * 1024;
        
        const startRes = await fetch('/api/drive/start-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ fileName: file.name, mimeType: file.type })
        });
        if (!startRes.ok) throw new Error('Không thể khởi tạo upload Drive. Vui lòng kiểm tra cấu hình Google Drive.');
        const { uploadUrl } = await startRes.json();
        
        let fileId = null;
        for (let start = 0; start < file.size; start += chunkSize) {
            const end = Math.min(start + chunkSize, file.size);
            const chunk = file.slice(start, end);
            const chunkRes = await fetch('/api/drive/upload-chunk', {
                method: 'PUT',
                headers: {
                    'Authorization': 'Bearer ' + token,
                    'X-Upload-Url': uploadUrl,
                    'Content-Range': 'bytes ' + start + '-' + (end - 1) + '/' + file.size,
                    'Content-Type': 'application/octet-stream'
                },
                body: chunk
            });
            if (chunkRes.status === 308) continue;
            if (chunkRes.ok) {
                const data = await chunkRes.json();
                fileId = data.fileId;
                break;
            }
        }
        if (!fileId) throw new Error('Upload PDF thất bại (chưa hoàn thành)');
        
        const finishRes = await fetch('/api/drive/finish-upload', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ fileId })
        });
        if (!finishRes.ok) throw new Error('Không thể thiết lập quyền chia sẻ file');
        const { url: pdfLink } = await finishRes.json();

        // 3. Submit Approval to Database
        const res = await fetch(API_URL + '/approvals/submit', {
            method: 'POST',
            headers: getHeaders(),
            body: JSON.stringify({ project_id: projectId, schedule_tt: currentTT, pdf_link: pdfLink })
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || data.error || 'Lỗi gửi duyệt');
        
        Swal.fire({ text: 'Đã xuất PDF và gửi duyệt thành công!', icon: 'success', confirmButtonColor: '#16469d' });
        
        // Update badge
        const st = document.getElementById('transferStatus');
        if (st) {
            const badge = st.querySelector('#status-badge');
            if (badge) badge.outerHTML = '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#fef3c7; color:#b45309; border-radius:4px; font-weight:bold; font-size:12px;">CHỜ DUYỆT</span>';
            else st.innerHTML += '<span id="status-badge" style="margin-left:8px; padding:3px 8px; background:#fef3c7; color:#b45309; border-radius:4px; font-weight:bold; font-size:12px;">CHỜ DUYỆT</span>';
        }

        if (frame && frame.contentWindow) {
            frame.contentWindow.lessonStatus = 'PENDING';
            const btn = frame.contentWindow.document.getElementById('btnSubmitApproval');
            if (btn) btn.style.display = 'none';
            const btnShare = frame.contentWindow.document.getElementById('btnShareLibrary');
            if (btnShare) btnShare.style.display = 'none';
        }
        
    } catch(e) {
        Swal.fire({ text: e.message, icon: 'error' });
    }
  };

  window.toggleLibrary = async function() {
    if (!(await customConfirm('Bạn muốn thay đổi trạng thái chia sẻ của giáo án này trên Thư viện chung?'))) return;
    try {
        Swal.fire({
            title: 'Đang xử lý...',
            html: 'Đang đồng bộ dữ liệu với Thư viện, vui lòng chờ...',
            allowOutsideClick: false,
            didOpen: () => { Swal.showLoading(); }
        });

        // 1. Generate PDF if making it public (we don't know the exact current state, so we always generate it just in case)
        let pdfLink = null;
        const frame = document.getElementById('plannerFrame');
        if(frame && frame.contentWindow && typeof frame.contentWindow.exportPdfAsBlob === 'function') {
            try {
                const pdfBlob = await frame.contentWindow.exportPdfAsBlob();
                const file = new File([pdfBlob], `GiaoAn_${projectId}_${currentTT}.pdf`, { type: 'application/pdf' });
                
                const token = localStorage.getItem('token');
                const chunkSize = 3 * 1024 * 1024;
                
                const startRes = await fetch('/api/drive/start-upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ fileName: file.name, mimeType: file.type })
                });
                
                if (startRes.ok) {
                    const { uploadUrl } = await startRes.json();
                    let fileId = null;
                    for (let start = 0; start < file.size; start += chunkSize) {
                        const end = Math.min(start + chunkSize, file.size);
                        const chunkRes = await fetch('/api/drive/upload-chunk', {
                            method: 'PUT',
                            headers: {
                                'Authorization': 'Bearer ' + token,
                                'X-Upload-Url': uploadUrl,
                                'Content-Range': 'bytes ' + start + '-' + (end - 1) + '/' + file.size,
                                'Content-Type': 'application/octet-stream'
                            },
                            body: file.slice(start, end)
                        });
                        if (chunkRes.status === 308) continue;
                        if (chunkRes.ok) {
                            const data = await chunkRes.json();
                            fileId = data.fileId;
                            break;
                        }
                    }
                    if (fileId) {
                        const finishRes = await fetch('/api/drive/finish-upload', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                            body: JSON.stringify({ fileId })
                        });
                        if (finishRes.ok) {
                            const { url } = await finishRes.json();
                            pdfLink = url;
                        }
                    }
                }
            } catch(e) {
                console.warn('Lỗi tạo PDF khi chia sẻ:', e);
                // Continue even if PDF generation fails
            }
        }

        const reqBody = { project_id: projectId, schedule_tt: currentTT };
        if (pdfLink) reqBody.pdf_link = pdfLink;

        const res = await fetch(API_URL + '/library/toggle', {
            method: 'POST',
            headers: getHeaders(),
            body: JSON.stringify(reqBody)
        });
        const data = await res.json();
        if (!res.ok) throw new Error(data.message || data.error || 'Lỗi chia sẻ');
        
        Swal.fire({ text: data.is_public ? 'Đã công khai giáo án lên Thư viện!' : 'Đã gỡ giáo án khỏi Thư viện.', icon: 'success', confirmButtonColor: '#16469d' });
    } catch(err) {
        Swal.fire({ text: err.message, icon: 'error' });
    }
  };
</script>
