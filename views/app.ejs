     &lt;/tr&gt;`;
   }
 });
 box.innerHTML=`&lt;table style=&quot;width:100%;border-collapse:collapse&quot;&gt;
 &lt;thead&gt;&lt;tr&gt;
 &lt;th style=&quot;border-bottom:1px solid #ddd;padding:7px;text-align:left&quot;&gt;Bài / Mốc&lt;/th&gt;
 &lt;th style=&quot;border-bottom:1px solid #ddd;padding:7px&quot;&gt;LT giờ&lt;/th&gt;
 &lt;th style=&quot;border-bottom:1px solid #ddd;padding:7px&quot;&gt;TH giờ&lt;/th&gt;
 &lt;th style=&quot;border-bottom:1px solid #ddd;padding:7px;text-align:left&quot;&gt;Sau quy đổi&lt;/th&gt;
 &lt;/tr&gt;&lt;/thead&gt;
 &lt;tbody&gt;${rows}&lt;/tbody&gt;
 &lt;tfoot&gt;&lt;tr&gt;&lt;td colspan=&quot;3&quot; style=&quot;padding:8px;text-align:right&quot;&gt;&lt;b&gt;TỔNG SAU QUY ĐỔI&lt;/b&gt;&lt;/td&gt;
 &lt;td style=&quot;padding:8px&quot;&gt;&lt;b&gt;${conversionSummary().total} tiết&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/tfoot&gt;
 &lt;/table&gt;`;
}


async function uploadTextbookToDrive() {
    const fileInput = document.getElementById('textbookFile');
    const file = fileInput.files[0];
    if (!file) {
        alert('Vui lòng chọn file giáo trình trước khi tải lên Drive.');
        return;
    }

    let token = null;
    try { token = localStorage.getItem('token') || (window.parent && window.parent.localStorage ? window.parent.localStorage.getItem('token') : null); } catch(e) {}
    
    if(token) {
        let driveStatusDiv = document.getElementById('textbookDriveStatusBox');
        if (!driveStatusDiv) {
            driveStatusDiv = document.createElement('div');
            driveStatusDiv.id = 'textbookDriveStatusBox';
            driveStatusDiv.style.marginTop = '10px';
            const fileStatus = document.getElementById('textbookFileStatus');
            if (fileStatus && fileStatus.parentNode) {
                fileStatus.parentNode.insertBefore(driveStatusDiv, fileStatus.nextSibling);
            }
        }
        driveStatusDiv.innerHTML = &quot;&lt;span style='color:#16469d;'&gt;⏳ &lt;b&gt;Đang tải giáo trình lên Google Drive, vui lòng chờ...&lt;/b&gt;&lt;/span&gt;&quot;;
        
        const chunkSize = 3 * 1024 * 1024;
        (async () =&gt; {
            try {
                const startRes = await fetch('/api/drive/start-upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ fileName: file.name, mimeType: file.name.toLowerCase().endsWith('.docx') ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' : (file.type || 'application/octet-stream') })
                });
                if (!startRes.ok) throw new Error('Không thể khởi tạo upload Drive');
                const { uploadUrl } = await startRes.json();
                
                let fileId = null;
                for (let start = 0; start &lt; file.size; start += chunkSize) {
                    const end = Math.min(start + chunkSize, file.size);
                    const chunk = file.slice(start, end);
                    const chunkRes = await fetch('/api/drive/upload-chunk', {
                        method: 'PUT',
                        headers: {
                            'Authorization': 'Bearer ' + token,
                            'X-Upload-Url': uploadUrl,
                            'Content-Range': 'bytes ' + start + '-' + (end - 1) + '/' + file.size,
                            'Content-Type': 'application/octet-stream'
                        },
                        body: chunk
                    });
                    if (chunkRes.status === 308) continue;
                    if (chunkRes.ok) {
                        const data = await chunkRes.json();
                        fileId = data.fileId;
                        break;
                    }
                }
                if (!fileId) throw new Error('Upload incomplete');
                
                const finishRes = await fetch('/api/drive/finish-upload', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                    body: JSON.stringify({ fileId })
                });
                const { url } = await finishRes.json();
                
                driveStatusDiv.innerHTML = &quot;&lt;span style='color:#166534;'&gt;✅ &lt;b&gt;Đã upload giáo trình thành công:&lt;/b&gt; &lt;a href='&quot; + url + &quot;' target='_blank' style='color:#16469d;font-weight:bold;text-decoration:underline;'&gt;Xem trên Google Drive&lt;/a&gt;&lt;/span&gt;&quot;;
                textbookData.driveLink = url;
                if(typeof saveStateToBackend === 'function') saveStateToBackend();
            } catch(err) {
                console.error(err);
                driveStatusDiv.innerHTML = &quot;&lt;span style='color:#b45309;'&gt;❌ &lt;b&gt;Lỗi upload giáo trình:&lt;/b&gt; &quot; + (err.message || err.toString()) + &quot;&lt;/span&gt;&quot;;
            }
        })();
    }
}

async function extractTextFromPdf(file) {
  if (typeof pdfjsLib === &quot;undefined&quot;) {
    throw new Error(&quot;Chưa tải được thư viện đọc PDF. Vui lòng kiểm tra kết nối mạng.&quot;);
  }
  const arrayBuffer = await file.arrayBuffer();
  const loadingTask = pdfjsLib.getDocument({ data: arrayBuffer });
  const pdfDoc = await loadingTask.promise;
  let fullText = &quot;&quot;;
  for (let pageNum = 1; pageNum &lt;= pdfDoc.numPages; pageNum++) {
    const page = await pdfDoc.getPage(pageNum);
    const textContent = await page.getTextContent();
    const pageItems = textContent.items || [];
    let lastY = null;
    let pageStr = &quot;&quot;;
    for (const item of pageItems) {
      if (lastY !== null &amp;&amp; Math.abs(item.transform[5] - lastY) &gt; 5) {
        pageStr += &quot;\n&quot;;
      } else if (pageStr.length &gt; 0 &amp;&amp; !pageStr.endsWith(&quot; &quot;) &amp;&amp; !pageStr.endsWith(&quot;\n&quot;)) {
        pageStr += &quot; &quot;;
      }
      pageStr += item.str;
      lastY = item.transform[5];
    }
    fullText += pageStr + &quot;\n\n&quot;;
  }
  return fullText.trim();
}

async function readTextbookFile(file) {
    if(!file) return;
    const status = document.getElementById(&quot;textbookFileStatus&quot;);
    status.textContent = &quot;Đang đọc giáo trình: &quot; + file.name + &quot; ...&quot;;
    try {
        let text = &quot;&quot;;
        const ext = file.name.split(&quot;.&quot;).pop().toLowerCase();
        if(ext === &quot;docx&quot;) {
            if(typeof mammoth === &quot;undefined&quot;) throw new Error(&quot;Không tải được thư viện đọc Word DOCX.&quot;);
            const buf = await file.arrayBuffer();
            const rawResult = await mammoth.extractRawText({ arrayBuffer: buf });
            text = rawResult.value;
        } else if(ext === &quot;pdf&quot;) {
            text = await extractTextFromPdf(file);
        } else {
            text = await file.text();
        }
        textbookData = {
            fileName: file.name,
            text: text,
            driveLink: textbookData?.driveLink || &quot;&quot;
        };
        status.innerHTML = `&lt;b style=&quot;color:#166534;&quot;&gt;✅ Đã đọc thành công giáo trình:&lt;/b&gt; ${escapeHtml(file.name)} (${(text.length/1000).toFixed(1)}k ký tự). Nội dung này sẽ dùng để trích xuất tự động tại Bước 2.`;
        if(typeof saveStateToBackend === 'function') saveStateToBackend();
    } catch(err) {
        console.error(err);
        status.innerHTML = `&lt;span style=&quot;color:#dc2626;&quot;&gt;❌ Lỗi đọc giáo trình: ${escapeHtml(err.message)}&lt;/span&gt;`;
    }
}

async function uploadToDrive() {
    const fileInput = document.getElementById('programFile');
    const file = fileInput.files[0];
    if (!file) return;


   let token = null;
   try { token = localStorage.getItem('token') || (window.parent && window.parent.localStorage ? window.parent.localStorage.getItem('token') : null); } catch(e) {}
   
   if(token) {
       let driveStatusDiv = document.getElementById('driveStatusBox');
       if (!driveStatusDiv) {
           driveStatusDiv = document.createElement('div');
           driveStatusDiv.id = 'driveStatusBox';
           driveStatusDiv.style.marginTop = '10px';
           const fileStatus = document.getElementById('fileStatus');
           if (fileStatus && fileStatus.parentNode) {
               fileStatus.parentNode.insertBefore(driveStatusDiv, fileStatus.nextSibling);
           }
       }
       driveStatusDiv.innerHTML = &quot;<span style='color:#16469d;'>⏳ <b>Hệ thống đang đẩy file lên Google Drive, vui lòng chờ...</b></span>&quot;;
       
       const chunkSize = 3 * 1024 * 1024; // 3MB per chunk to bypass 4.5MB limit
       
       (async () => {
           try {
               const startRes = await fetch('/api/drive/start-upload', {
                   method: 'POST',
                   headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                   body: JSON.stringify({ fileName: file.name, mimeType: file.name.toLowerCase().endsWith('.docx') ? 'application/vnd.openxmlformats-officedocument.wordprocessingml.document' : (file.type || 'application/octet-stream') })
               });
               if (!startRes.ok) {
                   let errText = await startRes.text();
                   try { errText = JSON.parse(errText).message || errText; } catch(e) {}
                   throw new Error(errText);
               }
               const { uploadUrl } = await startRes.json();
               
               let fileId = null;
               for (let start = 0; start < file.size; start += chunkSize) {
                   const end = Math.min(start + chunkSize, file.size);
                   const chunk = file.slice(start, end);
                   const chunkRes = await fetch('/api/drive/upload-chunk', {
                       method: 'PUT',
                       headers: {
                           'Authorization': 'Bearer ' + token,
                           'X-Upload-Url': uploadUrl,
                           'Content-Range': 'bytes ' + start + '-' + (end - 1) + '/' + file.size,
                           'Content-Type': 'application/octet-stream'
                       },
                       body: chunk
                   });
                   
                   if (chunkRes.status === 308) {
                       continue;
                   } else if (chunkRes.ok) {
                       const data = await chunkRes.json();
                       fileId = data.fileId;
                       break;
                   } else {
                       let errText = await chunkRes.text();
                       try { errText = JSON.parse(errText).error || errText; } catch(e) {}
                       throw new Error(errText);
                   }
               }
               if (!fileId) throw new Error('Upload incomplete');
               
               const finishRes = await fetch('/api/drive/finish-upload', {
                   method: 'POST',
                   headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
                   body: JSON.stringify({ fileId })
               });
               if (!finishRes.ok) {
                   let errText = await finishRes.text();
                   try { errText = JSON.parse(errText).error || errText; } catch(e) {}
                   throw new Error(errText);
               }
               const { url } = await finishRes.json();
               
               driveStatusDiv.innerHTML = &quot;<span style='color:#166534;'>✅ <b>Đã upload thành công:</b> <a href='&quot; + url + &quot;' target='_blank' style='color:#16469d;font-weight:bold;text-decoration:underline;'>Xem trên Google Drive</a></span>&quot;;
               course.driveLink = url;
               if(typeof saveStateToBackend === 'function') saveStateToBackend();
           } catch(err) {
               console.error(err);
               driveStatusDiv.innerHTML = &quot;<span style='color:#b45309;'>❌ <b>Lỗi khi đẩy file lên Google Drive:</b> &quot; + (err.message || err.toString()) + &quot;</span>&quot;;
           }
       })();
   }
 else { alert('Vui lòng đăng nhập lại để sử dụng tính năng tải lên Google Drive.'); } }

