    .modal{position:fixed;inset:0;background:rgba(0,0,0,.45);display:flex;align-items:flex-start;justify-content:center;padding:60px 20px 20px;z-index:99}
    .modal-box{background:#fff;width:min(920px,96vw);max-height:90vh;overflow:auto;border-radius:14px;border:1px solid var(--line)}
    .modal-head{display:flex;justify-content:space-between;align-items:center;padding:13px 16px;border-bottom:1px solid var(--line)}
    .modal-body{padding:16px}
    .checklist{max-height:240px;overflow:auto;border:1px solid var(--line);border-radius:9px;padding:8px}
    .checkitem{display:flex;gap:8px;align-items:flex-start;margin:5px 0}
    .checkitem input{width:auto;margin-top:4px}
    .pill{display:inline-block;padding:3px 8px;border-radius:999px;background:var(--soft);color:var(--primary);font-size:12px}

/* Dark Mode for Planner Frame */
body.dark-mode {
    --bg: #0f172a; --text: #e2e8f0; --border: #334155; --primary: #3b82f6;
    background: var(--bg) !important; color: var(--text) !important;
}
body.dark-mode .card, body.dark-mode .panel, body.dark-mode .left, body.dark-mode .preview-wrap { background: #1e293b !important; border-color: var(--border) !important; color: #e2e8f0 !important; }
body.dark-mode input, body.dark-mode select, body.dark-mode textarea { background: #0f172a !important; color: #e2e8f0 !important; border-color: var(--border) !important; }
body.dark-mode table { background-color: var(--bg) !important; }
body.dark-mode th { background: #0f172a !important; color: #f8fafc !important; border-color: var(--border) !important; }
body.dark-mode td { border-color: var(--border) !important; background: transparent !important; color: var(--text) !important; }
body.dark-mode .status { background: transparent !important; }
body.dark-mode .content[contenteditable='true'] { background: #0f172a !important; color: #e2e8f0 !important; }
body.dark-mode .ai-btn { border: 1px solid #3b82f6; }

    .note{background:#fffceb;border:1px solid #f2df91;padding:10px;border-radius:9px;font-size:13px}
    button { display: inline-flex; align-items: center; gap: 6px; justify-content: center; } button svg { flex-shrink: 0; }
    @media(max-width:1250px) { .btn-text { display: none !important; } .btn { padding: 9px !important; } }
    @media(max-width:1000px){.grid{grid-template-columns:1fr}.topbar{align-items:flex-start;flex-direction:column}.preview-wrap{overflow:auto}}
    @media print{
      body{background:#fff}.topbar,.left,.no-print{display:none!important}.grid{display:block}.card{border:0;box-shadow:none}.preview-wrap{padding:0}
      .app{max-width:none;padding:0}
    }
  
