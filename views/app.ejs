&lt;script&gt;
let course = {name:&quot;&quot;,code:&quot;&quot;,total:0,lt:0,th:0,kt:0};
let lessons = [];
let programSequence = []; // đúng thứ tự: Bài -&gt; Kiểm tra -&gt; Bài -&gt; ... -&gt; Thi
let currentSessions = [];
let textbookData = { fileName: &quot;&quot;, text: &quot;&quot;, driveLink: &quot;&quot; };

function saveStateToBackend(showToast) {
    const scheduleSettings = {
        startDate: document.getElementById(&quot;startDate&quot;).value,
        slotCount: document.getElementById(&quot;weeklyCount&quot;).value,
        slots: []
    };
    for(let i = 0; i < Number(scheduleSettings.slotCount||0); i++) {
        const wd = document.getElementById(&quot;wd&quot;+i);
        const cp = document.getElementById(&quot;cp&quot;+i);
        if(wd && cp) {
            scheduleSettings.slots.push({ weekday: wd.value, periods: cp.value });
        }
    }
    
    const payload = {
        courseInfo: course,
        syllabus: lessons,
        programSequence: programSequence,
        textbookData: textbookData,
        exclusions: exclusions,
        scheduleSettings: scheduleSettings,
        extraSessions: window.extraSessions || [],
        generatedSchedule: currentSessions
    };
    
    window.parent.postMessage({
        type: &quot;SAVE_PROJECT_STATE&quot;,
        payload: payload,
        showToast: Boolean(showToast)
    }, &quot;*&quot;);
}

function manualSaveSchedule() {
    if(!currentSessions || !currentSessions.length) {
        alert(&quot;Chưa có dữ liệu Lịch giảng / Sổ đầu bài. Vui lòng bấm CHIA LỊCH trước khi lưu nhé!&quot;);
        return;
    }
    saveStateToBackend(true);
}

window.addEventListener(&quot;message&quot;, e => {
    if (e.data?.type === &quot;LOAD_PROJECT_STATE&quot;) {
        const payload = e.data.payload;
        if (!payload) return;
        
        window.savedLessons = payload.savedLessons || [];
        window.extraSessions = payload.extraSessions || [];
        
        if (payload.courseInfo) {
            course = payload.courseInfo;
            if (payload.system_type) course.systemType = payload.system_type;
            if (payload.class_name) course.className = payload.class_name;
        }
        if (payload.syllabus) lessons = payload.syllabus;
        if (payload.programSequence && payload.programSequence.length > 0) {
            programSequence = payload.programSequence;
        } else if (payload.syllabus && payload.syllabus.length > 0) {
            programSequence = payload.syllabus.map((l, i) => ({
                kind: &quot;lesson&quot;,
                no: l.no || (i + 1),
                title: l.title || &quot;&quot;,
                ltHours: l.ltHours || 0,
                thHours: l.thHours || 0,
                ltPeriods: l.ltPeriods !== undefined ? l.ltPeriods : Math.ceil(l.ltHours || 0),
                thPeriods: l.thPeriods !== undefined ? l.thPeriods : Math.ceil((l.thHours || 0) * 60 / 45),
                items: l.items || [],
                objectives: l.objectives || [],
                objectivesText: l.objectivesText || &quot;&quot;
            }));
        }
        if (payload.rawCurriculumText || (payload.courseInfo && payload.courseInfo.rawCurriculumText)) {
            const rawCurText = payload.rawCurriculumText || payload.courseInfo.rawCurriculumText;
            const reDetailMap = parseDetailItems(rawCurText);
            programSequence.forEach(l => {
                if (l.kind === 'lesson' && l.no && reDetailMap[l.no]) {
                    l.objectives = reDetailMap[l.no].objectives || [];
                    l.objectivesText = reDetailMap[l.no].objectivesText || &quot;&quot;;
                }
            });
        }
        if (payload.textbookData) {
            textbookData = payload.textbookData;
            const tbStatus = document.getElementById(&quot;textbookFileStatus&quot;);
            if (tbStatus) {
                if (textbookData.text) {
                    tbStatus.innerHTML = `&lt;b&gt;Đã có giáo trình:&lt;/b&gt; ${esc(textbookData.fileName || 'Giáo trình môn học')} (${(textbookData.text.length / 1000).toFixed(1)}k ký tự).` +
                        (textbookData.driveLink ? `&lt;br&gt;📁 &lt;a href='${textbookData.driveLink}' target='_blank' style='color:#16469d;font-weight:bold;text-decoration:underline;'&gt;Mở trên Google Drive&lt;/a&gt;` : '');
                } else {
                    tbStatus.textContent = &quot;Chưa tải giáo trình môn học.&quot;;
                }
            }
        }
        if (payload.exclusions) exclusions = payload.exclusions;
        if (payload.generatedSchedule) currentSessions = payload.generatedSchedule;
        
        // Restore scheduleConfig
        if (payload.scheduleSettings) {
            if(payload.scheduleSettings.startDate) document.getElementById(&quot;startDate&quot;).value = payload.scheduleSettings.startDate;
            if(payload.scheduleSettings.slotCount) {
                document.getElementById(&quot;weeklyCount&quot;).value = payload.scheduleSettings.slotCount;
                renderWeeklySlots(); // render inputs
                // Now fill the values
                payload.scheduleSettings.slots.forEach((s, idx) => {
                    const wd = document.getElementById(&quot;wd&quot;+idx);
                    const cp = document.getElementById(&quot;cp&quot;+idx);
                    if (wd) wd.value = s.weekday;
                    if (cp) cp.value = s.periods;
                });
            }
        }
        
        updateCourseCards();
        renderConversionPreview();
        renderExclusions();
        
        if (currentSessions && currentSessions.length > 0) {
            renderScheduleTable();
        } else {
            updateWeeklyCheck();
        }
        
        const status = document.getElementById(&quot;fileStatus&quot;);
        if (status) {
            if (course && course.driveLink) {
                status.innerHTML = `&lt;b&gt;Đã tải dữ liệu dự án từ máy chủ.&lt;/b&gt;&lt;br&gt;📁 &lt;a href='${course.driveLink}' target='_blank' style='color:#16469d;font-weight:bold;text-decoration:underline;'&gt;Mở file Chương trình môn học trên Google Drive&lt;/a&gt;`;
            } else {
                status.innerHTML = `&lt;b&gt;Đã tải dữ liệu dự án từ máy chủ.&lt;/b&gt;`;
            }
        }
    }
});


function conversionSummary(){
 const summary={lt:0,th:0,kt:0,total:0};

 if(programSequence.length){
   programSequence.forEach(x=&gt;{
     if(x.kind===&quot;lesson&quot;){
       summary.lt += Number(x.ltPeriods||0);
       summary.th += Number(x.thPeriods||0);
     }else if(x.kind===&quot;assessment&quot;){
       summary.kt += Number(x.periodsKT||0);
       summary.th += Number(x.periodsTH||0);
     }
   });
   summary.total=summary.lt+summary.th+summary.kt;
   return summary;
 }

 summary.lt=Number(course.lt||0);
 summary.th=course.th ? Math.ceil(Number(course.th)*60/45) : 0;
 summary.total=summary.lt+summary.th;
 return summary;
}

function convertedTotal(){
 return conversionSummary().total;
}

function updateCourseCards(){
 const hasCourse=!!(course.name||course.code||course.total||course.lt||course.th||course.kt);
 document.getElementById(&quot;courseName&quot;).textContent=course.name||&quot;Chưa tải chương trình môn học&quot;;
 document.getElementById(&quot;courseCode&quot;).textContent=course.code||&quot;—&quot;;
 const scEl=document.getElementById(&quot;courseSystemClass&quot;);
 if(scEl){
   const sys = course.systemType || &quot;&quot;;
   const cls = course.className || &quot;&quot;;
   if(sys || cls){
     scEl.textContent = (sys ? sys : &quot;Trung cấp&quot;) + (cls ? &quot; • &quot; + cls : &quot;&quot;);
   } else {
     scEl.textContent = &quot;—&quot;;
   }
 }
 document.getElementById(&quot;totalHours&quot;).textContent=hasCourse ? (course.total||0)+&quot; giờ&quot; : &quot;—&quot;;

 const s=conversionSummary();
 const convertedEl=document.getElementById(&quot;converted&quot;);
 const breakdownEl=document.getElementById(&quot;convertedBreakdown&quot;);

 if(!hasCourse){
   convertedEl.textContent=&quot;—&quot;;
   breakdownEl.innerHTML=&quot;&quot;;
   document.getElementById(&quot;formulaInfo&quot;).innerHTML=
     `&lt;b&gt;Quy tắc:&lt;/b&gt; LT của từng Bài = số giờ LT; TH của từng Bài = làm tròn lên (giờ TH × 60/45). Kiểm tra tự động tính như Thực hành.`;
   return;
 }

 convertedEl.textContent=`${s.total} tiết`;
 breakdownEl.innerHTML=
   `&lt;div style=&quot;display:flex; flex-wrap:wrap; gap:16px; font-size:0.95em; margin-top:12px; font-weight:normal; color:#475569;&quot;&gt;`+
   `&lt;span&gt;Lý thuyết: &lt;b style=&quot;color:#1e293b;&quot;&gt;${s.lt} tiết&lt;/b&gt;&lt;/span&gt;`+
   `&lt;span&gt;Thực hành: &lt;b style=&quot;color:#1e293b;&quot;&gt;${s.th} tiết&lt;/b&gt;&lt;/span&gt;`+
   `&lt;span&gt;Kiểm tra: &lt;b style=&quot;color:#1e293b;&quot;&gt;${s.kt} tiết&lt;/b&gt;&lt;/span&gt;`+
   `&lt;span&gt;Tổng cộng: &lt;b style=&quot;color:#1e293b;&quot;&gt;${s.total} tiết&lt;/b&gt;&lt;/span&gt;`+
   `&lt;/div&gt;`;

 document.getElementById(&quot;formulaInfo&quot;).innerHTML=
   `&lt;b&gt;Quy tắc đang áp dụng:&lt;/b&gt; quy đổi &lt;b&gt;riêng từng Bài&lt;/b&gt;. `+
   `LT = giờ LT; TH = CEILING(giờ TH × 60/45). `+
   `&lt;b&gt;Kiểm tra:&lt;/b&gt; nếu ở cột LT thì giữ nguyên số giờ = số tiết KT; nếu ở cột TH thì CEILING(giờ KT × 60/45) phân bổ 1 tiết KT + số còn lại vào TH. `+
   `&lt;b&gt;Thi kết thúc môn học không đưa vào Sổ đầu bài.&lt;/b&gt;`;
}

function normalizeLines(text){
 // Chỉ tách dòng và bỏ khoảng trắng đầu/cuối.
 // KHÔNG sửa câu chữ, dấu câu, số thứ tự hay nội dung nguồn.
 return String(text||&quot;&quot;)
   .replace(/\r\n/g,&quot;\n&quot;)
   .replace(/\r/g,&quot;\n&quot;)
   .split(&quot;\n&quot;)
   .map(x=&gt;x.trim())
   .filter(x=&gt;x.length&gt;0);
}

function exactKey(s){
 // Chỉ dùng để so trùng; KHÔNG dùng làm nội dung hiển thị.
 return String(s||&quot;&quot;).replace(/\s+/g,&quot; &quot;).trim().toLowerCase();
}

function getExactCellLines(cell){
 if(!cell) return [];

 // Mammoth thường chuyển từng dòng Word thành &lt;p&gt;/&lt;li&gt;.
 // Ưu tiên đọc từng block để giữ nguyên câu chữ và dấu câu.
 const blocks=[...cell.querySelectorAll(&quot;p,li&quot;)];
 let lines=[];
 if(blocks.length){
   lines=blocks.map(el=&gt;(el.textContent||&quot;&quot;).trim()).filter(Boolean);
 }else{
   const raw=(cell.innerText||cell.textContent||&quot;&quot;)
     .replace(/\r\n/g,&quot;\n&quot;)
     .replace(/\r/g,&quot;\n&quot;);
   lines=raw.split(&quot;\n&quot;).map(x=&gt;x.trim()).filter(Boolean);
 }

 const out=[];
 const seen=new Set();
 for(const line of lines){
   const key=exactKey(line);
   if(key &amp;&amp; !seen.has(key)){
     seen.add(key);
     out.push(line); // lưu nguyên văn
   }
 }
 return out;
}

let receivedFullCourse = null;
let receivedFullProgram = null;
// already declared at top

function romanToInt(s) {
  if (!s) return 0;
  if (/^\d+$/.test(s)) return parseInt(s, 10);
  const map = {I:1, V:5, X:10, L:50, C:100, D:500, M:1000};
  let num = 0, prev = 0;
  const str = String(s).toUpperCase().trim();
  for (let i = str.length - 1; i >= 0; i--) {
    const curr = map[str[i]] || 0;
    if (curr < prev) num -= curr;
    else num += curr;
    prev = curr;
  }
  return num || parseInt(s, 10) || 0;
}
function parseCourseInfo(text){
 const clean=text.replace(/\r/g,&quot; &quot;).replace(/[ \t]+/g,&quot; &quot;);
 let m;
 m=clean.match(/Tên môn học\s*:\s*([^\n\r]+)/i); if(m)course.name=m[1].trim();
 m=clean.match(/Mã(?: số)? môn học\s*:\s*([A-Za-z0-9 _-]+)/i); if(m)course.code=m[1].trim();
 m=clean.match(/Thời gian(?:\s*thực\s*hiện)?(?:\s*môn\s*học)?\s*:\s*(\d+)\s*giờ/i); if(m)course.total=Number(m[1]);
 m=clean.match(/Lý thuyết\s*:\s*(\d+)\s*giờ/i); if(m)course.lt=Number(m[1]);
 m=clean.match(/Thực hành[^:]*:\s*(\d+)\s*giờ/i); if(m)course.th=Number(m[1]);
 m=clean.match(/(?:Thi\s*\/?\s*)?Kiểm tra\s*:\s*0?(\d+)\s*giờ/i); if(m)course.kt=Number(m[1]);
}

function parseDetailItems(text){
 let detail=String(text||&quot;&quot;);

 const parts=detail.split(/(?:(?:2|II|B)\.\s*)?Nội\s*dung\s*chi\s*tiết(?:\s*của\s*môn\s*học)?\s*:/i);
 if(parts.length&gt;1) detail=parts.slice(1).join(&quot;\n&quot;);

 detail=detail.split(/\n\s*(?:IV|V)\.\s*/i)[0];

 const lines=normalizeLines(detail);
 const map={};
 let currentNo=null;
 let inContent=false;
 let inObjectives=false;

 function numbered(line){
   // Nhận 1. / 1 / 1.1. / 1.1 nhưng lưu NGUYÊN VĂN dòng gốc.
   const m=line.match(/^(\d+(?:\.\d+)*)\.?\s+(.+)$/);
   return m ? {num:m[1], raw:line} : null;
 }

 for(const line of lines){
   const lm=line.match(/^(?:Bài|Chương|Phần)\s*(\d+|[IVXLCDM]+)[\.\:\-\s]\s*(.*)$/i);
   if(lm){
     currentNo=romanToInt(lm[1]);
     const titleRaw=line.replace(/\s*Thời gian\s*[:\-].*$/i,&quot;&quot;).trim();
     if(!map[currentNo]) map[currentNo]={title:titleRaw,items:[],objectives:[],objectivesText:&quot;&quot;};
     else if(!map[currentNo].title) map[currentNo].title=titleRaw;
     if(!map[currentNo].objectives) map[currentNo].objectives=[];
     inContent=false;
     inObjectives=false;
     continue;
   }

   if(currentNo===null) continue;

   // Nhận diện phần Nội dung: 2. Nội dung / Nội dung / Nội dung của bài / Nội dung bài học / Nội dung chi tiết
   if(/^(?:\d+\.\s*)?Nội\s*dung(?:\s*chi\s*tiết|\s*của\s*(?:bài|chương|phần)|\s*(?:bài\s*học|chương))?\s*:?\s*$/i.test(line)){
     inContent=true;
     inObjectives=false;
     continue;
   }

   // Nhận diện phần Mục tiêu: 1. Mục tiêu / Mục tiêu / Mục tiêu của bài / Mục tiêu bài học / Mục tiêu của chương
   if(/^(?:\d+\.\s*)?Mục\s*tiêu(?:\s*của\s*(?:bài|chương|phần)|\s*(?:bài\s*học|chương))?\s*:?\s*$/i.test(line)){
     inContent=false;
     inObjectives=true;
     continue;
   }

   if(inObjectives){
     const trimmed = line.trim();
     if(trimmed){
       if(/^(?:Bài|Chương|Phần)\s*(\d+|[IVXLCDM]+)/i.test(trimmed)){
         inObjectives=false;
       } else {
         if(!map[currentNo].objectives) map[currentNo].objectives=[];
         map[currentNo].objectives.push(trimmed);
       }
     }
     continue;
   }

   if(inContent){
     const it=numbered(line);
     if(!it) continue;

     const body=it.raw.replace(/^(\d+(?:\.\d+)*)\.?\s+/,&quot;&quot;);
     if(/^(Mục tiêu|Nội dung)/i.test(body.trim())) continue;

     const depth=(it.num.match(/\./g)||[]).length;
     const key=exactKey(it.raw);
     if(!map[currentNo].items.some(x=&gt;exactKey(x[1])===key)){
       map[currentNo].items.push([depth&gt;=1?&quot;sub&quot;:&quot;major&quot;, it.raw]);
     }
   }
 }

 for(const k of Object.keys(map)){
   if(map[k].objectives &amp;&amp; map[k].objectives.length){
     map[k].objectivesText = map[k].objectives.join(&quot;\n&quot;);
   }
 }

 return map;
}

function cellNumber(td){
 const s=(td?.textContent||&quot;&quot;).replace(/[^\d.,-]/g,&quot;&quot;).replace(&quot;,&quot;,&quot;.&quot;).trim();
 const n=Number(s);
 return Number.isFinite(n)?n:0;
}

function parseProgramTable(htmlText, detailMap){
 const holder=document.createElement(&quot;div&quot;);
 holder.innerHTML=htmlText;
 const tables=[...holder.querySelectorAll(&quot;table&quot;)];
 let table=null;
 let maxRows = 0;
 let biggestTable = null;
 for(const t of tables){
   const txt=t.textContent||&quot;&quot;;
   const rowCount = t.querySelectorAll(&quot;tr&quot;).length;
   if(rowCount &gt; maxRows) { maxRows = rowCount; biggestTable = t; }
   if(/Tên chương|Tên phần|Tên các bài|Tên các phần|Tên bài|Nội dung/i.test(txt) &amp;&amp; (/Lý thuyết|LT|Số tiết|Thời gian/i.test(txt))){
     table=t; break;
   }
 }
 if(!table &amp;&amp; biggestTable &amp;&amp; maxRows &gt;= 2) table = biggestTable;
 if(!table) return [];

 const rows=[...table.querySelectorAll(&quot;tr&quot;)];
 const sequence=[];
 const seenLessons=new Set();

 // Thu toàn bộ đề mục NGUYÊN VĂN từ chính bảng phân phối.
 const tableItemsByLesson={};
 let currentLessonNo=null;

 for(const row of rows){
   const cells=[...row.querySelectorAll(&quot;td,th&quot;)];
   if(cells.length&lt;2) continue;

   const lines=getExactCellLines(cells[1]);
   if(!lines.length) continue;

   for(let li=0; li&lt;lines.length; li++){
     const raw=lines[li];

     const lm=raw.match(/^(?:Bài|Chương|Phần)\s*(\d+|[IVXLCDM]+)[\.\:\-\s]\s*(.+)$/i);
     if(lm){
       currentLessonNo=romanToInt(lm[1]);
       if(!tableItemsByLesson[currentLessonNo]) tableItemsByLesson[currentLessonNo]=[];
       continue;
     }

     if(currentLessonNo!==null){
       const im=raw.match(/^(\d+(?:\.\d+)*)\.?\s+(.+)$/);
       if(im){
         const key=exactKey(raw);
         if(!tableItemsByLesson[currentLessonNo].some(x=&gt;exactKey(x[1])===key)){
           const depth=(im[1].match(/\./g)||[]).length;
           tableItemsByLesson[currentLessonNo].push([depth&gt;=1?&quot;sub&quot;:&quot;major&quot;, raw]);
         }
       }
     }
   }
 }

 for(const row of rows){
   const cells=[...row.querySelectorAll(&quot;td,th&quot;)];
   if(cells.length&lt;2) continue;

   const lines=getExactCellLines(cells[1]);
   const name=lines[0] || (cells[1].textContent||&quot;&quot;).trim();

   const lm=name.match(/^(?:Bài|Chương|Phần)\s*(\d+|[IVXLCDM]+)[\.\:\-\s]\s*(.+)$/i);
   if(lm){
     const no=romanToInt(lm[1]);
     if(seenLessons.has(no)) continue;
     seenLessons.add(no);

     const ltHours=cellNumber(cells[3]);
     const thHours=cellNumber(cells[4]);

     // Tên bài lưu nguyên văn từ nguồn.
     const title=name.trim();

     const mergedItems=[];
     const allSources=[
       ...((detailMap[no]&amp;&amp;detailMap[no].items)||[]),
       ...(tableItemsByLesson[no]||[])
     ];

     for(const it of allSources){
       if(!it || !it[1]) continue;
       const key=exactKey(it[1]);
       if(!mergedItems.some(x=&gt;exactKey(x[1])===key)){
         mergedItems.push([it[0], it[1]]); // lưu nguyên văn
       }
     }

           sequence.push({
        kind:&quot;lesson&quot;,
        no,
        title,
        ltHours,
        thHours,
        ltPeriods:Math.ceil(ltHours),
        thPeriods:Math.ceil(thHours*60/45),
        items:mergedItems,
        itemCount:mergedItems.length,
        objectives: (detailMap[no] &amp;&amp; detailMap[no].objectives) || [],
        objectivesText: (detailMap[no] &amp;&amp; detailMap[no].objectivesText) || &quot;&quot;
      });
     continue;
   }

   if(/^(Bài tập|Bài tập tổng hợp)/i.test(name)){
      const rawLt=cellNumber(cells[3]);
      const rawTh=cellNumber(cells[4]);
      const rawTotal=cellNumber(cells[2]);
      const totalToConvert = rawTotal || (rawLt + rawTh);
      sequence.push({
        kind:&quot;lesson&quot;,
        no: 9999 + sequence.length,
        title: name.trim(),
        ltHours: 0,
        thHours: totalToConvert,
        ltPeriods: 0,
        thPeriods: Math.ceil(totalToConvert*60/45),
        items: [],
        itemCount: 0
      });
      continue;
    }
    
    if(/^(Kiểm tra|Thi)/i.test(name)){
     if(/^Thi\s+kết\s+thúc\s+môn/i.test(name)) continue;

     const ktLt=cellNumber(cells[5]);
     const ktTh=cellNumber(cells[6]);
     const thiLt=cellNumber(cells[7]);
     const thiTh=cellNumber(cells[8]);

     const hoursLT=ktLt+thiLt;
     const hoursTH=ktTh+thiTh;
     const rawHours=(hoursLT+hoursTH) || cellNumber(cells[2]) || 1;
     const isTheory = hoursLT > 0 || (hoursTH === 0 && (ktLt > 0 || cellNumber(cells[3]) > 0));

     if(isTheory){
       sequence.push({
         kind:&quot;assessment&quot;,
         title:name.trim(),
         rawHours,
         assessmentType:&quot;Lý thuyết&quot;,
         periodsLT:0,
         periodsKT:rawHours,
         periodsTH:0,
         periods:rawHours
       });
     } else {
       const autoPeriods=Math.ceil(rawHours*60/45);
       sequence.push({
         kind:&quot;assessment&quot;,
         title:name.trim(),
         rawHours,
         assessmentType:&quot;Thực hành&quot;,
         periodsLT:0,
         periodsKT:1,
         periodsTH:Math.max(0,autoPeriods-1),
         periods:autoPeriods
       });
     }
   }
 }

 return sequence;
}

function recalcAssessments(){
 programSequence.forEach(x=&gt;{
   if(x.kind!==&quot;assessment&quot;) return;
   if(x.assessmentType === &quot;Lý thuyết&quot;){
     x.periodsKT=Number(x.rawHours)||1;
     x.periodsTH=0;
     x.periodsLT=0;
     x.periods=x.periodsKT;
   } else {
     const converted=Math.ceil(x.rawHours*60/45);
     x.assessmentType=&quot;Thực hành&quot;;
     x.periodsKT=converted&gt;0 ? 1 : 0;
     x.periodsTH=Math.max(0,converted-x.periodsKT);
     x.periodsLT=0;
     x.periods=converted;
   }
 });
}

