  &lt;button type=&quot;button&quot; onclick=&quot;updateScheduleProgression()&quot; style=&quot;background:#16469d;color:#fff;padding:6px 12px;font-size:12px;display:inline-flex;align-items:center;gap:5px;border-radius:6px;&quot; title=&quot;Tự động tính lại nội dung và tiến độ các buổi sau khi chỉnh số tiết&quot;&gt;🔄 CẬP NHẬT LẠI TIẾN ĐỘ&lt;/button&gt;
