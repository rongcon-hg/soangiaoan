        ? `&lt;br&gt;&lt;span style=&quot;color:#b45309&quot;&gt;&lt;b&gt;Cảnh báo:&lt;/b&gt; ${missingLessons.length} Bài/Chương/Phần chưa nhận diện được đề mục; cần kiểm tra file gốc.&lt;/span&gt;`
        : `&lt;br&gt;&lt;span style=&quot;color:#166534&quot;&gt;&lt;b&gt;Đã kiểm tra:&lt;/b&gt; tất cả Bài/Chương/Phần đều có dữ liệu đề mục nhận diện được · Tổng ${totalDetectedItems} đề mục.&lt;/span&gt;`);
   }else{
