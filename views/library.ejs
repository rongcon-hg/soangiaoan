<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Thư viện Giáo án - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .filter-container {
            display: flex;
            gap: 15px;
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .filter-group {
            flex: 1;
            min-width: 250px;
        }
        .search-box {
            position: relative;
            width: 100%;
        }
        .search-icon {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #94a3b8;
        }
        .search-input {
            width: 100%;
            padding: 10px 15px 10px 35px;
            border: 1px solid var(--border);
            border-radius: 6px;
            outline: none;
            box-sizing: border-box;
            transition: border-color 0.2s;
        }
        .search-input:focus {
            border-color: var(--primary);
        }
        .table th, .table td {
            vertical-align: middle;
        }
        .action-buttons {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .btn-action {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
            padding: 6px 12px;
            font-weight: 500;
            white-space: nowrap;
        }
    
        .my-modal {
            display: none; 
            position: fixed; 
            z-index: 1000; 
            left: 0; 
            top: 0; 
            width: 100%; 
            height: 100%; 
            background-color: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
        }
        .my-modal-content {
            background-color: #fff;
            margin: 2% auto;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            width: 95%;
            max-width: 1200px;
            height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .my-modal-header {
            padding: 15px 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .my-modal-close {
            font-size: 1.5rem;
            cursor: pointer;
            color: #64748b;
        }
        .my-modal-close:hover { color: #dc2626; }

    
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: #fff;
        }
        .table-responsive table {
            width: 100%;
            min-width: 800px;
            border-collapse: collapse;
        }
        .table-responsive th, .table-responsive td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
            vertical-align: middle;
        }
        .table-responsive th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #475569;
            white-space: nowrap;
        }
        .table-responsive tbody tr:hover {
            background-color: #f1f5f9;
        }
        .action-btn-group {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .btn-sm { padding: 5px 10px; font-size: 13px; }
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
            flex-wrap: wrap;
            gap: 10px;
        }
        .page-btn {
            padding: 6px 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #475569;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.9rem;
        }
        .page-btn:hover:not(:disabled) {
            background: #f1f5f9;
        }
        .page-btn.active {
            background: #16469d;
            color: #fff;
            border-color: #16469d;
        }
        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>
</head>
<body>
    <div id="alert-box"></div>

    <div class="card">
        <h2 style="margin-top:0; color:var(--primary);"><i class="fas fa-book-open"></i> Thư viện Giáo án Cộng đồng</h2>
        <p style="color:#64748b; margin-bottom:20px;">Khám phá và tham khảo các giáo án chất lượng từ đồng nghiệp chia sẻ.</p>

        <div class="filter-container">
            <div class="filter-group">
                <div class="search-box">
                    <i class="fas fa-search search-icon"></i>
                    <input type="text" id="search-input" class="search-input" placeholder="Tìm kiếm theo tên môn học, người soạn hoặc đơn vị..." oninput="filterLibrary()">
                </div>
            </div>
        </div>

        <div class="table-responsive">
            <table class="table" style="width:100%;">
                <thead>
                    <tr>
                        <th style="width: 5%; text-align:center;">STT</th>
                        <th style="width: 15%;">Môn học</th>
                        <th style="width: 10%;">Bài số</th>
                        <th style="width: 10%;">Loại Giáo án</th>
                        <th style="width: 20%;">Tác giả</th>
                        <th style="width: 25%;">Đơn vị</th>
                        <th style="width: 10%;">Cập nhật</th>
                        <th class="sticky-action" style="width: 15%; text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="library-list">
                    <tr><td colspan="8" style="text-align:center; padding: 40px; color:#64748b;"><i class="fas fa-spinner fa-spin fa-2x"></i><br><br>Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-container" id="pagination-container" style="display:none;">
            <div style="font-size: 0.9rem; color: #64748b;" id="pagination-info"></div>
            <div style="display: flex; gap: 5px;" id="pagination-controls"></div>
        </div>
    </div>


    <!-- Preview Modal -->
    <div id="preview-modal" class="my-modal">
        <div class="my-modal-content">
            <div class="my-modal-header">
                <h2 style="margin:0; font-size:1.25rem; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-file-pdf" style="color:#ef4444;"></i> Xem trước Giáo án (Thư viện)
                </h2>
                <span class="my-modal-close" onclick="closePreviewModal()"><i class="fas fa-times"></i></span>
            </div>
            <div style="flex:1; display:flex; overflow:hidden;">
                <!-- Left: Preview Frame -->
                <div style="flex:1; background:#cbd5e1; overflow-y:auto; display:flex; justify-content:center; padding:20px; position:relative;">
                    <div id="preview-loading" style="display:none; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);">
                        <i class="fas fa-spinner fa-spin fa-2x" style="color:var(--primary);"></i>
                    </div>
                    <iframe id="preview-frame" style="width:210mm; min-height:297mm; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.1); border:none;"></iframe>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('library', 'Thư viện Giáo án');
        
        let allLessons = [];
        let currentFilteredLessons = [];
        let currentPage = 1;
        const itemsPerPage = 10;

        
        window.addEventListener('DOMContentLoaded', () => {
            checkAuth(true).then(user => {
                if(user) {
                    currentUser = user;
                    loadLibrary();
                }
            });
        });

        async function loadLibrary() {
            try {
                const res = await fetch(API_URL + '/library', { headers: getHeaders() });
                if (!res.ok) throw new Error('Không thể tải thư viện');
                allLessons = await res.json();
                filterLibrary();
            } catch(e) {
                document.getElementById('library-list').innerHTML = `
                    <tr><td colspan="8" style="text-align:center; padding: 40px; color:var(--danger);">
                        <i class="fas fa-exclamation-triangle fa-2x"></i><br><br>${e.message}
                    </td></tr>
                `;
            }
        }

        function filterLibrary() {
            const keyword = document.getElementById('search-input').value.toLowerCase();
            currentFilteredLessons = allLessons.filter(l => {
                const projectName = (l.project_name || '').toLowerCase();
                const authorName = (l.author_name || l.username || '').toLowerCase();
                const deptName = (l.department_name || '').toLowerCase();
                return projectName.includes(keyword) || authorName.includes(keyword) || deptName.includes(keyword);
            });
            currentPage = 1;
            renderPage();
        }

        function renderPage() {
            const tbody = document.getElementById('library-list');
            const paginationContainer = document.getElementById('pagination-container');
            const paginationInfo = document.getElementById('pagination-info');
            
            if (currentFilteredLessons.length === 0) {
                tbody.innerHTML = `
                    <tr><td colspan="8" style="text-align:center; padding: 40px; color:#64748b;">
                        <i class="fas fa-search fa-2x" style="color:#cbd5e1; margin-bottom:10px;"></i><br>
                        Không tìm thấy giáo án nào phù hợp.
                    </td></tr>
                `;
                paginationContainer.style.display = 'none';
                return;
            }

            const totalPages = Math.ceil(currentFilteredLessons.length / itemsPerPage);
            if (currentPage < 1) currentPage = 1;
            if (currentPage > totalPages) currentPage = totalPages;

            const startIndex = (currentPage - 1) * itemsPerPage;
            const endIndex = Math.min(startIndex + itemsPerPage, currentFilteredLessons.length);
            const pageData = currentFilteredLessons.slice(startIndex, endIndex);

            let html = '';
            pageData.forEach((l, index) => {
                const authorStr = escapeHtml(l.author_name || l.username);
                const dateStr = new Date(l.updated_at).toLocaleDateString('vi-VN');
                

                let gaTypeStyle = 'background:#f1f5f9; color:#475569;';
                if (l.ga_type === 'Lý thuyết') gaTypeStyle = 'background:#dbeafe; color:#1d4ed8;';
                else if (l.ga_type === 'Thực hành') gaTypeStyle = 'background:#dcfce3; color:#15803d;';
                else if (l.ga_type === 'Tích hợp') gaTypeStyle = 'background:#f3e8ff; color:#7e22ce;';

                html += `
                    <tr>
                        <td style="text-align:center; font-weight:bold; color:#64748b;">${startIndex + index + 1}</td>
                        <td>
                            <b>${escapeHtml(l.project_name)}</b><br>
                            <span style="font-size:12px; color:#64748b;"><i class="fas fa-layer-group"></i> Hệ: ${escapeHtml(l.system_type || 'Chưa rõ')}</span>
                        </td>
                        <td>Bài ${l.schedule_tt}</td>
                        <td>
                            <span style="font-size:0.82rem; font-weight:600; padding:4px 8px; border-radius:12px; white-space:nowrap; ${gaTypeStyle}">${escapeHtml(l.ga_type || 'Chưa rõ')}</span>
                        </td>
                        <td><b>${authorStr}</b></td>
                        <td><span style="font-size:13px; color:#64748b;">${escapeHtml(l.department_name || 'Chưa rõ đơn vị')}</span></td>
                        <td>${dateStr}</td>
                        <td class="sticky-action" style="text-align:right; white-space:nowrap;">
                            <div class="action-buttons">
                                <button onclick="openPreviewModal('${l.project_id}', '${l.schedule_tt}')" class="btn primary btn-action btn-sm" title="Xem trước"><i class="fas fa-eye"></i></button>
                                <button onclick="downloadPdf('${l.project_id}', '${l.schedule_tt}')" class="btn primary btn-action btn-sm" title="Tải file PDF về máy"><i class="fas fa-download"></i></button>
                                ${currentUser && (currentUser.username === l.username || currentUser.role === 'Admin') ? `<button onclick="unshareLesson('${l.project_id}', '${l.schedule_tt}')" class="btn primary btn-action btn-sm" title="Gỡ giáo án khỏi thư viện"><i class="fas fa-unlink"></i></button>` : ''}
                            </div>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;

            if (totalPages > 1) {
                paginationInfo.textContent = `Đang xem ${startIndex + 1} - ${endIndex} trong tổng số ${currentFilteredLessons.length} giáo án`;
                renderPaginationControls(totalPages);
                paginationContainer.style.display = 'flex';
            } else {
                paginationContainer.style.display = 'none';
            }
        }

        function renderPaginationControls(totalPages) {
            const controls = document.getElementById('pagination-controls');
            let html = '';

            html += `<button class="page-btn" onclick="goToPage(1)" ${currentPage === 1 ? 'disabled' : ''}><i class="fas fa-angle-double-left"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}><i class="fas fa-angle-left"></i></button>`;

            let delta = 2;
            let lastPage = 0;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
                    if (lastPage && i - lastPage > 1) {
                        html += `<span style="padding: 0 4px; color: #94a3b8;">...</span>`;
                    }
                    html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
                    lastPage = i;
                }
            }

            html += `<button class="page-btn" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}><i class="fas fa-angle-right"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${totalPages})" ${currentPage === totalPages ? 'disabled' : ''}><i class="fas fa-angle-double-right"></i></button>`;

            controls.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            renderPage();
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }

        function downloadPdf(projectId, tt) {
            const item = allLessons.find(x => x.project_id == projectId && x.schedule_tt == tt);
            if (!item || !item.pdf_link) {
                showAlert('Tác giả chưa tạo hoặc chưa đồng bộ file PDF cho giáo án này.', 'error');
                return;
            }
            
            // Extract Google Drive ID and force download
            const match = item.pdf_link.match(/\/d\/([a-zA-Z0-9_-]+)/);
            if (match && match[1]) {
                const fileId = match[1];
                const downloadUrl = `https://drive.google.com/uc?export=download&id=${fileId}`;
                window.open(downloadUrl, '_blank');
            } else {
                // Fallback to open the link directly
                window.open(item.pdf_link, '_blank');
            }
        }

        async function unshareLesson(projectId, tt) {
            if (!(await customConfirm('Bạn có chắc chắn muốn hủy chia sẻ giáo án này khỏi Thư viện chung?'))) return;
            try {
                Swal.fire({
                    title: 'Đang xử lý...',
                    allowOutsideClick: false,
                    didOpen: () => { Swal.showLoading(); }
                });
                
                const res = await fetch(API_URL + '/library/toggle', { 
                    method: 'POST', 
                    headers: getHeaders(),
                    body: JSON.stringify({ project_id: projectId, schedule_tt: tt, is_public: false })
                });
                const data = await res.json();
                if (!res.ok) throw new Error(data.message || data.error);
                
                Swal.fire({ text: 'Đã gỡ giáo án khỏi Thư viện.', icon: 'success' });
                // Reload list
                loadLibrary();
            } catch(e) {
                showAlert(e.message, 'error');
            }
        }


        async function openPreviewModal(projectId, tt) {
            document.getElementById('preview-modal').style.display = 'block';
            const iframe = document.getElementById('preview-frame');
            const loader = document.getElementById('preview-loading');
            iframe.removeAttribute('srcdoc');
            iframe.removeAttribute('src');
            loader.style.display = 'block';
            
            try {
                // Find lesson to see if it has a pdf_link
                const item = allLessons.find(x => x.project_id == projectId && x.schedule_tt == tt);
                if (item && item.pdf_link) {
                    let previewUrl = item.pdf_link;
                    if (previewUrl.includes('/view')) {
                        previewUrl = previewUrl.replace('/view', '/preview');
                    }
                    iframe.src = previewUrl;
                    loader.style.display = 'none';
                    return;
                }

                const res = await fetch(API_URL + `/lessons/${projectId}/lessons/${tt}`, { headers: getHeaders() });
                if(res.ok) {
                    const data = await res.json();
                    if(data && data.lesson_data) {
                        const style = `<style>
                            body { font-family: 'Times New Roman', serif; margin:0; padding: 20mm; background: #fff; line-height: 1.5; font-size: 14pt; }
                            table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
                            th, td { border: 1px solid #000; padding: 8px; text-align: left; }
                            h1, h2, h3 { text-align: center; }
                        
        .table-responsive {
            width: 100%;
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            background: #fff;
        }
        .table-responsive table {
            width: 100%;
            min-width: 800px;
            border-collapse: collapse;
        }
        .table-responsive th, .table-responsive td {
            padding: 14px 16px;
            border-bottom: 1px solid #e2e8f0;
            text-align: left;
            vertical-align: middle;
        }
        .table-responsive th {
            background-color: #f8fafc;
            font-weight: 600;
            color: #475569;
            white-space: nowrap;
        }
        .table-responsive tbody tr:hover {
            background-color: #f1f5f9;
        }
        .action-btn-group {
            display: flex;
            gap: 8px;
            justify-content: flex-end;
        }
        .btn-sm { padding: 5px 10px; font-size: 13px; }
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid #e2e8f0;
            flex-wrap: wrap;
            gap: 10px;
        }
        .page-btn {
            padding: 6px 12px;
            border: 1px solid #e2e8f0;
            background: #fff;
            color: #475569;
            border-radius: 4px;
            cursor: pointer;
            transition: all 0.2s;
            font-size: 0.9rem;
        }
        .page-btn:hover:not(:disabled) {
            background: #f1f5f9;
        }
        .page-btn.active {
            background: #16469d;
            color: #fff;
            border-color: #16469d;
        }
        .page-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }
    </style>`;
                        iframe.srcdoc = style + data.lesson_data;
                    } else {
                        iframe.srcdoc = '<div style="padding:20px; color:red; font-family:sans-serif;">Không có dữ liệu giáo án (Bản nháp trống).</div>';
                    }
                } else {
                    throw new Error('Lỗi truy xuất từ máy chủ');
                }
            } catch(e) {
                iframe.srcdoc = `<div style="padding:20px; color:red; font-family:sans-serif;">Lỗi tải giáo án: ${e.message}</div>`;
            } finally {
                loader.style.display = 'none';
            }
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').style.display = 'none';
            const iframe = document.getElementById('preview-frame');
            iframe.removeAttribute('srcdoc');
            iframe.removeAttribute('src');
        }

        function escapeHtml(s) { return (s || '').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
    </script>
</body>
</html>