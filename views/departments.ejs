<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Đơn vị - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div id="alert-box"></div>

    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h3 style="margin:0; color:var(--primary);"><i class="fas fa-building"></i> Danh mục Đơn vị / Khoa</h3>
            <button class="btn btn-primary" onclick="openDeptModal()"><i class="fas fa-plus"></i> Thêm Đơn vị</button>
        </div>

        <div style="overflow-x:auto;">
            <table class="table" style="width:100%;">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Tên đơn vị</th>
                        <th>Ngày tạo</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="dept-list">
                    <tr><td colspan="4" style="text-align:center;">Đang tải...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Modal -->
    <div id="dept-modal" class="modal">
        <div class="modal-content" style="max-width:400px;">
            <div class="modal-header">
                <h2 id="modal-title">Thêm Đơn vị mới</h2>
                <span class="close" onclick="closeDeptModal()">&times;</span>
            </div>
            <div class="modal-body">
                <form id="deptForm" onsubmit="saveDept(event)">
                    <input type="hidden" id="dept-id">
                    <div class="form-group">
                        <label>Tên đơn vị/Khoa <span style="color:red">*</span></label>
                        <input type="text" id="dept-name" class="form-control" required placeholder="VD: Khoa Công nghệ thông tin">
                    </div>
                    <button type="submit" class="btn btn-primary" style="width:100%;">Lưu dữ liệu</button>
                </form>
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('departments', 'Quản lý Đơn vị');
        
        window.addEventListener('DOMContentLoaded', () => {
            checkAuth(true).then(user => {
                if(user && user.role !== 'Admin') window.location.href = '/dashboard';
                else loadDepts();
            });
        });

        async function loadDepts() {
            try {
                const res = await fetch(API_URL + '/departments', { headers: getHeaders() });
                const data = await res.json();
                const tbody = document.getElementById('dept-list');
                
                if(data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center;">Chưa có đơn vị nào.</td></tr>';
                    return;
                }

                let html = '';
                data.forEach(d => {
                    html += `
                        <tr>
                            <td>${d.id}</td>
                            <td><b>${escapeHtml(d.name)}</b></td>
                            <td>${new Date(d.created_at).toLocaleDateString('vi-VN')}</td>
                            <td style="text-align:right;">
                                <button class="btn btn-secondary btn-sm" onclick="editDept(${d.id}, '${escapeHtml(d.name.replace(/'/g, "\\'"))}')"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-secondary btn-sm" style="color:red;" onclick="deleteDept(${d.id})"><i class="fas fa-trash"></i></button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch(e) {
                showAlert('Lỗi tải dữ liệu', 'error');
            }
        }

        function openDeptModal() {
            document.getElementById('modal-title').textContent = 'Thêm Đơn vị mới';
            document.getElementById('deptForm').reset();
            document.getElementById('dept-id').value = '';
            document.getElementById('dept-modal').style.display = 'block';
        }

        function closeDeptModal() { document.getElementById('dept-modal').style.display = 'none'; }

        function editDept(id, name) {
            document.getElementById('modal-title').textContent = 'Sửa Đơn vị';
            document.getElementById('dept-id').value = id;
            document.getElementById('dept-name').value = name;
            document.getElementById('dept-modal').style.display = 'block';
        }

        async function saveDept(e) {
            e.preventDefault();
            const id = document.getElementById('dept-id').value;
            const name = document.getElementById('dept-name').value;
            const method = id ? 'PUT' : 'POST';
            const url = id ? '/departments/' + id : '/departments';

            try {
                const res = await fetch(API_URL + url, {
                    method,
                    headers: getHeaders(),
                    body: JSON.stringify({ name })
                });
                const data = await res.json();
                if(!res.ok) throw new Error(data.message || data.error);
                
                showAlert('Đã lưu thành công!', 'success');
                closeDeptModal();
                loadDepts();
            } catch(err) {
                showAlert(err.message, 'error');
            }
        }

        async function deleteDept(id) {
            if(!confirm('Bạn có chắc muốn xoá đơn vị này? Các tài khoản thuộc đơn vị sẽ bị trống thông tin phòng ban.')) return;
            try {
                const res = await fetch(API_URL + '/departments/' + id, { method: 'DELETE', headers: getHeaders() });
                if(!res.ok) throw new Error('Lỗi xoá dữ liệu');
                showAlert('Đã xoá đơn vị', 'success');
                loadDepts();
            } catch(err) { showAlert(err.message, 'error'); }
        }

        function escapeHtml(s) { return (s||'').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
    </script>
</body>
</html>
