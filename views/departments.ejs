<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Đơn vị - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .layout-grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 20px;
        }
        @media (min-width: 992px) {
            .layout-grid {
                grid-template-columns: 350px 1fr;
            }
        }
    </style>
</head>
<body>
    <div id="alert-box"></div>

    <div class="layout-grid">
        <!-- Form thêm/sửa -->
        <div class="card" style="height: fit-content;">
            <h3 id="form-title" style="margin-top:0; color:var(--primary);"><i class="fas fa-plus-circle"></i> Thêm Đơn vị mới</h3>
            <hr style="border:none; border-top:1px solid #e2e8f0; margin: 15px 0;">
            <form id="deptForm" onsubmit="saveDept(event)">
                <input type="hidden" id="dept-id">
                <div class="form-group">
                    <label>Tên Đơn vị/Khoa <span style="color:red">*</span></label>
                    <input type="text" id="dept-name" class="form-control" required placeholder="VD: Khoa Công nghệ thông tin">
                </div>
                <div style="display:flex; gap:10px;">
                    <button type="submit" class="btn btn-primary" style="flex:1;"><i class="fas fa-save"></i> Lưu dữ liệu</button>
                    <button type="button" class="btn btn-secondary" onclick="resetForm()" id="btn-cancel" style="display:none;"><i class="fas fa-times"></i> Hủy</button>
                </div>
            </form>
        </div>

        <!-- Danh sách -->
        <div class="card">
            <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
                <h3 style="margin:0; color:var(--primary);"><i class="fas fa-building"></i> Danh mục Đơn vị / Khoa</h3>
            </div>
            <div style="overflow-x:auto;">
                <table class="table" style="width:100%;">
                    <thead>
                        <tr>
                            <th style="width:50px;">ID</th>
                            <th>Tên đơn vị</th>
                            <th>Ngày tạo</th>
                            <th style="text-align:right; width:120px;">Thao tác</th>
                        </tr>
                    </thead>
                    <tbody id="dept-list">
                        <tr><td colspan="4" style="text-align:center; padding: 20px; color:#64748b;">Đang tải dữ liệu...</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('departments', 'Quản lý Đơn vị');
        
        window.addEventListener('DOMContentLoaded', () => {
            checkAuth(true).then(user => {
                if(user && user.role !== 'Admin') window.location.href = '/dashboard';
                else loadDepts();
            });
        });

        async function loadDepts() {
            try {
                const res = await fetch(API_URL + '/departments', { headers: getHeaders() });
                const data = await res.json();
                const tbody = document.getElementById('dept-list');
                
                if(data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="4" style="text-align:center; padding: 20px; color:#64748b;">Chưa có đơn vị nào. Hãy tạo đơn vị đầu tiên!</td></tr>';
                    return;
                }

                let html = '';
                data.forEach(d => {
                    html += `
                        <tr>
                            <td style="color:#64748b;">#${d.id}</td>
                            <td><b style="color:#334155;">${escapeHtml(d.name)}</b></td>
                            <td style="color:#64748b;">${new Date(d.created_at).toLocaleDateString('vi-VN')}</td>
                            <td style="text-align:right; white-space:nowrap;">
                                <button class="btn btn-secondary btn-sm" onclick="editDept(${d.id}, '${escapeHtml(d.name.replace(/'/g, "\\'"))}')" title="Sửa"><i class="fas fa-edit"></i></button>
                                <button class="btn btn-secondary btn-sm" style="color:var(--danger);" onclick="deleteDept(${d.id})" title="Xoá"><i class="fas fa-trash-alt"></i></button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch(e) {
                showAlert('Lỗi tải dữ liệu', 'error');
            }
        }

        function resetForm() {
            document.getElementById('form-title').innerHTML = '<i class="fas fa-plus-circle"></i> Thêm Đơn vị mới';
            document.getElementById('deptForm').reset();
            document.getElementById('dept-id').value = '';
            document.getElementById('btn-cancel').style.display = 'none';
        }

        function editDept(id, name) {
            document.getElementById('form-title').innerHTML = '<i class="fas fa-edit"></i> Cập nhật Đơn vị';
            document.getElementById('dept-id').value = id;
            document.getElementById('dept-name').value = name;
            document.getElementById('btn-cancel').style.display = 'block';
            document.getElementById('dept-name').focus();
        }

        async function saveDept(e) {
            e.preventDefault();
            const id = document.getElementById('dept-id').value;
            const name = document.getElementById('dept-name').value;
            const method = id ? 'PUT' : 'POST';
            const url = id ? '/departments/' + id : '/departments';

            try {
                const res = await fetch(API_URL + url, {
                    method,
                    headers: getHeaders(),
                    body: JSON.stringify({ name })
                });
                const data = await res.json();
                if(!res.ok) throw new Error(data.message || data.error);
                
                showAlert('Đã lưu thành công!', 'success');
                resetForm();
                loadDepts();
            } catch(err) {
                showAlert(err.message, 'error');
            }
        }

        async function deleteDept(id) {
            if(!confirm('Bạn có chắc muốn xoá đơn vị này? Các tài khoản thuộc đơn vị sẽ bị trống thông tin phòng ban.')) return;
            try {
                const res = await fetch(API_URL + '/departments/' + id, { method: 'DELETE', headers: getHeaders() });
                if(!res.ok) throw new Error('Lỗi xoá dữ liệu');
                showAlert('Đã xoá đơn vị', 'success');
                loadDepts();
            } catch(err) { showAlert(err.message, 'error'); }
        }

        function escapeHtml(s) { return (s||'').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
    </script>
</body>
</html>
