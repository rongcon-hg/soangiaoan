<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Môn học - Hệ thống Giáo án</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&display=swap" rel="stylesheet">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>.swal2-popup { font-family: 'Be Vietnam Pro', sans-serif !important; }</style>
<script>
window._originalAlert = window.alert;
window.alert = function(msg) {
    if(typeof Swal !== 'undefined') {
        Swal.fire({ text: msg, icon: 'info', confirmButtonColor: '#16469d' });
    } else {
        window._originalAlert(msg);
    }
};
window.customConfirm = async function(msg) {
    if(typeof Swal === 'undefined') return window.confirm(msg);
    const result = await Swal.fire({
        text: msg,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#16469d',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
    });
    return result.isConfirmed;
};
</script>

</head>
<body>
    <style>
        .page-btn {
            padding: 4px 10px;
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text);
            border-radius: 6px;
            cursor: pointer;
            font-weight: 600;
            font-size: 0.82rem;
            transition: all 0.2s;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-width: 32px;
            height: 32px;
        }
        .page-btn:hover:not(:disabled) {
            background: #f1f5f9;
            border-color: var(--primary);
            color: var(--primary);
        }
        .page-btn.active {
            background: var(--primary);
            color: #fff;
            border-color: var(--primary);
        }
        .page-btn:disabled {
            opacity: 0.35;
            cursor: not-allowed;
        }
        .class-option-item {
            padding: 6px 10px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 0.82rem;
            color: var(--text);
            display: flex;
            align-items: center;
            justify-content: space-between;
            transition: background 0.15s;
        }
        .class-option-item:hover {
            background: #f1f5f9;
            color: var(--primary);
        }
        .class-option-item.selected {
            background: #eff6ff;
            color: var(--primary);
            font-weight: 700;
        }
        .btn-sm {
            height: 34px;
            padding: 0 12px;
            font-size: 0.82rem;
            border-radius: 6px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }
        .btn-icon-only {
            width: 34px;
            padding: 0;
        }
        .filter-control {
            height: 36px;
            font-size: 0.83rem;
            border-radius: 6px;
            border: 1px solid var(--border);
            background: #fff;
            color: var(--text);
            outline: none;
            transition: border-color 0.2s;
        }
        .filter-control:focus {
            border-color: var(--primary);
        }

        /* Responsive rules */
        .btn-text-full { display: inline; }
        .btn-text-mobile { display: none; }

        @media (max-width: 768px) {
            .card { padding: 14px; }
            .card-title { font-size: 0.95rem; }
            .btn-text-full { display: none; }
            .btn-text-mobile { display: inline; }
            .filter-toolbar { padding: 10px; gap: 8px; }
            .filter-subgroup { width: 100%; display: grid; grid-template-columns: 1fr 1fr; gap: 6px; }
            .grid-cols-2 { grid-template-columns: 1fr; gap: 12px; }
            .project-card { padding: 12px; }
            .project-title { font-size: 0.95rem; }
            .project-meta { font-size: 0.78rem; margin-bottom: 12px; }
        }
    </style>

    <div class="card" id="main-card">
        <div class="card-header" style="margin-bottom:14px; padding-bottom:12px;">
            <h3 class="card-title" style="margin:0;"><i class="fas fa-book-open" style="color:var(--primary); margin-right:6px;"></i> Danh sách Môn học / Lịch giảng</h3>
            <button class="btn btn-primary btn-sm" onclick="openNewProjectForm()" title="Thêm Môn học"><i class="fas fa-plus"></i> <span class="btn-text-full">Thêm Môn học</span><span class="btn-text-mobile">Thêm</span></button>
        </div>
        
        <div id="new-project-form" style="display:none; background:#f8fafc; padding:14px; border-radius:8px; margin-bottom:16px; border:1px solid var(--border)">
            <h4 style="font-size:0.95rem; margin-bottom:10px;"><i class="fas fa-folder-plus"></i> Thêm Môn học mới</h4>
            <div class="grid grid-cols-2">
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Tên Môn học</label>
                    <input type="text" id="project-name" class="form-control filter-control" placeholder="VD: Lập trình Web">
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Mã môn học</label>
                    <input type="text" id="project-code" class="form-control filter-control" placeholder="VD: IT101">
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Hệ đào tạo</label>
                    <select id="project-system" class="form-control filter-control" style="background:#fff;">
                        <option value="Trung cấp" selected>Trung cấp</option>
                        <option value="Cao đẳng">Cao đẳng</option>
                    </select>
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Lớp học</label>
                    <input type="text" id="project-class" class="form-control filter-control" placeholder="VD: CD-CNTT22A hoặc TC-TH23">
                </div>
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Tổng số giờ</label>
                    <input type="number" id="project-hours" class="form-control filter-control" value="30">
                </div>
            </div>
            <div style="margin-top:10px; display:flex; gap:8px;">
                <button class="btn btn-primary btn-sm" onclick="createProject()"><i class="fas fa-save"></i> Lưu</button>
                <button class="btn btn-secondary btn-sm" onclick="closeNewProjectForm()">Hủy</button>
            </div>
        </div>

        <!-- Modal Chỉnh sửa Môn học -->
        <div id="edit-project-modal" style="display:none; position:fixed; top:0; left:0; right:0; bottom:0; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center; padding:15px;">
            <div style="background:#fff; border-radius:12px; max-width:550px; width:100%; padding:20px; box-shadow:0 10px 25px rgba(0,0,0,0.2);">
                <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:14px; border-bottom:1px solid var(--border); padding-bottom:10px;">
                    <h3 style="margin:0; font-size:1.05rem; color:var(--primary);"><i class="fas fa-edit"></i> Chỉnh sửa thông tin Môn học</h3>
                    <button type="button" onclick="closeEditModal()" style="background:none; border:none; font-size:1.2rem; cursor:pointer; color:#64748b;">&times;</button>
                </div>
                <input type="hidden" id="edit-project-id">
                <div class="form-group" style="margin-bottom:10px;">
                    <label style="font-size:0.82rem;">Tên Môn học</label>
                    <input type="text" id="edit-project-name" class="form-control filter-control">
                </div>
                <div class="grid grid-cols-2">
                    <div class="form-group" style="margin-bottom:10px;">
                        <label style="font-size:0.82rem;">Mã môn học</label>
                        <input type="text" id="edit-project-code" class="form-control filter-control">
                    </div>
                    <div class="form-group" style="margin-bottom:10px;">
                        <label style="font-size:0.82rem;">Tổng số giờ</label>
                        <input type="number" id="edit-project-hours" class="form-control filter-control">
                    </div>
                </div>
                <div class="grid grid-cols-2">
                    <div class="form-group" style="margin-bottom:10px;">
                        <label style="font-size:0.82rem;">Hệ đào tạo</label>
                        <select id="edit-project-system" class="form-control filter-control" style="background:#fff;">
                            <option value="Trung cấp">Trung cấp</option>
                            <option value="Cao đẳng">Cao đẳng</option>
                        </select>
                    </div>
                    <div class="form-group" style="margin-bottom:10px;">
                        <label style="font-size:0.82rem;">Lớp học</label>
                        <input type="text" id="edit-project-class" class="form-control filter-control" placeholder="VD: CD-CNTT22A">
                    </div>
                </div>
                <div style="display:flex; justify-content:flex-end; gap:8px; margin-top:16px;">
                    <button class="btn btn-secondary btn-sm" onclick="closeEditModal()">Hủy</button>
                    <button class="btn btn-primary btn-sm" onclick="saveEditProject()"><i class="fas fa-check"></i> Cập nhật</button>
                </div>
            </div>
        </div>

        <!-- Toolbar: Tìm kiếm thông minh & Bộ lọc Tối ưu -->
        <div class="filter-toolbar" style="background:#f8fafc; border:1px solid var(--border); border-radius:8px; padding:10px; margin-bottom:16px; display:flex; flex-direction:column; gap:8px;">
            <div style="display:flex; gap:8px; flex-wrap:wrap; align-items:center;">
                <!-- Ô tìm kiếm thông minh -->
                <div style="flex:1 1 200px; min-width:160px; position:relative;">
                    <i class="fas fa-search" style="position:absolute; left:10px; top:50%; transform:translateY(-50%); color:#94a3b8; font-size:0.8rem;"></i>
                    <input type="text" id="search-input" class="form-control filter-control" style="padding-left:30px; padding-right:26px;" placeholder="Tìm tên môn, mã, lớp..." oninput="handleSearchInput()">
                    <button type="button" id="btn-clear-search" onclick="clearSearch()" style="display:none; position:absolute; right:8px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; cursor:pointer; font-size:12px;" title="Xóa tìm kiếm">
                        <i class="fas fa-times-circle"></i>
                    </button>
                </div>

                <!-- Nhóm các bộ lọc combobox -->
                <div class="filter-subgroup" style="display:flex; gap:6px; flex-wrap:wrap; align-items:center; flex:1 1 auto;">
                    <!-- Bộ lọc Hệ đào tạo -->
                    <div style="flex:1 1 100px; min-width:95px;">
                        <select id="filter-system" class="form-control filter-control" style="padding:0 8px;" onchange="applyFilters()">
                            <option value="">-- Tất cả hệ --</option>
                            <option value="Trung cấp">Trung cấp</option>
                            <option value="Cao đẳng">Cao đẳng</option>
                        </select>
                    </div>

                    <!-- Bộ lọc Lớp học Thông minh (Searchable Combobox) -->
                    <div class="custom-select-wrapper" id="class-filter-wrapper" style="position:relative; flex:1 1 115px; min-width:105px;">
                        <div id="class-select-trigger" onclick="toggleClassDropdown(event)" class="filter-control" style="padding:0 22px 0 8px; display:flex; align-items:center; cursor:pointer; user-select:none;">
                            <span id="class-select-label" style="overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">-- Tất cả lớp --</span>
                            <i class="fas fa-chevron-down" style="position:absolute; right:7px; top:50%; transform:translateY(-50%); font-size:0.65rem; color:#94a3b8; pointer-events:none;"></i>
                        </div>

                        <!-- Dropdown Panel -->
                        <div id="class-dropdown-menu" style="display:none; position:absolute; top:calc(100% + 4px); left:0; right:0; min-width:190px; background:#fff; border:1px solid var(--border); border-radius:8px; box-shadow:0 8px 20px rgba(0,0,0,0.12); z-index:1000; padding:6px;">
                            <!-- Input tìm kiếm lớp -->
                            <div style="position:relative; margin-bottom:4px;">
                                <i class="fas fa-search" style="position:absolute; left:8px; top:50%; transform:translateY(-50%); font-size:0.75rem; color:#94a3b8;"></i>
                                <input type="text" id="class-search-input" class="form-control" style="height:30px; padding-left:24px; padding-right:22px; font-size:0.8rem;" placeholder="Tìm tên lớp..." oninput="handleClassSearch(this.value)" onclick="event.stopPropagation()">
                                <button type="button" id="btn-clear-class-search" onclick="clearClassSearch(event)" style="display:none; position:absolute; right:6px; top:50%; transform:translateY(-50%); background:none; border:none; color:#94a3b8; cursor:pointer; font-size:11px;" title="Xóa">
                                    <i class="fas fa-times-circle"></i>
                                </button>
                            </div>

                            <!-- Danh sách tùy chọn các lớp -->
                            <div id="class-options-list" style="overflow-y:auto; max-height:160px; display:flex; flex-direction:column; gap:2px;">
                                <!-- Items -->
                            </div>
                        </div>
                    </div>

                    <!-- Bộ lọc Sắp xếp -->
                    <div style="flex:1 1 100px; min-width:95px;">
                        <select id="filter-sort" class="form-control filter-control" style="padding:0 8px;" onchange="applyFilters()">
                            <option value="newest">Mới nhất</option>
                            <option value="oldest">Cũ nhất</option>
                            <option value="name_asc">A → Z</option>
                            <option value="name_desc">Z → A</option>
                            <option value="hours_desc">Giờ: Giảm</option>
                            <option value="hours_asc">Giờ: Tăng</option>
                        </select>
                    </div>

                    <!-- Nút đặt lại gọn gàng (Icon only / Text compact) -->
                    <button type="button" class="btn btn-secondary filter-control" onclick="resetFilters()" style="padding:0 10px; min-width:36px; display:inline-flex; align-items:center; justify-content:center; color:#64748b;" title="Đặt lại bộ lọc">
                        <i class="fas fa-undo"></i><span class="btn-text-full" style="margin-left:4px; font-size:0.8rem;">Đặt lại</span>
                    </button>
                </div>
            </div>

            <!-- Dòng đếm kết quả nhỏ gọn -->
            <div style="display:flex; justify-content:space-between; align-items:center; font-size:0.8rem; color:#64748b; padding-top:2px;">
                <span id="filter-result-count">Đang tải danh sách môn học...</span>
            </div>
        </div>

        <div id="projects-grid" class="grid grid-cols-2">
            <!-- Render projects here -->
        </div>

        <!-- Thanh Phân Trang (Tự động hiển thị khi > 12 môn) -->
        <div id="pagination-container" style="display:none; margin-top:18px; padding-top:14px; border-top:1px solid var(--border); justify-content:space-between; align-items:center; flex-wrap:wrap; gap:10px;">
            <div id="pagination-info" style="font-size:0.83rem; color:#64748b;">
                Hiển thị <b>1</b> - <b>12</b> trong tổng số <b>0</b> môn học
            </div>
            <div id="pagination-controls" style="display:flex; gap:4px; align-items:center;">
                <!-- Render page buttons -->
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('projects', 'Quản lý Môn học');
        
        const PAGE_SIZE = 12; // Yêu cầu: Vượt quá 12 môn sẽ tự động phân trang
        let allProjectsList = [];
        let filteredProjectsList = [];
        let currentPage = 1;
        let searchDebounceTimer = null;
        let selectedClassValue = '';
        let availableClassList = [];

        checkAuth().then(user => {
            if(user) {
                loadProjects();
            }
        });

        function removeVietnameseTones(str) {
            str = String(str || '');
            str = str.normalize('NFD').replace(/[\u0300-\u036f]/g, '');
            str = str.replace(/đ/g, 'd').replace(/Đ/g, 'D');
            return str.toLowerCase().trim();
        }

        function escapeHtml(s){ 
            return String(s || '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m])); 
        }

        async function loadProjects() {
            try {
                const res = await fetch(API_URL + '/projects', { headers: getHeaders() });
                const projects = await res.json();
                allProjectsList = Array.isArray(projects) ? projects : [];
                
                populateClassFilterOptions();
                applyFilters();
            } catch (err) {
                showAlert('Lỗi tải danh sách môn học');
            }
        }

        function toggleClassDropdown(e) {
            if(e) e.stopPropagation();
            const menu = document.getElementById('class-dropdown-menu');
            if(!menu) return;
            const isOpen = menu.style.display === 'block';
            if (isOpen) {
                closeClassDropdown();
            } else {
                openClassDropdown();
            }
        }

        function openClassDropdown() {
            const menu = document.getElementById('class-dropdown-menu');
            if(!menu) return;
            menu.style.display = 'block';
            const input = document.getElementById('class-search-input');
            input.value = '';
            document.getElementById('btn-clear-class-search').style.display = 'none';
            renderClassOptions('');
            setTimeout(() => input.focus(), 50);
        }

        function closeClassDropdown() {
            const menu = document.getElementById('class-dropdown-menu');
            if(menu) menu.style.display = 'none';
        }

        // Đóng dropdown khi bấm ra ngoài
        document.addEventListener('click', (e) => {
            const wrapper = document.getElementById('class-filter-wrapper');
            if(wrapper && !wrapper.contains(e.target)) {
                closeClassDropdown();
            }
        });

        function populateClassFilterOptions() {
            availableClassList = [...new Set(allProjectsList.map(p => (p.class_name || '').trim()).filter(Boolean))].sort((a, b) => a.localeCompare(b, 'vi'));
            renderClassOptions('');
        }

        function renderClassOptions(filterTerm) {
            const container = document.getElementById('class-options-list');
            if(!container) return;

            const termNorm = removeVietnameseTones(filterTerm);
            let filteredClasses = availableClassList.filter(c => {
                if(!termNorm) return true;
                return removeVietnameseTones(c).includes(termNorm);
            });

            let html = '';
            
            // Tùy chọn: Tất cả lớp
            if(!termNorm || removeVietnameseTones('-- Tất cả lớp --').includes(termNorm) || removeVietnameseTones('tat ca').includes(termNorm)) {
                const isSelected = selectedClassValue === '';
                html += `
                    <div class="class-option-item ${isSelected ? 'selected' : ''}" onclick="selectClassOption('', '-- Tất cả lớp --', event)">
                        <span>-- Tất cả lớp --</span>
                        ${isSelected ? '<i class="fas fa-check" style="font-size:0.75rem;"></i>' : ''}
                    </div>
                `;
            }

            if(filteredClasses.length === 0 && termNorm) {
                html += `<div style="padding:10px; text-align:center; color:#94a3b8; font-size:0.85rem;">Không tìm thấy lớp phù hợp</div>`;
            } else {
                filteredClasses.forEach(c => {
                    const isSelected = selectedClassValue === c;
                    html += `
                        <div class="class-option-item ${isSelected ? 'selected' : ''}" onclick="selectClassOption('${escapeHtml(c)}', '${escapeHtml(c)}', event)">
                            <span>${escapeHtml(c)}</span>
                            ${isSelected ? '<i class="fas fa-check" style="font-size:0.75rem;"></i>' : ''}
                        </div>
                    `;
                });
            }

            container.innerHTML = html;
        }

        function handleClassSearch(val) {
            document.getElementById('btn-clear-class-search').style.display = val ? 'block' : 'none';
            renderClassOptions(val);
        }

        function clearClassSearch(e) {
            if(e) e.stopPropagation();
            const input = document.getElementById('class-search-input');
            input.value = '';
            document.getElementById('btn-clear-class-search').style.display = 'none';
            renderClassOptions('');
            input.focus();
        }

        function selectClassOption(val, label, e) {
            if(e) e.stopPropagation();
            selectedClassValue = val;
            document.getElementById('class-select-label').textContent = label;
            closeClassDropdown();
            applyFilters();
        }

        function handleSearchInput() {
            const searchVal = document.getElementById('search-input').value;
            document.getElementById('btn-clear-search').style.display = searchVal ? 'block' : 'none';
            
            clearTimeout(searchDebounceTimer);
            searchDebounceTimer = setTimeout(() => {
                applyFilters();
            }, 200);
        }

        function clearSearch() {
            const searchInput = document.getElementById('search-input');
            searchInput.value = '';
            document.getElementById('btn-clear-search').style.display = 'none';
            applyFilters();
            searchInput.focus();
        }

        function resetFilters() {
            document.getElementById('search-input').value = '';
            document.getElementById('btn-clear-search').style.display = 'none';
            document.getElementById('filter-system').value = '';
            selectedClassValue = '';
            document.getElementById('class-select-label').textContent = '-- Tất cả lớp --';
            document.getElementById('filter-sort').value = 'newest';
            applyFilters();
        }

        function applyFilters() {
            const searchRaw = document.getElementById('search-input').value.trim();
            const searchNorm = removeVietnameseTones(searchRaw);
            const systemFilter = document.getElementById('filter-system').value;
            const classFilter = selectedClassValue;
            const sortFilter = document.getElementById('filter-sort').value;

            // 1. Lọc theo từ khóa tìm kiếm
            let result = allProjectsList.filter(p => {
                if(searchNorm) {
                    const nameNorm = removeVietnameseTones(p.name);
                    const codeNorm = removeVietnameseTones(p.course_code);
                    const classNorm = removeVietnameseTones(p.class_name);
                    const sysNorm = removeVietnameseTones(p.system_type);
                    
                    const match = nameNorm.includes(searchNorm) || 
                                  codeNorm.includes(searchNorm) || 
                                  classNorm.includes(searchNorm) || 
                                  sysNorm.includes(searchNorm);
                    if(!match) return false;
                }

                // 2. Lọc theo hệ đào tạo
                if(systemFilter && (p.system_type || 'Trung cấp') !== systemFilter) {
                    return false;
                }

                // 3. Lọc theo lớp
                if(classFilter && (p.class_name || '').trim() !== classFilter) {
                    return false;
                }

                return true;
            });

            // 4. Sắp xếp
            result.sort((a, b) => {
                if(sortFilter === 'newest') return (b.id || 0) - (a.id || 0);
                if(sortFilter === 'oldest') return (a.id || 0) - (b.id || 0);
                if(sortFilter === 'name_asc') return (a.name || '').localeCompare(b.name || '', 'vi');
                if(sortFilter === 'name_desc') return (b.name || '').localeCompare(a.name || '', 'vi');
                if(sortFilter === 'hours_desc') return (Number(b.total_hours) || 0) - (Number(a.total_hours) || 0);
                if(sortFilter === 'hours_asc') return (Number(a.total_hours) || 0) - (Number(b.total_hours) || 0);
                return 0;
            });

            filteredProjectsList = result;
            currentPage = 1;
            renderProjects();
        }

        function renderProjects() {
            const grid = document.getElementById('projects-grid');
            const total = filteredProjectsList.length;
            const totalPages = Math.ceil(total / PAGE_SIZE) || 1;

            if(currentPage > totalPages) currentPage = totalPages;
            if(currentPage < 1) currentPage = 1;

            // Cập nhật thông tin đếm kết quả
            const countEl = document.getElementById('filter-result-count');
            if(allProjectsList.length === 0) {
                countEl.textContent = 'Chưa có môn học nào trong hệ thống.';
            } else if(total === allProjectsList.length) {
                countEl.innerHTML = `Tổng số: <b>${total}</b> môn học`;
            } else {
                countEl.innerHTML = `Tìm thấy: <b>${total}</b> / ${allProjectsList.length} môn học phù hợp`;
            }

            // Render danh sách rỗng
            if(total === 0) {
                if(allProjectsList.length === 0) {
                    grid.innerHTML = '<div style="grid-column: span 2; text-align:center; padding: 40px; color: var(--text-light)">Chưa có môn học nào. Nhấn "Thêm Môn học" để bắt đầu.</div>';
                } else {
                    grid.innerHTML = `
                        <div style="grid-column: span 2; text-align:center; padding: 40px; color: var(--text-light); background:#f8fafc; border-radius:8px; border:1px dashed var(--border);">
                            <i class="fas fa-search" style="font-size:2rem; color:#cbd5e1; margin-bottom:10px; display:block;"></i>
                            Không tìm thấy môn học nào phù hợp với bộ lọc.<br>
                            <button class="btn btn-secondary" onclick="resetFilters()" style="margin-top:12px; font-size:0.85rem;"><i class="fas fa-undo"></i> Xóa bộ lọc</button>
                        </div>
                    `;
                }
                document.getElementById('pagination-container').style.display = 'none';
                return;
            }

            // Phân trang: Cắt danh sách
            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const endIndex = Math.min(startIndex + PAGE_SIZE, total);
            const pageItems = filteredProjectsList.slice(startIndex, endIndex);

            grid.innerHTML = pageItems.map((p, idx) => {
                const itemIndex = startIndex + idx + 1;
                return `
                <div class="project-card">
                    <div style="display:flex; justify-content:space-between; align-items:flex-start; margin-bottom:8px; gap:8px;">
                        <div style="display:flex; align-items:flex-start; gap:8px; flex:1; min-width:0;">
                            <span style="display:inline-flex; align-items:center; justify-content:center; min-width:22px; height:22px; padding:0 4px; border-radius:5px; background:#16469d; color:#fff; font-weight:700; font-size:0.75rem; flex-shrink:0; margin-top:1px;" title="Số thứ tự: ${itemIndex}">${itemIndex}</span>
                            <div class="project-title" style="margin-bottom:0; word-break:break-word;">${escapeHtml(p.name)}</div>
                        </div>
                        <span style="font-size:0.75rem; font-weight:700; padding:3px 8px; border-radius:6px; background:${p.system_type === 'Cao đẳng' ? '#e0e7ff; color:#3730a3;' : '#fef3c7; color:#92400e;'} flex-shrink:0;">${escapeHtml(p.system_type || 'Trung cấp')}</span>
                    </div>
                    <div class="project-meta">
                        Mã: <b>${escapeHtml(p.course_code || '---')}</b> &bull; Lớp: <b>${escapeHtml(p.class_name || '---')}</b> &bull; Tổng giờ: <b>${p.total_hours || 0}</b>
                    </div>
                    <div style="display:flex; gap:8px; margin-top:14px;">
                        <button class="btn btn-primary btn-sm" onclick="openApp(${p.id})"><i class="fas fa-file-signature"></i> <span>Soạn Giáo Án</span></button>
                        <button class="btn btn-secondary btn-sm btn-icon-only" style="background:#f1f5f9; color:#334155; border:1px solid #cbd5e1;" title="Chỉnh sửa môn học" onclick="openEditModal(${p.id})"><i class="fas fa-edit"></i></button>
                        <button class="btn btn-danger btn-sm btn-icon-only" title="Xóa môn học" onclick="deleteProject(${p.id})"><i class="fas fa-trash"></i></button>
                    </div>
                </div>
                `;
            }).join('');

            // Hiển thị / Ẩn thanh phân trang nếu > 12 môn
            const paginationContainer = document.getElementById('pagination-container');
            if(total > PAGE_SIZE) {
                paginationContainer.style.display = 'flex';
                document.getElementById('pagination-info').innerHTML = `Hiển thị <b>${startIndex + 1}</b> - <b>${endIndex}</b> trong tổng số <b>${total}</b> môn học (Trang ${currentPage}/${totalPages})`;
                renderPaginationControls(totalPages);
            } else {
                paginationContainer.style.display = 'none';
            }
        }

        function renderPaginationControls(totalPages) {
            const controls = document.getElementById('pagination-controls');
            let html = '';

            // Nút Đầu & Trước
            html += `<button class="page-btn" onclick="goToPage(1)" ${currentPage === 1 ? 'disabled' : ''} title="Trang đầu"><i class="fas fa-angle-double-left"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} title="Trang trước"><i class="fas fa-angle-left"></i></button>`;

            // Tính toán danh sách số trang hiển thị
            let pages = [];
            const delta = 2; // Số trang lân cận hiển thị
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
                    pages.push(i);
                }
            }

            let lastPage = 0;
            pages.forEach(p => {
                if (lastPage && p - lastPage > 1) {
                    html += `<span style="padding: 0 4px; color: #94a3b8;">...</span>`;
                }
                html += `<button class="page-btn ${p === currentPage ? 'active' : ''}" onclick="goToPage(${p})">${p}</button>`;
                lastPage = p;
            });

            // Nút Tiếp & Cuối
            html += `<button class="page-btn" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} title="Trang tiếp"><i class="fas fa-angle-right"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${totalPages})" ${currentPage === totalPages ? 'disabled' : ''} title="Trang cuối"><i class="fas fa-angle-double-right"></i></button>`;

            controls.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            renderProjects();
            const mainCard = document.getElementById('main-card');
            if(mainCard) {
                mainCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        function openNewProjectForm() { document.getElementById('new-project-form').style.display = 'block'; }
        function closeNewProjectForm() { document.getElementById('new-project-form').style.display = 'none'; }

        function openEditModal(id) {
            const p = allProjectsList.find(x => x.id === id);
            if(!p) return;
            document.getElementById('edit-project-id').value = p.id;
            document.getElementById('edit-project-name').value = p.name || '';
            document.getElementById('edit-project-code').value = p.course_code || '';
            document.getElementById('edit-project-hours').value = p.total_hours || 0;
            document.getElementById('edit-project-system').value = p.system_type || 'Trung cấp';
            document.getElementById('edit-project-class').value = p.class_name || '';
            
            const modal = document.getElementById('edit-project-modal');
            modal.style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('edit-project-modal').style.display = 'none';
        }

        async function saveEditProject() {
            const id = document.getElementById('edit-project-id').value;
            const name = document.getElementById('edit-project-name').value.trim();
            const course_code = document.getElementById('edit-project-code').value.trim();
            const total_hours = document.getElementById('edit-project-hours').value;
            const system_type = document.getElementById('edit-project-system').value;
            const class_name = document.getElementById('edit-project-class').value.trim();

            if(!name) return showAlert('Vui lòng nhập tên môn học');

            try {
                const res = await fetch(API_URL + '/projects/' + id, {
                    method: 'PUT',
                    headers: getHeaders(),
                    body: JSON.stringify({
                        name,
                        course_code,
                        total_hours: Number(total_hours),
                        system_type,
                        class_name
                    })
                });
                if(!res.ok) throw new Error('Không thể cập nhật môn học');
                
                closeEditModal();
                loadProjects();
                showAlert('Cập nhật môn học thành công!', 'success');
            } catch(err) {
                showAlert(err.message);
            }
        }

        async function createProject() {
            const name = document.getElementById('project-name').value;
            const course_code = document.getElementById('project-code').value;
            const system_type = document.getElementById('project-system').value;
            const class_name = document.getElementById('project-class').value;
            const total_hours = document.getElementById('project-hours').value;
            
            if(!name) return showAlert('Vui lòng nhập tên môn học');

            try {
                const res = await fetch(API_URL + '/projects', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ 
                        name, 
                        course_code, 
                        system_type, 
                        class_name, 
                        total_hours: Number(total_hours) 
                    })
                });
                if(!res.ok) throw new Error('Không thể tạo môn học');
                
                closeNewProjectForm();
                document.getElementById('project-name').value = '';
                document.getElementById('project-code').value = '';
                document.getElementById('project-class').value = '';
                loadProjects();
                showAlert('Tạo thành công!', 'success');
            } catch (err) {
                showAlert(err.message);
            }
        }

        async function deleteProject(id) {
            if(!(await customConfirm('Xóa môn học này và toàn bộ giáo án liên quan?'))) return;
            try {
                const res = await fetch(API_URL + '/projects/' + id, { method: 'DELETE', headers: getHeaders() });
                if(!res.ok) throw new Error('Lỗi khi xóa');
                loadProjects();
                showAlert('Đã xóa', 'success');
            } catch(err) {
                showAlert(err.message);
            }
        }

        function openApp(projectId) {
            window.location.href = `/app?project=${projectId}`;
        }
    </script>
</body>
</html>
