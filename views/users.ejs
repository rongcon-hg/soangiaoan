<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Quản lý Người dùng - Hệ thống Giáo án</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<style>
    .swal2-popup { font-family: 'Be Vietnam Pro', sans-serif !important; }
    
    /* Search & Filter Toolbar */
    .filter-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        align-items: center;
        margin-top: 16px;
        margin-bottom: 16px;
        background: #f8fafc;
        padding: 14px 16px;
        border-radius: 8px;
        border: 1px solid var(--border);
    }
    .search-box {
        position: relative;
        flex: 1;
        min-width: 240px;
    }
    .search-box i {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        color: #94a3b8;
        font-size: 0.95rem;
    }
    .search-box input {
        padding-left: 36px !important;
    }
    
    /* Mobile Table Scrollbar */
    .table-responsive {
        width: 100%;
        overflow-x: auto;
        -webkit-overflow-scrolling: touch;
        border-radius: 8px;
        border: 1px solid var(--border);
    }
    .table-responsive::-webkit-scrollbar {
        height: 6px;
    }
    .table-responsive::-webkit-scrollbar-thumb {
        background: #cbd5e1;
        border-radius: 3px;
    }
    .table-responsive table {
        min-width: 720px;
        margin-top: 0 !important;
    }

    /* Table single line & sticky action */
    .table-responsive table {
        width: 100%;
        min-width: 680px;
        border-collapse: collapse;
    }
    .table-responsive table th,
    .table-responsive table td {
        white-space: nowrap !important;
        vertical-align: middle;
    }
    .sticky-action {
        position: sticky;
        right: 0;
        z-index: 5;
        box-shadow: -3px 0 8px rgba(0, 0, 0, 0.05);
    }
    thead th.sticky-action {
        background: var(--bg) !important;
        z-index: 6;
    }
    tbody td.sticky-action {
        background: #ffffff !important;
    }
    tr:hover td.sticky-action {
        background: #f8fafc !important;
    }

    .btn-action {
        padding: 6px 12px;
        font-size: 0.85rem;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    /* Filter Controls */
    .filter-controls {
        display: flex;
        gap: 8px;
        flex-wrap: wrap;
        align-items: center;
    }
    .filter-status-group {
        display: flex;
        gap: 8px;
        align-items: center;
    }

    @media (max-width: 768px) {
        .filter-bar {
            flex-direction: column !important;
            align-items: stretch !important;
            padding: 12px !important;
            gap: 10px !important;
        }
        .search-box {
            width: 100% !important;
            min-width: 100% !important;
        }
        .filter-controls {
            flex-direction: column !important;
            width: 100% !important;
            gap: 10px !important;
        }
        .filter-controls select#filter-role {
            width: 100% !important;
            min-width: 100% !important;
        }
        .filter-status-group {
            width: 100% !important;
            display: flex !important;
            gap: 8px !important;
        }
        .filter-status-group select#filter-status {
            flex: 1 !important;
            width: 100% !important;
            min-width: 0 !important;
        }
        .filter-status-group button {
            flex-shrink: 0 !important;
            padding: 10px 16px !important;
        }
        
        .btn-action {
            padding: 6px 9px;
            font-size: 0.85rem;
            gap: 0;
        }
        .btn-action-text {
            display: none !important;
        }
        .card-header {
            padding-bottom: 12px;
        }
        .card-title {
            font-size: 1rem !important;
        }
    }


    /* Pagination buttons */
    .page-btn {
        min-width: 34px;
        height: 34px;
        padding: 0 8px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border-radius: 6px;
        border: 1px solid var(--border);
        background: #fff;
        color: #334155;
        font-weight: 600;
        font-size: 0.85rem;
        cursor: pointer;
        transition: all 0.2s ease;
    }
    .page-btn:hover:not(:disabled) {
        background: #f1f5f9;
        border-color: #cbd5e1;
        color: var(--primary);
    }
    .page-btn.active {
        background: var(--primary);
        border-color: var(--primary);
        color: #fff;
    }
    .page-btn:disabled {
        opacity: 0.4;
        cursor: not-allowed;
    }

</style>
<script>
window._originalAlert = window.alert;
window.alert = function(msg) {
    if(typeof Swal !== 'undefined') {
        Swal.fire({ text: msg, icon: 'info', confirmButtonColor: '#16469d' });
    } else {
        window._originalAlert(msg);
    }
};
window.customConfirm = async function(msg) {
    if(typeof Swal === 'undefined') return window.confirm(msg);
    const result = await Swal.fire({
        text: msg,
        icon: 'warning',
        showCancelButton: true,
        confirmButtonColor: '#16469d',
        cancelButtonColor: '#d33',
        confirmButtonText: 'Đồng ý',
        cancelButtonText: 'Hủy'
    });
    return result.isConfirmed;
};
</script>

</head>
<body>
    <div id="alert-box"></div>
    <div class="card">
        <div class="card-header" style="display:flex; justify-content:space-between; align-items:center; gap:8px; flex-wrap:nowrap;">
            <h3 class="card-title" style="white-space:nowrap; margin:0; font-size:1.05rem; overflow:hidden; text-overflow:ellipsis;"><i class="fas fa-users-cog" style="color:var(--primary); margin-right:8px;"></i> Quản lý Người dùng</h3>
            <button class="btn btn-primary" onclick="openNewUserForm()" style="white-space:nowrap; padding:8px 12px; font-size:0.85rem; flex-shrink:0;"><i class="fas fa-user-plus"></i> <span>Thêm thành viên</span></button>
        </div>
        
        <!-- Add/Edit User Form -->
        <div id="user-form-modal" style="display:none; background:#f8fafc; padding:20px; border-radius:10px; margin-bottom:24px; border:1px solid var(--border); box-shadow:0 2px 8px rgba(0,0,0,0.04);">
            <h4 id="form-title" style="font-size:1.1rem; color:var(--primary); margin-bottom:16px;"><i class="fas fa-user-edit"></i> Sửa thông tin người dùng</h4>
            <input type="hidden" id="form-user-id">
            <div class="grid grid-cols-2">
                <div class="form-group">
                    <label><i class="fas fa-user-tag" style="color:#64748b; margin-right:4px;"></i> Tên đăng nhập</label>
                    <input type="text" id="form-username" class="form-control" placeholder="Tên đăng nhập...">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-id-card" style="color:#64748b; margin-right:4px;"></i> Họ và tên</label>
                    <input type="text" id="form-fullname" class="form-control" placeholder="Ví dụ: Nguyễn Văn A">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-envelope" style="color:#64748b; margin-right:4px;"></i> Email</label>
                    <input type="email" id="form-email" class="form-control" placeholder="name@nsg.edu.vn">
                </div>
                <div class="form-group">
                    <label><i class="fas fa-shield-alt" style="color:#64748b; margin-right:4px;"></i> Quyền hạn</label>
                    <select id="form-role" class="form-control">
                        <option value="User">Giáo viên (User)</option>
                        <option value="Admin">Quản trị viên (Admin)</option>
                    </select>
                </div>
                <div class="form-group" style="grid-column: 1 / -1;">
                    <label><i class="fas fa-key" style="color:#64748b; margin-right:4px;"></i> Mật khẩu (Bỏ trống nếu không muốn đổi)</label>
                    <input type="password" id="form-password" class="form-control" placeholder="Nhập mật khẩu mới...">
                </div>
            </div>
            <div style="margin-top:14px; display:flex; gap:10px; flex-wrap:wrap;">
                <button class="btn btn-primary" onclick="saveUser()"><i class="fas fa-save"></i> Lưu thông tin</button>
                <button class="btn btn-secondary" onclick="closeUserForm()"><i class="fas fa-times"></i> Hủy</button>
            </div>
        </div>

        <!-- Filter & Search Toolbar -->
        <div class="filter-bar">
            <div class="search-box">
                <i class="fas fa-search"></i>
                <input type="text" id="user-search-input" class="form-control" placeholder="Tìm theo tên đăng nhập, họ tên, email..." oninput="filterUsers()">
            </div>
            <div class="filter-controls">
                <select id="filter-role" class="form-control" onchange="filterUsers()">
                    <option value="">Tất cả vai trò</option>
                    <option value="Admin">Quản trị viên (Admin)</option>
                    <option value="User">Giáo viên (User)</option>
                </select>
                <div class="filter-status-group">
                    <select id="filter-status" class="form-control" onchange="filterUsers()">
                        <option value="">Tất cả trạng thái</option>
                        <option value="verified">Đã xác thực</option>
                        <option value="unverified">Chờ xác thực</option>
                    </select>
                    <button class="btn btn-secondary" onclick="resetFilters()" title="Đặt lại bộ lọc" style="padding:10px 14px;">
                        <i class="fas fa-redo"></i>
                    </button>
                </div>
            </div>
        </div>

        <div style="margin-bottom:12px; font-size:0.88rem; color:#64748b;">
            Hiển thị: <b id="user-count-display" style="color:var(--primary);">0</b> người dùng
        </div>

        <!-- Users Table -->
        <div class="table-responsive">
            <table style="width:100%; border-collapse: collapse;">
                <thead>
                    <tr style="background:var(--bg); text-align:left;">
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem; width:60px; text-align:center;">STT</th>
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem;">Tài khoản</th>
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem;">Họ tên</th>
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem;">Email</th>
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem;">Vai trò</th>
                        <th style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem;">Trạng thái</th>
                        <th class="sticky-action" style="padding:12px; border-bottom:1px solid var(--border); font-size:0.88rem; text-align:center; width:100px;">Hành động</th>
                    </tr>
                </thead>
                <tbody id="users-table-body">
                    <tr><td colspan="7" style="text-align:center; padding:24px; color:#94a3b8;">Đang tải danh sách người dùng...</td></tr>
                </tbody>
            </table>
        </div>

        <!-- Pagination Bar -->
        <div id="pagination-container" style="display: none; justify-content: space-between; align-items: center; margin-top: 18px; padding-top: 14px; border-top: 1px solid var(--border); flex-wrap: wrap; gap: 12px;">
            <div id="pagination-info" style="font-size: 0.88rem; color: #64748b;">
                Hiển thị <b>1 - 10</b> trong tổng số <b>0</b> người dùng
            </div>
            <div style="display: flex; gap: 6px; align-items: center;" id="pagination-buttons">
                <!-- Page buttons -->
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('users', 'Quản lý Người dùng');
        
        let allUsersList = [];
        let currentFilteredList = [];
        const PAGE_SIZE = 10;
        let currentPage = 1;

        checkAuth().then(user => {
            if(user) {
                if(user.role !== 'Admin') {
                    window.location.href = '/';
                    return;
                }
                loadUsers();
            }
        });

        function escapeHtml(s) {
            return String(s || '').replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#039;' }[m]));
        }

        async function loadUsers() {
            try {
                const res = await fetch(API_URL + '/users', { headers: getHeaders() });
                allUsersList = await res.json();
                filterUsers();
            } catch(e) { 
                showAlert('Lỗi tải danh sách người dùng'); 
            }
        }

        function filterUsers() {
            const searchKeyword = (document.getElementById('user-search-input')?.value || '').trim().toLowerCase();
            const selectedRole = document.getElementById('filter-role')?.value || '';
            const selectedStatus = document.getElementById('filter-status')?.value || '';

            currentFilteredList = allUsersList.filter(u => {
                // 1. Search keyword (username, full_name, email)
                const uName = (u.username || '').toLowerCase();
                const fName = (u.full_name || '').toLowerCase();
                const email = (u.email || '').toLowerCase();
                const matchSearch = !searchKeyword || uName.includes(searchKeyword) || fName.includes(searchKeyword) || email.includes(searchKeyword);

                // 2. Role filter
                const matchRole = !selectedRole || u.role === selectedRole;

                // 3. Status filter
                const matchStatus = !selectedStatus || (selectedStatus === 'verified' ? Boolean(u.is_verified) : !u.is_verified);

                return matchSearch && matchRole && matchStatus;
            });

            currentPage = 1;
            renderCurrentPage();
        }

        function renderCurrentPage() {
            const totalItems = currentFilteredList.length;
            const totalPages = Math.ceil(totalItems / PAGE_SIZE) || 1;
            if (currentPage > totalPages) currentPage = totalPages;
            if (currentPage < 1) currentPage = 1;

            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const endIndex = Math.min(startIndex + PAGE_SIZE, totalItems);
            const pageItems = currentFilteredList.slice(startIndex, endIndex);

            renderUsersTable(pageItems, startIndex);
            renderPagination(totalItems, totalPages, startIndex, endIndex);
        }

        function changePage(page) {
            const totalPages = Math.ceil(currentFilteredList.length / PAGE_SIZE) || 1;
            if (page < 1 || page > totalPages) return;
            currentPage = page;
            renderCurrentPage();
            document.querySelector('.table-responsive')?.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function renderPagination(totalItems, totalPages, startIndex, endIndex) {
            const container = document.getElementById('pagination-container');
            if (!container) return;

            if (totalItems <= PAGE_SIZE) {
                container.style.display = 'none';
                return;
            }

            container.style.display = 'flex';
            
            const info = document.getElementById('pagination-info');
            if (info) {
                info.innerHTML = `Hiển thị <b>${startIndex + 1} - ${endIndex}</b> trong tổng số <b>${totalItems}</b> người dùng`;
            }

            const btnGroup = document.getElementById('pagination-buttons');
            if (!btnGroup) return;

            let html = `<button class="page-btn" onclick="changePage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''} title="Trang trước"><i class="fas fa-chevron-left"></i></button>`;

            for (let p = 1; p <= totalPages; p++) {
                if (totalPages <= 7 || p === 1 || p === totalPages || (p >= currentPage - 1 && p <= currentPage + 1)) {
                    html += `<button class="page-btn ${p === currentPage ? 'active' : ''}" onclick="changePage(${p})">${p}</button>`;
                } else if (p === currentPage - 2 || p === currentPage + 2) {
                    html += `<span style="padding: 0 4px; color: #94a3b8;">...</span>`;
                }
            }

            html += `<button class="page-btn" onclick="changePage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''} title="Trang kế tiếp"><i class="fas fa-chevron-right"></i></button>`;

            btnGroup.innerHTML = html;
        }

        function renderUsersTable(users, startIndex = 0) {
            const countDisplay = document.getElementById('user-count-display');
            if (countDisplay) countDisplay.textContent = users.length + ' / ' + allUsersList.length;

            const tbody = document.getElementById('users-table-body');
            if (!users || !users.length) {
                tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:36px 20px; color:#94a3b8;"><i class="fas fa-user-slash" style="font-size:2rem; margin-bottom:8px; display:block; color:#cbd5e1;"></i> Không tìm thấy người dùng nào phù hợp với điều kiện tìm kiếm.</td></tr>';
                return;
            }

            tbody.innerHTML = users.map((u, idx) => {
                const fullNameEsc = escapeHtml(u.full_name || '');
                const usernameEsc = escapeHtml(u.username || '');
                const emailEsc = escapeHtml(u.email || '');
                const roleEsc = escapeHtml(u.role || 'User');
                
                const editBtn = `<button class="btn btn-secondary btn-action" style="margin-right:4px;" onclick="openEditUserForm(${u.id}, '${usernameEsc}', '${fullNameEsc}', '${emailEsc}', '${roleEsc}')" title="Sửa thông tin"><i class="fas fa-edit"></i> <span class="btn-action-text">Sửa</span></button>`;
                const delBtn = `<button class="btn btn-danger btn-action" onclick="deleteUser(${u.id})" title="Xóa người dùng"><i class="fas fa-trash-alt"></i> <span class="btn-action-text">Xóa</span></button>`;
                
                return `
                <tr style="border-bottom:1px solid var(--border);">
                    <td style="padding:12px; font-weight:700; color:var(--primary); text-align:center;">${startIndex + idx + 1}</td>
                    <td style="padding:12px;"><b>${usernameEsc}</b></td>
                    <td style="padding:12px; font-weight:600; color:#1e293b;">${u.full_name || '<span style="color:#94a3b8; font-weight:normal;">-</span>'}</td>
                    <td style="padding:12px; color:#475569;">${u.email || '<span style="color:#94a3b8;">-</span>'}</td>
                    <td style="padding:12px;"><span style="background:${u.role==='Admin'?'var(--primary)':'#475569'}; color:white; padding:4px 10px; border-radius:999px; font-size:12px; font-weight:600;"><i class="fas ${u.role==='Admin'?'fa-user-shield':'fa-user'}"></i> ${u.role}</span></td>
                    <td style="padding:12px;">${u.is_verified ? '<span style="color:var(--success); font-weight:600; font-size:0.88rem;"><i class="fas fa-check-circle"></i> Đã xác thực</span>' : '<span style="color:var(--text-light); font-size:0.88rem;"><i class="fas fa-clock"></i> Chờ xác thực</span>'}</td>
                    <td class="sticky-action" style="padding:12px; text-align:center; white-space:nowrap;">
                        ${editBtn} ${delBtn}
                    </td>
                </tr>
                `;
            }).join('');
        }

        function resetFilters() {
            const sInput = document.getElementById('user-search-input');
            const rSelect = document.getElementById('filter-role');
            const stSelect = document.getElementById('filter-status');
            if (sInput) sInput.value = '';
            if (rSelect) rSelect.value = '';
            if (stSelect) stSelect.value = '';
            filterUsers();
        }

        function openNewUserForm() { 
            document.getElementById('user-form-modal').style.display = 'block'; 
            document.getElementById('form-title').innerHTML = '<i class="fas fa-user-plus"></i> Thêm thành viên mới';
            document.getElementById('form-user-id').value = '';
            document.getElementById('form-username').value = '';
            document.getElementById('form-username').disabled = false;
            document.getElementById('form-fullname').value = '';
            document.getElementById('form-email').value = '';
            document.getElementById('form-password').value = '';
            document.getElementById('form-role').value = 'User';
            document.getElementById('user-form-modal').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function openEditUserForm(id, username, fullname, email, role) {
            document.getElementById('user-form-modal').style.display = 'block'; 
            document.getElementById('form-title').innerHTML = '<i class="fas fa-user-edit"></i> Sửa thông tin: <b>' + username + '</b>';
            document.getElementById('form-user-id').value = id;
            document.getElementById('form-username').value = username;
            document.getElementById('form-username').disabled = true; // Không cho sửa username
            document.getElementById('form-fullname').value = fullname || '';
            document.getElementById('form-email').value = email || '';
            document.getElementById('form-password').value = ''; // Để trống nếu không đổi
            document.getElementById('form-role').value = role;
            document.getElementById('user-form-modal').scrollIntoView({ behavior: 'smooth', block: 'start' });
        }

        function closeUserForm() { document.getElementById('user-form-modal').style.display = 'none'; }

        async function saveUser() {
            const id = document.getElementById('form-user-id').value;
            const username = document.getElementById('form-username').value.trim();
            const full_name = document.getElementById('form-fullname').value.trim();
            const email = document.getElementById('form-email').value.trim();
            const password = document.getElementById('form-password').value;
            const role = document.getElementById('form-role').value;
            
            if (!username) return showAlert('Vui lòng nhập tên đăng nhập');
            
            try {
                const method = id ? 'PUT' : 'POST';
                const endpoint = id ? '/users/' + id : '/users';
                
                const res = await fetch(API_URL + endpoint, {
                    method: method,
                    headers: getHeaders(),
                    body: JSON.stringify({ username, full_name, email, password, role })
                });
                const data = await res.json();
                if(!res.ok) throw new Error(data.message || data.error);
                
                showAlert('Lưu thông tin thành công!', 'success');
                closeUserForm();
                loadUsers();
            } catch(e) { showAlert(e.message); }
        }

        async function deleteUser(id) {
            if(!(await customConfirm('Bạn có chắc chắn muốn xóa người dùng này không?'))) return;
            try {
                const res = await fetch(API_URL + '/users/' + id, { method: 'DELETE', headers: getHeaders() });
                if(!res.ok) throw new Error('Không thể xóa người dùng');
                showAlert('Đã xóa người dùng thành công', 'success');
                loadUsers();
            } catch(e) { showAlert(e.message); }
        }
    </script>
</body>
</html>
