<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <title>Quản lý Người dùng - Hệ thống Giáo án</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div id="alert-box"></div>
    <div class="card">
        <div class="card-header">
            <h3 class="card-title">Quản lý Người dùng</h3>
            <button class="btn btn-primary" onclick="openNewUserForm()"><i class="fas fa-user-plus"></i> Thêm thành viên</button>
        </div>
        
        <div id="new-user-form" style="display:none; background:#f8fafc; padding:16px; border-radius:8px; margin-bottom:20px; border:1px solid var(--border)">
            <h4>Thêm thành viên mới</h4><br>
            <div class="grid grid-cols-2">
                <div class="form-group">
                    <label>Tên đăng nhập</label>
                    <input type="text" id="new-username" class="form-control">
                </div>
                <div class="form-group">
                    <label>Email</label>
                    <input type="email" id="new-email" class="form-control">
                </div>
                <div class="form-group">
                    <label>Mật khẩu</label>
                    <input type="password" id="new-password" class="form-control">
                </div>
                <div class="form-group">
                    <label>Quyền hạn</label>
                    <select id="new-role" class="form-control">
                        <option value="User">Giáo viên (User)</option>
                        <option value="Admin">Quản trị viên (Admin)</option>
                    </select>
                </div>
            </div>
            <div style="margin-top:10px">
                <button class="btn btn-primary" onclick="createUser()">Lưu</button>
                <button class="btn btn-secondary" onclick="closeNewUserForm()">Hủy</button>
            </div>
        </div>

        <table style="width:100%; border-collapse: collapse; margin-top:20px;">
            <thead>
                <tr style="background:var(--bg); text-align:left;">
                    <th style="padding:12px; border-bottom:1px solid var(--border)">ID</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Tài khoản</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Họ tên</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Email</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Vai trò</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Trạng thái</th>
                    <th style="padding:12px; border-bottom:1px solid var(--border)">Hành động</th>
                </tr>
            </thead>
            <tbody id="users-table-body">
                <!-- Render users -->
            </tbody>
        </table>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('users', 'Quản lý Người dùng');
        checkAuth().then(user => {
            if(user) {
                if(user.role !== 'Admin') {
                    window.location.href = '/';
                    return;
                }
                loadUsers();
            }
        });

        async function loadUsers() {
            try {
                const res = await fetch(API_URL + '/users', { headers: getHeaders() });
                const users = await res.json();
                
                document.getElementById('users-table-body').innerHTML = users.map(u => `
                    <tr>
                        <td style="padding:12px; border-bottom:1px solid var(--border)">${u.id}</td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)"><b>${u.username}</b></td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)">${u.full_name || '-'}</td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)">${u.email || '-'}</td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)"><span style="background:${u.role==='Admin'?'var(--primary)':'var(--secondary)'}; color:white; padding:4px 8px; border-radius:4px; font-size:12px"><i class="fas ${u.role==='Admin'?'fa-user-shield':'fa-user'}"></i> ${u.role}</span></td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)">${u.is_verified ? '<span style="color:var(--success)"><i class="fas fa-check-circle"></i> Đã xác thực</span>' : '<span style="color:var(--text-light)">Chờ xác thực</span>'}</td>
                        <td style="padding:12px; border-bottom:1px solid var(--border)">
                            <button class="btn btn-danger" onclick="deleteUser(${u.id})"><i class="fas fa-trash"></i></button>
                        </td>
                    </tr>
                `).join('');
            } catch(e) { showAlert('Lỗi tải danh sách'); }
        }

        function openNewUserForm() { document.getElementById('new-user-form').style.display = 'block'; }
        function closeNewUserForm() { document.getElementById('new-user-form').style.display = 'none'; }

        async function createUser() {
            const username = document.getElementById('new-username').value;
            const email = document.getElementById('new-email').value;
            const password = document.getElementById('new-password').value;
            const role = document.getElementById('new-role').value;
            
            try {
                const res = await fetch(API_URL + '/users', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ username, email, password, role })
                });
                const data = await res.json();
                if(!res.ok) throw new Error(data.message || data.error);
                
                showAlert('Tạo thành công!', 'success');
                closeNewUserForm();
                loadUsers();
            } catch(e) { showAlert(e.message); }
        }

        async function deleteUser(id) {
            if(!confirm('Xóa người dùng này?')) return;
            try {
                const res = await fetch(API_URL + '/users/' + id, { method: 'DELETE', headers: getHeaders() });
                if(!res.ok) throw new Error('Không thể xóa');
                showAlert('Đã xóa', 'success');
                loadUsers();
            } catch(e) { showAlert(e.message); }
        }
    </script>
</body>
</html>
