<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phê duyệt Giáo án - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        .my-modal {
            display: none; 
            position: fixed; 
            z-index: 1000; 
            left: 0; 
            top: 0; 
            width: 100%; 
            height: 100%; 
            background-color: rgba(0,0,0,0.5);
            backdrop-filter: blur(4px);
        }
        .my-modal-content {
            background-color: #fff;
            margin: 2% auto;
            border-radius: 8px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.2);
            width: 95%;
            max-width: 1200px;
            height: 90vh;
            display: flex;
            flex-direction: column;
            overflow: hidden;
            animation: modalFadeIn 0.3s ease;
        }
        @keyframes modalFadeIn {
            from { opacity: 0; transform: translateY(-20px); }
            to { opacity: 1; transform: translateY(0); }
        }
        .my-modal-header {
            padding: 15px 20px;
            background: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }
        .my-modal-close {
            font-size: 1.5rem;
            cursor: pointer;
            color: #64748b;
        }
        .my-modal-close:hover { color: #dc2626; }
        
        .filter-container {
            display: flex;
            gap: 15px;
            background: #f8fafc;
            padding: 15px;
            border-radius: 8px;
            border: 1px solid #e2e8f0;
            margin-bottom: 20px;
            flex-wrap: wrap;
            align-items: flex-end;
        }
        .filter-group {
            flex: 1;
            min-width: 250px;
        }
        .filter-label {
            font-size: 13px;
            font-weight: 600;
            color: #475569;
            margin-bottom: 5px;
            display: block;
        }
        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 20px;
            padding-top: 15px;
            border-top: 1px solid var(--border);
        }
        .page-btn {
            background: #fff; border: 1px solid #cbd5e1;
            padding: 5px 12px; border-radius: 6px;
            cursor: pointer; color: #475569;
            transition: all 0.2s;
        }
        .page-btn:hover:not(:disabled) { background: #f1f5f9; color: var(--primary); border-color: var(--primary); }
        .page-btn.active { background: var(--primary); color: #fff; border-color: var(--primary); }
        .page-btn:disabled { opacity: 0.5; cursor: not-allowed; }
    </style>
</head>
<body>
    <div id="alert-box"></div>

    <div class="card" id="main-card">
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:15px;">
            <h3 style="margin:0; color:var(--primary);"><i class="fas fa-check-double"></i> Danh sách Giáo án Chờ Duyệt</h3>
            <button class="btn btn-secondary" onclick="loadPendingLessons()"><i class="fas fa-sync-alt"></i> Làm mới</button>
        </div>
        
        <!-- Smart Search and Filter -->
        <div class="filter-container">
            <div class="filter-group">
                <label class="filter-label">Tìm kiếm thông minh (Giáo viên, Môn học):</label>
                <div class="search-box" style="margin:0; width:100%; position:relative;">
                    <i class="fas fa-search" style="position:absolute; left:12px; top:50%; transform:translateY(-50%); color:#94a3b8;"></i>
                    <input type="text" id="search-input" class="form-control" style="padding-left:35px; width:100%; box-sizing:border-box;" placeholder="Nhập tên giáo viên, môn học..." onkeyup="applyFilters()">
                </div>
            </div>
            <div class="filter-group">
                <label class="filter-label">Lọc theo Đơn vị (Khoa/Tổ):</label>
                <select id="filter-department" class="form-control" onchange="applyFilters()">
                    <option value="">-- Tất cả đơn vị --</option>
                </select>
            </div>
        </div>

        <div style="overflow-x:auto;">
            <table class="table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Người gửi</th>
                        <th>Đơn vị</th>
                        <th>Môn học</th>
                        <th>Bài số</th>
                        <th>Thời gian gửi</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="pending-list">
                    <tr><td colspan="6" style="text-align:center;">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
        
        <!-- Pagination -->
        <div class="pagination-container" id="pagination-container" style="display:none;">
            <div style="font-size: 0.9rem; color: #64748b;" id="pagination-info"></div>
            <div style="display: flex; gap: 5px;" id="pagination-controls"></div>
        </div>
    </div>

    <!-- Fullscreen Preview Modal -->
    <div id="preview-modal" class="my-modal">
        <div class="my-modal-content">
            <div class="my-modal-header">
                <h2 style="margin:0; font-size:1.25rem; display:flex; align-items:center; gap:8px;">
                    <i class="fas fa-file-pdf" style="color:#ef4444;"></i> Xem trước & Phê duyệt Giáo án
                </h2>
                <span class="my-modal-close" onclick="closePreviewModal()"><i class="fas fa-times"></i></span>
            </div>
            <div style="flex:1; display:flex; overflow:hidden;">
                <!-- Left: Preview Frame -->
                <div style="flex:2; border-right:1px solid #e2e8f0; background:#cbd5e1; overflow-y:auto; display:flex; justify-content:center; padding:20px; position:relative;">
                    <div id="preview-loading" style="display:none; position:absolute; top:50%; left:50%; transform:translate(-50%, -50%);">
                        <i class="fas fa-spinner fa-spin fa-2x" style="color:var(--primary);"></i>
                    </div>
                    <iframe id="preview-frame" style="width:210mm; min-height:297mm; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.1); border:none;"></iframe>
                </div>
                
                <!-- Right: Review Form -->
                <div style="flex:1; display:flex; flex-direction:column; padding:20px; background:#fff; overflow-y:auto;">
                    <div id="preview-info" style="margin-bottom:20px; padding:15px; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0;">
                        <!-- JS injects info here -->
                    </div>
                
                    <input type="hidden" id="review-lesson-id">
                    
                    <div class="form-group">
                        <label style="font-weight:600;"><i class="fas fa-gavel" style="color:var(--primary); margin-right:5px;"></i> Quyết định phê duyệt:</label>
                        <select id="review-status" class="form-control" style="font-weight:600;" onchange="toggleComment()">
                            <option value="APPROVED" style="color:#16a34a;">Đồng ý phê duyệt</option>
                            <option value="REJECTED" style="color:#dc2626;">Từ chối (Yêu cầu làm lại)</option>
                        </select>
                    </div>
                    
                    <div class="form-group" id="comment-group" style="display:none; flex:1; display:flex; flex-direction:column;">
                        <label style="font-weight:600;"><i class="fas fa-comment-dots" style="color:#f59e0b; margin-right:5px;"></i> Lý do từ chối (Nhận xét):</label>
                        <textarea id="review-comment" class="form-control" style="flex:1; min-height:150px; resize:none;" placeholder="Nhập lý do chi tiết tại sao giáo án bị từ chối..."></textarea>
                    </div>
                    
                    <div style="margin-top:20px; display:flex; gap:10px;">
                        <button type="button" class="btn btn-secondary" onclick="closePreviewModal()" style="flex:1;">Hủy</button>
                        <button type="button" class="btn btn-primary" onclick="submitReview()" style="flex:2;"><i class="fas fa-paper-plane"></i> Gửi Quyết Định</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('approvals', 'Phê duyệt Giáo án');
        
        let allPendingLessons = [];
        let filteredLessons = [];
        const PAGE_SIZE = 10;
        let currentPage = 1;

        window.addEventListener('DOMContentLoaded', () => {
            checkAuth(true).then(user => {
                if(user && user.role !== 'Admin' && user.role !== 'Manager') {
                    window.location.href = '/dashboard';
                } else {
                    loadDepartments();
                    loadPendingLessons();
                }
            });
        });

        async function loadDepartments() {
            try {
                const res = await fetch(API_URL + '/departments', { headers: getHeaders() });
                if (res.ok) {
                    const depts = await res.json();
                    const sel = document.getElementById('filter-department');
                    let html = '<option value="">-- Tất cả đơn vị --</option>';
                    depts.forEach(d => {
                        html += `<option value="${d.name}">${escapeHtml(d.name)}</option>`;
                    });
                    sel.innerHTML = html;
                }
            } catch(e){}
        }

        async function loadPendingLessons() {
            const tbody = document.getElementById('pending-list');
            tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;">Đang tải...</td></tr>';
            try {
                const res = await fetch(API_URL + '/approvals/pending?t=' + Date.now(), { 
                    headers: Object.assign({}, getHeaders(), { 'Cache-Control': 'no-cache', 'Pragma': 'no-cache' }) 
                });
                if (!res.ok) throw new Error('Không thể tải danh sách');
                allPendingLessons = await res.json();
                applyFilters();
            } catch(e) {
                tbody.innerHTML = `<tr><td colspan="6" style="text-align:center; color:red;">${e.message}</td></tr>`;
            }
        }

        function applyFilters() {
            const q = document.getElementById('search-input').value.toLowerCase();
            const dept = document.getElementById('filter-department').value;
            
            filteredLessons = allPendingLessons.filter(item => {
                const matchQ = (item.author_name || '').toLowerCase().includes(q) ||
                               (item.username || '').toLowerCase().includes(q) ||
                               (item.project_name || '').toLowerCase().includes(q);
                const matchDept = dept ? (item.department_name === dept) : true;
                return matchQ && matchDept;
            });
            
            currentPage = 1;
            renderPage();
        }

        function renderPage() {
            const tbody = document.getElementById('pending-list');
            const total = filteredLessons.length;
            
            if (total === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:#64748b;">Không có giáo án nào phù hợp.</td></tr>';
                document.getElementById('pagination-container').style.display = 'none';
                return;
            }

            const totalPages = Math.ceil(total / PAGE_SIZE);
            if (currentPage > totalPages) currentPage = totalPages;
            
            const startIndex = (currentPage - 1) * PAGE_SIZE;
            const endIndex = Math.min(startIndex + PAGE_SIZE, total);
            const pageData = filteredLessons.slice(startIndex, endIndex);

            let html = '';
            pageData.forEach(item => {
                const dateStr = new Date(item.updated_at).toLocaleString('vi-VN');
                html += `
                    <tr>
                        <td><b>${escapeHtml(item.author_name || item.username)}</b></td>
                        <td><span style="font-size:12px; color:#64748b;">${escapeHtml(item.department_name || 'Chưa rõ')}</span></td>
                        <td>${escapeHtml(item.project_name)}</td>
                        <td>Bài ${item.schedule_tt}</td>
                        <td>${dateStr}</td>
                        <td style="text-align:right;">
                            <button class="btn btn-primary btn-sm" onclick="openPreviewModal('${item.lesson_id}', '${item.project_id}', '${item.schedule_tt}')" title="Xem trước và Phê duyệt">
                                <i class="fas fa-eye"></i> Xem / Duyệt
                            </button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;

            const paginationContainer = document.getElementById('pagination-container');
            if (total > PAGE_SIZE) {
                paginationContainer.style.display = 'flex';
                document.getElementById('pagination-info').innerHTML = `Hiển thị <b>${startIndex + 1}</b> - <b>${endIndex}</b> trong tổng số <b>${total}</b> giáo án (Trang ${currentPage}/${totalPages})`;
                renderPaginationControls(totalPages);
            } else {
                paginationContainer.style.display = 'none';
            }
        }

        function renderPaginationControls(totalPages) {
            const controls = document.getElementById('pagination-controls');
            let html = '';

            html += `<button class="page-btn" onclick="goToPage(1)" ${currentPage === 1 ? 'disabled' : ''}><i class="fas fa-angle-double-left"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${currentPage - 1})" ${currentPage === 1 ? 'disabled' : ''}><i class="fas fa-angle-left"></i></button>`;

            let delta = 2;
            let lastPage = 0;
            for (let i = 1; i <= totalPages; i++) {
                if (i === 1 || i === totalPages || (i >= currentPage - delta && i <= currentPage + delta)) {
                    if (lastPage && i - lastPage > 1) {
                        html += `<span style="padding: 0 4px; color: #94a3b8;">...</span>`;
                    }
                    html += `<button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="goToPage(${i})">${i}</button>`;
                    lastPage = i;
                }
            }

            html += `<button class="page-btn" onclick="goToPage(${currentPage + 1})" ${currentPage === totalPages ? 'disabled' : ''}><i class="fas fa-angle-right"></i></button>`;
            html += `<button class="page-btn" onclick="goToPage(${totalPages})" ${currentPage === totalPages ? 'disabled' : ''}><i class="fas fa-angle-double-right"></i></button>`;

            controls.innerHTML = html;
        }

        function goToPage(page) {
            currentPage = page;
            renderPage();
            const mainCard = document.getElementById('main-card');
            if(mainCard) {
                mainCard.scrollIntoView({ behavior: 'smooth', block: 'start' });
            }
        }

        async function openPreviewModal(lessonId, projectId, tt) {
            const item = allPendingLessons.find(x => x.lesson_id == lessonId);
            
            document.getElementById('review-lesson-id').value = lessonId;
            document.getElementById('review-status').value = 'APPROVED';
            document.getElementById('review-comment').value = '';
            toggleComment();
            
            document.getElementById('preview-info').innerHTML = `
                <div style="font-size:14px; color:#475569; margin-bottom:8px;"><b>👤 Giáo viên:</b> <span style="color:#0f172a; font-weight:500;">${escapeHtml(item.author_name || item.username)}</span></div>
                <div style="font-size:14px; color:#475569; margin-bottom:8px;"><b>🏫 Đơn vị:</b> ${escapeHtml(item.department_name || 'Chưa rõ')}</div>
                <div style="font-size:14px; color:#475569; margin-bottom:8px;"><b>📚 Môn học:</b> <span style="color:#0f172a; font-weight:500;">${escapeHtml(item.project_name)}</span></div>
                <div style="font-size:14px; color:#475569; margin-bottom:8px;"><b>📑 Bài số:</b> ${item.schedule_tt}</div>
                <div style="font-size:14px; color:#475569;"><b>🕒 Gửi lúc:</b> ${new Date(item.updated_at).toLocaleString('vi-VN')}</div>
            `;
            
            document.getElementById('preview-modal').style.display = 'block';
            
            const iframe = document.getElementById('preview-frame');
            const loader = document.getElementById('preview-loading');
            iframe.srcdoc = '';
            loader.style.display = 'block';
            
            try {
                if (item.pdf_link) {
                    iframe.removeAttribute('srcdoc');
                    // Ensure the Drive link uses preview mode
                    let previewUrl = item.pdf_link;
                    if (previewUrl.includes('/view')) {
                        previewUrl = previewUrl.replace('/view', '/preview');
                    }
                    iframe.src = previewUrl;
                } else {
                    const res = await fetch(API_URL + `/lessons/${projectId}/lessons/${tt}`, { headers: getHeaders() });
                    if(res.ok) {
                        const data = await res.json();
                        if(data && data.lesson_data) {
                            const style = `<style>
                                body { font-family: 'Times New Roman', serif; margin:0; padding: 20mm; background: #fff; line-height: 1.5; font-size: 14pt; }
                                table { width: 100%; border-collapse: collapse; margin-top: 10px; margin-bottom: 10px; }
                                th, td { border: 1px solid #000; padding: 8px; text-align: left; }
                                h1, h2, h3 { text-align: center; }
                            </style>`;
                            iframe.removeAttribute('src');
                            iframe.srcdoc = style + data.lesson_data;
                        } else {
                            iframe.removeAttribute('src');
                            iframe.srcdoc = '<div style="padding:20px; color:red; font-family:sans-serif;">Không có dữ liệu giáo án (Bản nháp trống).</div>';
                        }
                    } else {
                        throw new Error('Lỗi truy xuất từ máy chủ');
                    }
                }
            } catch(e) {
                iframe.removeAttribute('src');
                iframe.srcdoc = `<div style="padding:20px; color:red; font-family:sans-serif;">Lỗi tải giáo án: ${e.message}</div>`;
            } finally {
                loader.style.display = 'none';
            }
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').style.display = 'none';
            const iframe = document.getElementById('preview-frame');
            iframe.removeAttribute('srcdoc');
            iframe.removeAttribute('src');
        }

        function toggleComment() {
            const status = document.getElementById('review-status').value;
            document.getElementById('comment-group').style.display = status === 'REJECTED' ? 'flex' : 'none';
        }

        async function submitReview() {
            const lessonId = document.getElementById('review-lesson-id').value;
            const status = document.getElementById('review-status').value;
            const comment = document.getElementById('review-comment').value;

            if (status === 'REJECTED' && !comment.trim()) {
                return showAlert('Vui lòng nhập lý do từ chối!', 'error');
            }

            try {
                const res = await fetch(API_URL + '/approvals/' + lessonId + '/review', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ status, comment })
                });
                if (!res.ok) throw new Error('Có lỗi xảy ra khi phê duyệt');
                
                showAlert('Đã xử lý giáo án thành công!', 'success');
                closePreviewModal();
                loadPendingLessons(); // Refresh list
            } catch(e) {
                showAlert(e.message, 'error');
            }
        }

        function escapeHtml(s) { return (s || '').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
    </script>
</body>
</html>
