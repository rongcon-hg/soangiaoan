<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Phê duyệt Giáo án - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    <div id="alert-box"></div>

    <div class="card">
        
        <div style="display:flex; justify-content:space-between; align-items:center; margin-bottom:20px;">
            <h3 style="margin:0; color:var(--primary);"><i class="fas fa-check-double"></i> Danh sách Giáo án Chờ Duyệt</h3>
            <button class="btn btn-secondary" onclick="loadPendingLessons()"><i class="fas fa-sync-alt"></i> Làm mới</button>
        </div>
        
        <!-- Search and Filter -->
        <div style="display:flex; gap:15px; margin-bottom:20px; flex-wrap:wrap; background:#f8fafc; padding:15px; border-radius:8px; border:1px solid #e2e8f0;">
            <div style="flex:1; min-width:200px;">
                <label style="font-size:13px; font-weight:600; color:#475569; margin-bottom:5px; display:block;">Tìm kiếm (Giáo viên, Môn học):</label>
                <div class="search-box" style="margin:0; width:100%;">
                    <i class="fas fa-search search-icon" style="top:50%; transform:translateY(-50%);"></i>
                    <input type="text" id="search-input" class="search-input" placeholder="Nhập tên giáo viên, môn học..." onkeyup="filterLessons()">
                </div>
            </div>
        </div>


        <div style="overflow-x:auto;">
            <table class="table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Người gửi</th>
                        <th>Đơn vị</th>
                        <th>Môn học</th>
                        <th>Bài số</th>
                        <th>Thời gian gửi</th>
                        <th style="text-align:right;">Thao tác</th>
                    </tr>
                </thead>
                <tbody id="pending-list">
                    <tr><td colspan="5" style="text-align:center;">Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
    </div>

    
    <!-- Preview & Review Modal -->
    <div id="preview-modal" class="modal">
        <div class="modal-content" style="max-width:1100px; width:95%; height:90vh; display:flex; flex-direction:column; padding:0;">
            <div class="modal-header" style="padding:15px 20px; border-bottom:1px solid #e2e8f0; background:#f8fafc; border-radius:8px 8px 0 0;">
                <h2 style="margin:0; font-size:1.25rem;"><i class="fas fa-file-pdf" style="color:#ef4444; margin-right:8px;"></i> Xem trước & Phê duyệt Giáo án</h2>
                <span class="close" onclick="closePreviewModal()">&times;</span>
            </div>
            <div class="modal-body" style="flex:1; display:flex; overflow:hidden; padding:0;">
                
                <!-- Left: Preview Frame -->
                <div style="flex:2; border-right:1px solid #e2e8f0; background:#cbd5e1; overflow-y:auto; display:flex; justify-content:center; padding:20px;">
                    <div id="preview-loading" style="display:none; position:absolute; top:50%; left:33%; transform:translate(-50%, -50%);">
                        <i class="fas fa-spinner fa-spin fa-2x" style="color:var(--primary);"></i>
                    </div>
                    <iframe id="preview-frame" style="width:210mm; height:297mm; background:#fff; box-shadow:0 4px 15px rgba(0,0,0,0.1); border:none;"></iframe>
                </div>
                
                <!-- Right: Review Form -->
                <div style="flex:1; display:flex; flex-direction:column; overflow-y:auto; padding:20px; background:#fff;">
                    <div id="preview-info" style="margin-bottom:20px; padding:15px; background:#f8fafc; border-radius:8px; border:1px solid #e2e8f0;">
                        <!-- JS injects info here -->
                    </div>
                
                    <input type="hidden" id="review-lesson-id">
                    
                    <div class="form-group">
                        <label style="font-weight:600;"><i class="fas fa-gavel" style="color:var(--primary); margin-right:5px;"></i> Quyết định phê duyệt:</label>
                        <select id="review-status" class="form-control" style="font-weight:600;" onchange="toggleComment()">
                            <option value="APPROVED" style="color:#16a34a;">Đồng ý phê duyệt</option>
                            <option value="REJECTED" style="color:#dc2626;">Từ chối (Yêu cầu làm lại)</option>
                        </select>
                    </div>
                    
                    <div class="form-group" id="comment-group" style="display:none; flex:1; display:flex; flex-direction:column;">
                        <label style="font-weight:600;"><i class="fas fa-comment-dots" style="color:#f59e0b; margin-right:5px;"></i> Lý do từ chối (Nhận xét):</label>
                        <textarea id="review-comment" class="form-control" style="flex:1; min-height:150px; resize:none;" placeholder="Nhập lý do chi tiết tại sao giáo án bị từ chối..."></textarea>
                    </div>
                    
                    <div style="margin-top:auto; padding-top:20px; display:flex; gap:10px;">
                        <button type="button" class="btn btn-secondary" onclick="closePreviewModal()" style="flex:1;">Hủy</button>
                        <button type="button" class="btn btn-primary" onclick="submitReview()" style="flex:2;"><i class="fas fa-paper-plane"></i> Gửi Quyết Định</button>
                    </div>
                </div>
            </div>
        </div>
    </div>


    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        injectLayout('approvals', 'Phê duyệt Giáo án');
        
        window.addEventListener('DOMContentLoaded', () => {
            checkAuth(true).then(user => {
                if(user && user.role !== 'Admin' && user.role !== 'Manager') {
                    window.location.href = '/dashboard';
                } else {
                    loadPendingLessons();
                }
            });
        });

        let allPendingLessons = [];
        async function loadPendingLessons() {
            const tbody = document.getElementById('pending-list');
            tbody.innerHTML = '<tr><td colspan="5" style="text-align:center;">Đang tải...</td></tr>';
            try {
                const res = await fetch(API_URL + '/approvals/pending?t=' + Date.now(), { 
                    headers: Object.assign({}, getHeaders(), { 'Cache-Control': 'no-cache', 'Pragma': 'no-cache' }) 
                });
                if (!res.ok) throw new Error('Không thể tải danh sách');
                const data = await res.json();

                if (data.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="5" style="text-align:center; color:#64748b;">Không có giáo án nào đang chờ duyệt.</td></tr>';
                    return;
                }

                let html = '';
                data.forEach(item => {
                    const dateStr = new Date(item.updated_at).toLocaleString('vi-VN');
                    html += `
                        <tr>
                            <td><b>${escapeHtml(item.author_name || item.username)}</b></td>
                            <td><span style="font-size:12px; color:#64748b;">${escapeHtml(item.department_name || 'Chưa rõ')}</span></td>
                            <td>${escapeHtml(item.project_name)}</td>
                            <td>Bài ${item.schedule_tt}</td>
                            <td>${dateStr}</td>
                            <td style="text-align:right;">
                                <a href="/app?id=${item.project_id}&tt=${item.schedule_tt}" target="_blank" class="btn btn-secondary btn-sm" title="Xem giáo án"><i class="fas fa-eye"></i></a>
                                <button class="btn btn-primary btn-sm" onclick="openReviewModal('${item.lesson_id}')"><i class="fas fa-gavel"></i> Duyệt</button>
                            </td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
            } catch(e) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; color:red;">${e.message}</td></tr>`;
            }
        }

        
        function renderLessons(list) {
            const tbody = document.getElementById('pending-list');
            if (list.length === 0) {
                tbody.innerHTML = '<tr><td colspan="6" style="text-align:center; color:#64748b;">Không tìm thấy giáo án nào.</td></tr>';
                return;
            }
            let html = '';
            list.forEach(item => {
                const dateStr = new Date(item.updated_at).toLocaleString('vi-VN');
                html += `
                    <tr>
                        <td><b>${escapeHtml(item.author_name || item.username)}</b></td>
                        <td><span style="font-size:12px; color:#64748b;">${escapeHtml(item.department_name || 'Chưa rõ')}</span></td>
                        <td>${escapeHtml(item.project_name)}</td>
                        <td>Bài ${item.schedule_tt}</td>
                        <td>${dateStr}</td>
                        <td style="text-align:right;">
                            <button class="btn btn-primary btn-sm" onclick="openPreviewModal('${item.lesson_id}', '${item.project_id}', '${item.schedule_tt}')"><i class="fas fa-file-pdf"></i> Xem & Duyệt</button>
                        </td>
                    </tr>
                `;
            });
            tbody.innerHTML = html;
        }

        function filterLessons() {
            const q = document.getElementById('search-input').value.toLowerCase();
            const filtered = allPendingLessons.filter(item => 
                (item.author_name || '').toLowerCase().includes(q) ||
                (item.username || '').toLowerCase().includes(q) ||
                (item.project_name || '').toLowerCase().includes(q)
            );
            renderLessons(filtered);
        }

        async function openPreviewModal(lessonId, projectId, tt) {
            const item = allPendingLessons.find(x => x.lesson_id == lessonId);
            
            document.getElementById('review-lesson-id').value = lessonId;
            document.getElementById('review-status').value = 'APPROVED';
            document.getElementById('review-comment').value = '';
            toggleComment();
            
            // Populate info
            document.getElementById('preview-info').innerHTML = `
                <div style="font-size:13px; color:#64748b; margin-bottom:5px;"><b>Giáo viên:</b> ${escapeHtml(item.author_name || item.username)}</div>
                <div style="font-size:13px; color:#64748b; margin-bottom:5px;"><b>Môn học:</b> ${escapeHtml(item.project_name)}</div>
                <div style="font-size:13px; color:#64748b; margin-bottom:5px;"><b>Bài số:</b> ${item.schedule_tt}</div>
                <div style="font-size:13px; color:#64748b;"><b>Gửi lúc:</b> ${new Date(item.updated_at).toLocaleString('vi-VN')}</div>
            `;
            
            document.getElementById('preview-modal').style.display = 'block';
            
            // Load PDF/HTML content
            const iframe = document.getElementById('preview-frame');
            const loader = document.getElementById('preview-loading');
            iframe.srcdoc = '';
            loader.style.display = 'block';
            
            try {
                const res = await fetch(API_URL + `/lessons/${projectId}/lessons/${tt}`, { headers: getHeaders() });
                if(res.ok) {
                    const data = await res.json();
                    if(data && data.lesson_data) {
                        const style = `<style>
                            body { font-family: 'Times New Roman', serif; margin:0; padding: 20mm; background: #fff; }
                            table { width: 100%; border-collapse: collapse; }
                            th, td { border: 1px solid #000; padding: 5px; }
                        </style>`;
                        iframe.srcdoc = style + data.lesson_data;
                    } else {
                        iframe.srcdoc = '<div style="padding:20px; color:red;">Không có dữ liệu giáo án.</div>';
                    }
                }
            } catch(e) {
                iframe.srcdoc = `<div style="padding:20px; color:red;">Lỗi tải giáo án: ${e.message}</div>`;
            } finally {
                loader.style.display = 'none';
            }
        }

        function closePreviewModal() {
            document.getElementById('preview-modal').style.display = 'none';
            document.getElementById('preview-frame').srcdoc = '';
        }

        

        

        function toggleComment() {
            const status = document.getElementById('review-status').value;
            document.getElementById('comment-group').style.display = status === 'REJECTED' ? 'block' : 'none';
        }

        async function submitReview() {
            const lessonId = document.getElementById('review-lesson-id').value;
            const status = document.getElementById('review-status').value;
            const comment = document.getElementById('review-comment').value;

            if (status === 'REJECTED' && !comment.trim()) {
                return showAlert('Vui lòng nhập lý do từ chối!', 'error');
            }

            try {
                const res = await fetch(API_URL + '/approvals/' + lessonId + '/review', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ status, comment })
                });
                if (!res.ok) throw new Error('Có lỗi xảy ra');
                showAlert('Đã xử lý giáo án thành công!', 'success');
                closePreviewModal();
                loadPendingLessons();
            } catch(e) {
                showAlert(e.message, 'error');
            }
        }

        function escapeHtml(s) { return (s || '').toString().replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;"); }
    </script>
</body>
</html>
