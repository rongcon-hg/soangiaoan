        async function deleteSignature() {
            const confirmed = await customConfirm('Bạn có chắc chắn muốn gỡ bỏ chữ ký cá nhân hiện tại không?');
            if (!confirmed) return;

            try {
                const res = await fetch(API_URL + '/auth/signature', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({
                        signature: null,
                        signature_filename: null
                    })
                });

                if (res.ok) {
                    alert('Đã gỡ bỏ chữ ký thành công.');
                    currentSignatureData = '';
                    currentSignatureFilename = '';
                    try {
                        localStorage.removeItem('giaoan_user_signature');
                    } catch(e) {}
                    renderCurrentSignature();
                } else {
                    alert('Lỗi khi gỡ bỏ chữ ký.');
                }
            } catch (err) {
                console.error(err);
                alert('Lỗi kết nối: ' + err.message);
            }
        }

        function toDirectImageUrl(url) {
            if (!url || typeof url !== 'string') return '';
            if (url.startsWith('data:image') || url.startsWith('blob:') || url.includes('googleusercontent.com')) {
                return url;
            }
            const match = url.match(/\/d\/([a-zA-Z0-9_-]+)/) || url.match(/[?&]id=([a-zA-Z0-9_-]+)/);
            if (match && match[1]) {
                return `https://lh3.googleusercontent.com/d/${match[1]}`;
            }
            return url;
        }

        function renderCurrentSignature() {
            const img = document.getElementById('sig-current-img');
            const empty = document.getElementById('sig-current-empty');
            const fnDisplay = document.getElementById('sig-filename-display');
            const btnDel = document.getElementById('btn-delete-sig');

            if (currentSignatureData) {
                const directUrl = toDirectImageUrl(currentSignatureData);
                img.src = directUrl;
                img.style.display = 'block';
                empty.style.display = 'none';
                fnDisplay.textContent = 'Tên file: ' + (currentSignatureFilename || 'signature.png');
                btnDel.style.display = 'inline-block';
            } else {
                img.src = '';
                img.style.display = 'none';
                empty.style.display = 'inline-block';
                fnDisplay.textContent = '';
                btnDel.style.display = 'none';
            }
        }

        function switchSettingsTab(panelId, el) {
            document.querySelectorAll('.s-tab').forEach(t => t.classList.remove('active'));
            document.querySelectorAll('.s-panel').forEach(p => p.classList.remove('active'));
            
            el.classList.add('active');
            document.getElementById('panel-' + panelId).classList.add('active');
        }

        function toggleApiKeyVisibility() {
            const keyInput = document.getElementById('cfg-gemini-key');
            const eyeIcon = document.getElementById('eye-icon');
            if (keyInput.type === 'password') {
                keyInput.type = 'text';
                eyeIcon.className = 'fas fa-eye-slash';
            } else {
                keyInput.type = 'password';
                eyeIcon.className = 'fas fa-eye';
            }
        }

        async function saveGeminiKeyOnly() {
            const apiKey = document.getElementById('cfg-gemini-key').value.trim();
            const btn = document.getElementById('btn-save-gemini-only');
            if (btn) {
                btn.disabled = true;
                btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Đang lưu...';
            }

            try {
                const res = await fetch(API_URL + '/auth/apikey', {
                    method: 'POST',
                    headers: getHeaders(),
                    body: JSON.stringify({ apiKey })
                });
                
                const data = await res.json();
                if (!res.ok) throw new Error(data.error || data.message || 'Lỗi khi lưu API Key');

                if (apiKey) {
                    localStorage.setItem('giaoan_gemini_key', apiKey);
                } else {
                    localStorage.removeItem('giaoan_gemini_key');
                }

                showAlert('Đã lưu mã Gemini API Key thành công!', 'success');
            } catch (err) {
                console.error(err);
                showAlert(err.message || 'Lỗi khi lưu API Key');
            } finally {
                if (btn) {
                    btn.disabled = false;
                    btn.innerHTML = '<i class="fas fa-save"></i> Lưu mã API Key này';
                }
            }
        }

