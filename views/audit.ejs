<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Lịch sử Hoạt động - Hệ thống Giáo án điện tử</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
        <style>
    .audit-table { width: 100%; border-collapse: collapse; min-width: 800px; }
    .audit-table th, .audit-table td { padding: 14px 16px; border-bottom: 1px solid #e2e8f0; font-size: 0.9rem; text-align: left; }
    .audit-table th { background: #f8fafc; font-weight: 600; color: #475569; position: sticky; top: 0; z-index: 10; }
    .audit-table tbody tr { transition: background-color 0.15s; }
    .audit-table tbody tr:hover { background-color: #f8fafc; }
    
    .badge { padding: 4px 10px; border-radius: 6px; font-size: 0.75rem; font-weight: 600; display: inline-block; }
    .badge-submit { background: #dbeafe; color: #1e40af; }
    .badge-review { background: #fef3c7; color: #b45309; }
    .badge-login { background: #d1fae5; color: #065f46; }
    .badge-create { background: #e0e7ff; color: #3730a3; }
    .badge-delete { background: #fee2e2; color: #991b1b; }
    .badge-save { background: #f3e8ff; color: #6b21a8; }
    .badge-other { background: #f1f5f9; color: #475569; }
    
    .page-btn { padding: 6px 14px; margin: 0 3px; border: 1px solid #cbd5e1; background: #fff; border-radius: 6px; cursor: pointer; color:#475569; transition: all 0.2s; font-size:0.9rem; }
    .page-btn.active { background: #0ea5e9; color: #fff; border-color: #0ea5e9; }
    .page-btn:hover:not(.active) { background: #f1f5f9; }
    
    .audit-toolbar { display: flex; gap: 12px; flex-wrap: wrap; align-items: center; margin-top: 15px; }
    .audit-toolbar .form-control { border-radius: 6px; padding: 8px 12px; border: 1px solid #cbd5e1; outline: none; }
    .audit-toolbar .form-control:focus { border-color: #0ea5e9; }
    
    .table-container { border: 1px solid #e2e8f0; border-radius: 8px; overflow: hidden; margin-top: 15px; }
    .table-responsive { overflow-x: auto; max-height: calc(100vh - 250px); overflow-y: auto; }
    
    @media (max-width: 768px) {
        .audit-toolbar { flex-direction: column; align-items: stretch; }
        .audit-toolbar .form-control { width: 100% !important; }
        .audit-toolbar button { width: 100%; justify-content: center; }
        .card-header { flex-direction: column; align-items: flex-start; }
    }
</style>
</head>
<body>
    <div id="alert-box"></div>
    <div class="card">
        <div class="card-header" style="flex-wrap: wrap; gap: 16px;">
            <h3 class="card-title"><i class="fas fa-history" style="color:var(--primary); margin-right:8px;"></i> Lịch sử Hoạt động (Audit Logs)</h3>
            <div class="audit-toolbar">
                <input type="text" id="audit-search" class="form-control" placeholder="Tìm kiếm tài khoản, chi tiết..." style="width:220px;" onkeyup="if(event.key === 'Enter') loadAuditLogs(1)">
                <select id="audit-action-filter" class="form-control" style="width:200px;" onchange="loadAuditLogs(1)">
                    <option value="">-- Tất cả hành động --</option>
                    <option value="LOGIN">Đăng nhập (LOGIN)</option>
                    <option value="CREATE_PROJECT">Tạo thư mục (CREATE_PROJECT)</option>
                    <option value="DELETE_PROJECT">Xóa thư mục (DELETE_PROJECT)</option>
                    <option value="SAVE_SCHEDULE">Lưu tiến độ (SAVE_SCHEDULE)</option>
                    <option value="SAVE_LESSON">Lưu giáo án (SAVE_LESSON)</option>
                    <option value="SUBMIT_LESSON">Trình ký (SUBMIT)</option>
                    <option value="REVIEW_LESSON">Phê duyệt (REVIEW)</option>
                </select>
                <button class="btn btn-primary" onclick="loadAuditLogs(1)"><i class="fas fa-search"></i> Tìm</button>
                <button class="btn btn-secondary" onclick="openDeleteAuditModal()" style="color:#ef4444; border-color:#fca5a5;"><i class="fas fa-trash-alt"></i> Xoá bớt</button>
            </div>
        </div>
        <div class="table-container">
        <div class="table-responsive">
            <table class="audit-table" style="width:100%; border-collapse:collapse; min-width:800px;">
                <thead>
                    <tr>
                        <th style="width: 15%;">Thời gian</th>
                        <th style="width: 15%;">Người dùng</th>
                        <th style="width: 15%;">Hành động</th>
                        <th style="width: 10%;">Đối tượng</th>
                        <th style="width: 10%;">ID Đối tượng</th>
                        <th style="width: 25%;">Chi tiết</th>
                        <th style="width: 10%;">IP</th>
                    </tr>
                </thead>
                <tbody id="audit-tbody">
                    <tr><td colspan="7" style="text-align:center; padding:20px; color:#94a3b8;"><i class="fas fa-spinner fa-spin"></i> Đang tải dữ liệu...</td></tr>
                </tbody>
            </table>
        </div>
        </div>
        <div id="audit-pagination" style="display:flex; justify-content:center; gap:8px; padding:16px;">
            <!-- Pagination buttons will go here -->
        </div>
    </div>

    <!-- Modal Xoá Lịch sử -->
    <div id="delete-audit-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; align-items:center; justify-content:center;">
        <div style="background:#fff; padding:24px; border-radius:8px; width:400px; max-width:90%;">
            <h3 style="margin-top:0; color:#ef4444;"><i class="fas fa-exclamation-triangle"></i> Xoá Lịch sử Hoạt động</h3>
            <p>Chọn mốc thời gian muốn giữ lại. Các dữ liệu cũ hơn sẽ bị xoá vĩnh viễn.</p>
            <div class="form-group">
                <select id="delete-audit-days" class="form-control">
                    <option value="30">Giữ lại 30 ngày gần nhất</option>
                    <option value="60">Giữ lại 60 ngày gần nhất</option>
                    <option value="90">Giữ lại 90 ngày gần nhất</option>
                    <option value="180">Giữ lại 6 tháng gần nhất</option>
                    <option value="all">Xoá toàn bộ (Làm sạch CSDL)</option>
                </select>
            </div>
            <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:20px;">
                <button class="btn btn-secondary" onclick="closeDeleteAuditModal()">Hủy</button>
                <button class="btn btn-primary" style="background:#ef4444; border-color:#ef4444;" onclick="executeDeleteAudit()">Xác nhận Xoá</button>
            </div>
        </div>
    </div>


    <script src="/js/api.js"></script>
    <script src="/js/layout.js"></script>
    <script>
        let currentAuditPage = 1;
        
        function openDeleteAuditModal() {
            document.getElementById('delete-audit-modal').style.display = 'flex';
        }
        function closeDeleteAuditModal() {
            document.getElementById('delete-audit-modal').style.display = 'none';
        }
        
        async function executeDeleteAudit() {
            const val = document.getElementById('delete-audit-days').value;
            const keepDays = val === 'all' ? undefined : parseInt(val);
            
            if(!confirm('Bạn có chắc chắn muốn xoá dữ liệu không? Hành động này không thể hoàn tác!')) return;
            
            try {
                const res = await fetch(API_URL + '/audit', {
                    method: 'DELETE',
                    headers: getHeaders(),
                    body: JSON.stringify({ keepDays })
                });
                const data = await res.json();
                if(res.ok) {
                    showAlert(data.message || 'Xoá thành công', 'success');
                    closeDeleteAuditModal();
                    loadAuditLogs(1);
                } else {
                    showAlert(data.error || 'Lỗi khi xoá', 'error');
                }
            } catch(e) {
                showAlert('Lỗi kết nối', 'error');
            }
        }

        async function loadAuditLogs(page = 1) {
            currentAuditPage = page;
            const search = document.getElementById('audit-search').value;
            const action = document.getElementById('audit-action-filter').value;
            
            try {
                document.getElementById('audit-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px;"><i class="fas fa-spinner fa-spin"></i> Đang tải...</td></tr>';
                const url = `${API_URL}/audit?page=${page}&limit=20&search=${encodeURIComponent(search)}&action=${encodeURIComponent(action)}`;
                const res = await fetch(url, { headers: getHeaders() });
                if (res.status === 403 || res.status === 401) {
                    document.getElementById('audit-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:#ef4444;">Bạn không có quyền truy cập trang này.</td></tr>';
                    return;
                }
                const responseData = await res.json();
                const logs = responseData.data || [];
                const pagination = responseData.pagination || { totalPages: 1 };

                const tbody = document.getElementById('audit-tbody');
                if (!logs || logs.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:#64748b;">Chưa có dữ liệu lịch sử hoạt động.</td></tr>';
                    return;
                }
                
                let html = '';
                logs.forEach(log => {
                    const date = new Date(log.created_at).toLocaleString('vi-VN', { timeZone: 'Asia/Ho_Chi_Minh' });
                    let badgeClass = 'badge-other';
                    if (log.action.includes('SUBMIT')) badgeClass = 'badge-submit';
                    if (log.action.includes('REVIEW')) badgeClass = 'badge-review';
                    if (log.action === 'LOGIN') badgeClass = 'badge-login';
                    if (log.action.includes('CREATE')) badgeClass = 'badge-create';
                    if (log.action.includes('DELETE')) badgeClass = 'badge-delete';
                    if (log.action.includes('SAVE')) badgeClass = 'badge-save';
                    
                    const detailsStr = typeof log.details === 'object' ? JSON.stringify(log.details) : log.details;
                    
                    html += `
                        <tr>
                            <td>${date}</td>
                            <td style="font-weight:500;">${escapeHtml(log.full_name || log.username || 'System')}</td>
                            <td><span class="badge ${badgeClass}">${escapeHtml(log.action)}</span></td>
                            <td>${escapeHtml(log.target_type || '')}</td>
                            <td>${log.target_id || ''}</td>
                            <td style="color:#64748b; font-family:monospace; font-size:0.8rem; word-break:break-all;">${escapeHtml(detailsStr || '')}</td>
                            <td style="font-size:0.8rem; color:#94a3b8;">${escapeHtml(log.ip_address || '')}</td>
                        </tr>
                    `;
                });
                tbody.innerHTML = html;
                
                // Render pagination
                let pHtml = '';
                if(pagination.totalPages > 1) {
                    for(let i=1; i<=pagination.totalPages; i++) {
                        // Show first, last, current, and +/- 2 pages
                        if(i === 1 || i === pagination.totalPages || (i >= page - 2 && i <= page + 2)) {
                            pHtml += `<button class="btn btn-sm ${i === page ? 'btn-primary' : 'btn-secondary'}" onclick="loadAuditLogs(${i})">${i}</button>`;
                        } else if(i === page - 3 || i === page + 3) {
                            pHtml += `<span>...</span>`;
                        }
                    }
                }
                document.getElementById('audit-pagination').innerHTML = pHtml;
                
            } catch (err) {
                console.error(err);
                document.getElementById('audit-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:#ef4444;">Lỗi tải dữ liệu.</td></tr>';
            }
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            injectLayout('audit', 'Lịch sử Hoạt động');
            checkAuth();
            
            // Allow layout.js to render user first
            setTimeout(() => {
                if (currentUser && currentUser.role !== 'Admin') {
                    document.getElementById('audit-tbody').innerHTML = '<tr><td colspan="7" style="text-align:center; padding:20px; color:#ef4444;">Chỉ Admin mới có quyền xem trang này.</td></tr>';
                } else {
                    loadAuditLogs();
                }
            }, 500);
        });
    </script>
</body>
</html>
